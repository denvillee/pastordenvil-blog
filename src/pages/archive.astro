---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import { live, displayDate, isoDate, ROOMS, type RoomKey } from '../lib/publish';
import site from '../data/site.json';
import labels from '../data/labels.json';

/* Everything ever published, newest first, grouped by year.
   Nothing is ever removed from here. New pieces are new files; old ones stay
   at their original URLs forever. */
type Row = { room: RoomKey; title: string; dek: string; href: string; date: Date };
const rows: Row[] = [];
for (const key of Object.keys(ROOMS) as RoomKey[]) {
  for (const e of await live(key)) {
    rows.push({
      room: key,
      title: e.data.title,
      dek: e.data.dek,
      href: `/${ROOMS[key].path}/${e.id}/`,
      date: e.data.publishAt,
    });
  }
}
rows.sort((a, b) => b.date.getTime() - a.date.getTime());

const years = [...new Set(rows.map((r) => r.date.getFullYear()))];
const byYear = years.map((y) => ({ year: y, items: rows.filter((r) => r.date.getFullYear() === y) }));
const counts = (Object.keys(ROOMS) as RoomKey[]).map((k) => ({
  label: ROOMS[k].label,
  path: ROOMS[k].path,
  n: rows.filter((r) => r.room === k).length,
}));
---
<Base title={`${labels.archiveHeading} · ${site.name}`} description={labels.archiveDek}>
  <section class="band shell">
    <div class="sec-head">
      <h1>{labels.archiveHeading}</h1>
      {/* "1 piece · 1 year" is not a statistic worth showing. The whole
          counter stays off until there is a body of work to count
          (round 8, R8-5). */}
      {rows.length >= 5 && (
        <span class="label"><span class="lib-count">{rows.length}</span> pieces &middot; {years.length} year{years.length === 1 ? '' : 's'}</span>
      )}
    </div>

    {rows.length >= 5 && (
      <div class="arc-counts">
        {/* A zero is never printed: a page whose job is to show a body of work
            should not list the sections that have none. */}
        {counts.filter((c) => c.n > 0).map((c) => (
          <a class="arc-count" href={`/${c.path}/`}>
            <span class="n">{c.n}</span>
            <span class="l">{c.label}</span>
          </a>
        ))}
      </div>
    )}

    {byYear.map((group) => (
      <section class="arc-year">
        <h2 class="arc-year-h">{group.year}<span>{group.items.length} piece{group.items.length === 1 ? '' : 's'}</span></h2>
        <div class="list">
          {group.items.map((r) => (
            <a class="list-item arc-item" href={r.href}>
              <span class="date"><time datetime={isoDate(r.date)}>{displayDate(r.date)}</time></span>
              <span class="t">{r.title}<span class="d">{r.dek}</span></span>
              <span class="r">{ROOMS[r.room].label}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {rows.length === 0 && (
      <p class="art-dek">{labels.archiveEmpty}</p>
    )}
  </section>
  <Signup />
</Base>
