---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { live, displayDate, isoDate, ROOMS, type RoomKey } from '../lib/publish';
import site from '../data/site.json';
import labels from '../data/labels.json';

/* Everything ever published, newest first, grouped by year.
   Nothing is ever removed from here. New pieces are new files; old ones stay
   at their original URLs forever. */
/* A page called Everything has to mean it. The written rooms were the only
   thing here, which is how it ended up listing one piece while the site also
   held three talks and a study. Talks and studies are now in the index too,
   and every row carries a kind so the list can be filtered. */
type Row = { kind: string; label: string; title: string; dek: string; href: string; date: Date };
const rows: Row[] = [];
for (const key of Object.keys(ROOMS) as RoomKey[]) {
  for (const e of await live(key)) {
    rows.push({
      kind: key,
      label: ROOMS[key].label,
      title: e.data.title,
      dek: e.data.dek,
      href: `/${ROOMS[key].path}/${e.id}/`,
      date: e.data.publishAt,
    });
  }
}
/* Talks. Dated by the day it was given where we have it, and by its year
   otherwise, so a talk sorts beside the writing rather than above all of it. */
for (const t of await getCollection('watch')) {
  if (t.data.draft) continue;
  rows.push({
    kind: 'watch',
    label: labels.navWatch,
    title: t.data.title,
    dek: t.data.context ?? '',
    href: '/watch/',
    date: t.data.givenOn ?? new Date(t.data.year, 0, 1),
  });
}
/* The study. One entry, because a study is one thing you walk through. */
rows.push({
  kind: 'studies',
  label: labels.studiesHeading,
  title: 'Quietly at Work',
  dek: "Finding God's Presence in the Book of Ruth",
  href: '/studies/',
  date: new Date(2026, 7, 27),
});

rows.sort((a, b) => b.date.getTime() - a.date.getTime());
const kinds = [...new Map(rows.map((r) => [r.kind, r.label])).entries()];

const years = [...new Set(rows.map((r) => r.date.getFullYear()))];
const byYear = years.map((y) => ({ year: y, items: rows.filter((r) => r.date.getFullYear() === y) }));

---
<Shell title={`${labels.archiveHeading} · ${site.name}`} description={labels.archiveDek}>
  <section class="band shell arch-page">
    <div class="sec-head">
      <h1 class="page-h is-display">{labels.archiveHeading}<span class="dot">.</span></h1>
      {/* "1 piece · 1 year" is not a statistic worth showing. The whole
          counter stays off until there is a body of work to count
          (round 8, R8-5). */}
      {rows.length >= 5 && (
        <span class="count"><span class="lib-count">{rows.length}</span> pieces &middot; {years.length} year{years.length === 1 ? '' : 's'}</span>
      )}
    </div>

    {kinds.length > 1 && (
      <div class="arc-filters" role="group" aria-label="Filter by kind">
        <button type="button" class="chip-btn on" data-kind="all" aria-pressed="true">All</button>
        {kinds.map(([k, label]) => (
          <button type="button" class="chip-btn" data-kind={k} aria-pressed="false">{label}</button>
        ))}
      </div>
    )}

    {byYear.map((group) => (
      <section class="arc-year">
        <h2 class="arc-year-h">{group.year}<span>{group.items.length} piece{group.items.length === 1 ? '' : 's'}</span></h2>
        <div class="list">
          {group.items.map((r) => (
            <a class="list-item arc-item" href={r.href} data-kind={r.kind}>
              <span class="date"><time datetime={isoDate(r.date)}>{displayDate(r.date)}</time></span>
              <span class="t">{r.title}{r.dek && <span class="d">{r.dek}</span>}</span>
              <span class="r">{r.label}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {rows.length === 0 && (
      <p class="art-dek">{labels.archiveEmpty}</p>
    )}
  </section>
  <script>
    /* Filtering happens here rather than on the server: every row is already
       in the page, so this is showing and hiding, not fetching. A year heading
       hides itself when the filter empties it, so the list never leaves a
       heading standing over nothing. */
    document.querySelectorAll('.arc-filters .chip-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var kind = btn.dataset.kind;
        document.querySelectorAll('.arc-filters .chip-btn').forEach(function (b) {
          var on = b === btn;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        document.querySelectorAll('.arc-item').forEach(function (row) {
          row.hidden = !(kind === 'all' || row.dataset.kind === kind);
        });
        document.querySelectorAll('.arc-year').forEach(function (y) {
          y.hidden = !y.querySelector('.arc-item:not([hidden])');
        });
      });
    });
  </script>
</Shell>
