---
import CloseBand from '../components/CloseBand.astro';
import Glyph from '../components/Glyph.astro';
/*
  Watch. Denvil's teaching library, newest year first.

  Everything plays here. The host is kept in the data for attribution and
  maintenance, and it stays out of the interface: no outbound buttons, no
  platform names in the copy, and a site-native line if a player ever fails.

  Built for the size it is about to be. There are three talks on this page
  today and a database of roughly forty with usable video behind it, out of
  well over a thousand messages. Three talks need no filters; forty need them
  badly, and a page that has to be rewritten the week the import lands is a
  page that will not get rewritten. So the furniture is here now and it hides
  itself: the search box appears at eight talks, the year row at two years, the
  series row at two series. Nothing is shown to filter a list you can already
  see all of.

  All of it is client side over markup that is already complete, so the page
  works with JavaScript off: every talk is in the HTML, grouped by year, and
  the controls simply never appear.
*/
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import { toSeconds } from '../lib/publish';
import DotGrid from '../components/marks/DotGrid.astro';
import Tape from '../components/marks/Tape.astro';
import VideoCard from '../components/VideoCard.astro';
import site from '../data/site.json';
import labels from '../data/labels.json';

const all = await getCollection('watch');
/* Grouped by year, newest year first, newest talk first inside each year.
   Nothing is pulled out as a featured item: Denvil has not asked for one, and
   lifting the first talk above its own year broke the ordering the spec
   asks for. Sort on the day it was given where we have it, and fall back to
   the year plus the manual order where we do not. */
const talks = all
  .filter((t: any) => !t.data.draft)
  .sort((a: any, b: any) => {
    if (a.data.year !== b.data.year) return b.data.year - a.data.year;
    const ad = a.data.givenOn ? a.data.givenOn.getTime() : 0;
    const bd = b.data.givenOn ? b.data.givenOn.getTime() : 0;
    if (ad !== bd) return bd - ad;
    return b.data.order - a.data.order || a.data.title.localeCompare(b.data.title);
  });

const years = [...new Set(talks.map((t: any) => t.data.year))].sort((a, b) => b - a);
/* Only series that actually group something. With 33 talks across 31 series
   almost every chip filtered to one card, which is a filter that does nothing
   but take up four rows. A run has to have at least two talks on the site
   before it earns a chip; everything else is reachable by search. */
const seriesCount = new Map<string, number>();
for (const t of talks) {
  const s = (t as any).data.series;
  if (s) seriesCount.set(s, (seriesCount.get(s) ?? 0) + 1);
}
const series = [...seriesCount.entries()]
  .filter(([, n]) => n >= 2)
  .map(([s]) => s)
  .sort();

/* The comp's category tabs. Same rule as everything else on this page: a tab
   appears only when talks actually carry that category, so the row grows as
   Denvil labels the library and never shows an empty tab. */
const CAT_LABEL: Record<string,string> = {
  teaching: 'Teaching', leadership: 'Leadership',
  conversation: 'Conversations', qa: 'Q&A',
};
const catCount = new Map<string, number>();
for (const t of talks) {
  const c = (t as any).data.category;
  if (c) catCount.set(c, (catCount.get(c) ?? 0) + 1);
}
const cats = ['teaching','leadership','conversation','qa'].filter((c) => catCount.has(c));

/* The thresholds. A control that filters a list you can see all of is noise. */
const showSearch = talks.length >= 8;
const showYears = years.length >= 2;
const showSeries = series.length >= 2;
/* A tab appears only when talks actually carry that category. Denvil, 2 Sep:
   "An empty Q&A tab makes the library feel unfinished." The row grows as the
   library gets labelled and never advertises a room with nothing in it. */

/* Denvil, 1 Sep: "videos don't need years per se. Just put the content as the
   layout is." So the year headings are gone. */
/* The featured talk is chosen, not inherited from the sort order. It is then
   REMOVED from everything below: the deck used to start at talks[0] as well, so
   the same message appeared twice within one screen. */
const feat: any = talks.find((t: any) => t.data.featured) ?? talks[0];
const rest = talks.filter((t: any) => t !== feat);

/* One "recent" section, not two. The page ran Featured -> four cards -> Most
   recent talks -> the library, which is three versions of the same idea before
   a reader reaches anything they can browse. Now: Featured, Latest talks,
   Browse the library. */
const latest = rest.slice(0, 6);
const restTalks = rest.slice(6);
const anyControls = showSearch || showYears || showSeries || showCats;

/* One searchable string per talk, built here rather than in the browser: the
   markup carries it, so the script does no work before the reader types. */
const featPoster = feat?.data.poster
  ? `/assets/img/${feat.data.poster}.jpg`
  : (feat?.data.provider === 'youtube' ? `https://i.ytimg.com/vi/${feat.data.videoId}/hqdefault.jpg` : undefined);
const mmss = (n?: number) => {
  if (!n) return '';
  const h = Math.floor(n / 3600), m = Math.floor((n % 3600) / 60), sec = n % 60;
  return h ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`
           : `${m}:${String(sec).padStart(2,'0')}`;
};

const hay = (t: any) => [t.data.title, t.data.series, t.data.context,
  t.data.organization, t.data.scripture, t.data.location,
  ...(t.data.tags ?? [])].filter(Boolean).join(' ').toLowerCase();
---
<Shell title={`${labels.watchHeading} · ${site.name}`} description={labels.watchDek} current="watch">
  <div class="arch">
    <Mark kind="brush" color="yellow" class="arch-brush" />

    <section class="shell watch-hero">
      <div>
        <h1 class="page-h is-display">{labels.watchHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          Sermons, teachings, and conversations&#32;<span class="u">gathered in one place.<Mark kind="underline" color="yellow" /></span>
        </p>
        {/* No empty state. */}
      </div>
      <div class="watch-feat">
        <DotGrid cols={7} rows={5} class="watch-dots" />
        <Tape color="blue" class="vfeat-tape" />
        {feat && (
          <a class="vfeat" href={`#talk-${feat.id}`}>
            <span class="vfeat-shot">
              {featPoster
                ? <img src={featPoster} alt="" width="1280" height="720" loading="eager" decoding="async" />
                : <span class="vfeat-none" aria-hidden="true"></span>}
              {/* An outlined ring with a solid triangle, which is the comp's
                  control. A filled white disc reads as a UI button; the ring
                  reads as a video. */}
              <span class="vfeat-play" aria-hidden="true">
                <svg viewBox="0 0 64 64" fill="none">
                  <circle cx="32" cy="32" r="29" stroke="#fff" stroke-width="2.6" />
                  <path d="M26 20l19 12-19 12z" fill="#fff" />
                </svg>
              </span>
            </span>
            <span class="vfeat-body">
              <span class="vfeat-k">Featured teaching</span>
              <span class="vfeat-t">{feat.data.title}</span>
              {feat.data.context && <span class="vfeat-d">{feat.data.context}</span>}
              <span class="vfeat-m">
                <span class="vfeat-go">Watch now <span class="arw" aria-hidden="true">&rarr;</span></span>
                {/* The whole-service recordings run past an hour and a half, but
                    the message inside them starts well in: Let's Stay Together is
                    a 1:39:51 file whose teaching begins at 34:41. VideoCard already
                    subtracts startsAt; this featured block was printing the raw
                    file length, so it advertised the service, not the sermon.
                    Denvil, 2 Sep: "lets stay together should be a bit shorter". */}
                {feat.data.durationSeconds && (
                  <span class="vfeat-dur">
                    {mmss(Math.max(0,
                      (toSeconds(feat.data.endsAt) ?? feat.data.durationSeconds)
                      - (toSeconds(feat.data.startsAt) ?? 0)))}
                  </span>
                )}
              </span>
            </span>
          </a>
        )}
        <ColorDisc lines={["theology","leadership","life"]} class="watch-disc" />
      </div>
    </section>

    

    <section class="shell wrecent">
      <Mark kind="scribble" color="blue"  class="wrecent-zig-l" />
      <Mark kind="scribble" color="green" class="wrecent-zig-r" />
      <div class="sec-head">
        <h2 class="sec-h"><span class="u">Latest talks<Mark kind="underline" color="yellow" draw={true} /></span></h2>
      </div>
      <div class="vcards vcards-lat">
        {latest.map((t: any) => (
          <div class="vwrap" id={`talk-${t.id}`} data-year={String(t.data.year)}
               data-series={t.data.series ?? ''} data-cat={t.data.category ?? ''} data-hay={hay(t)}>
            <VideoCard entry={t} />
          </div>
        ))}
      </div>
    </section>


    {/* ── all videos ──────────────────────────────────────────────────────
        Denvil, 2 Sep: all videos goes under the latest talks. It sat above
        them, so the page opened by asking a visitor to filter a library they
        had not seen yet. Now it reads the way the page is used: here is the
        newest, and here is everything.

        The "Browse all videos" link that used to sit on this row is gone with
        the move. It pointed at the grid immediately below it. */}
    <section class="shell wtabs-row">
      <h2 class="sec-h wtabs-h"><span class="u">All videos<Mark kind="underline" color="blue" draw={true} /></span></h2>
      <div class="wtabs" role="group" aria-label="Filter by kind">
        {/* "All" rather than "All videos": the heading directly above it
            already says All videos, and the same two words twice in three
            inches reads as a mistake. */}
        <button type="button" class="wtab on" data-cat="all" aria-pressed="true">All</button>
        {cats.map((c) => (
          <button type="button" class="wtab" data-cat={c} aria-pressed="false">{CAT_LABEL[c]}</button>
        ))}
      </div>
    </section>

    {/* The full library, with its own controls. The comp does not put a search
        box between the hero and the tab row, so it lives here with the thing it
        actually searches. */}
{anyControls && (
      <section class="shell watch-tools" id="watch-tools" hidden>
        {showSearch && (
          <div class="wsearch">
            <label class="sr-only" for="watch-q">Search the talks</label>
            <input id="watch-q" type="search" class="wsearch-in" autocomplete="off"
                   placeholder="Search by title, series or passage" />
          </div>
        )}
        {showSeries && (
          <div class="arc-filters" role="group" aria-label="Filter by series">
            <button type="button" class="chip-btn on" data-series="all" aria-pressed="true">All series</button>
            {series.map((s: any) => (
              <button type="button" class="chip-btn" data-series={s} aria-pressed="false">{s}</button>
            ))}
          </div>
        )}
        <p class="wcount" id="watch-count" role="status" aria-live="polite"></p>
      </section>
    )}
    {restTalks.length > 0 && (
      <section class="shell watch-all" id="watch-all">
        <div class="vcards vcards-lib">
          {restTalks.map((t: any) => (
            <div class="vwrap" id={`talk-${t.id}`} data-year={String(t.data.year)}
                 data-series={t.data.series ?? ''} data-cat={t.data.category ?? ''} data-hay={hay(t)}>
              <VideoCard entry={t} />
            </div>
          ))}
        </div>
      </section>
    )}

    {anyControls && (
      <p class="shell wempty" id="watch-empty" hidden>
        Nothing matches that. <button type="button" class="go" id="watch-clear">Clear the filters</button>
      </p>
    )}

    {/* No way out to a third party. This is Denvil's teaching library, and
        where the file happens to live is a maintenance detail rather than
        something to send a reader away over. */}
  </div>

  <script>
    /* The controls are hidden in the markup and revealed here, so a reader
       with JavaScript off is never shown a search box that does nothing. */
    const tools = document.getElementById('watch-tools');
    if (tools) {
      tools.hidden = false;
      const q = document.getElementById('watch-q') as HTMLInputElement | null;
      const wraps = Array.from(document.querySelectorAll<HTMLElement>('.vwrap'));
      const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-year-block]'));
      const countEl = document.getElementById('watch-count');
      const emptyEl = document.getElementById('watch-empty');
      const clearBtn = document.getElementById('watch-clear');
      let year = 'all';
      let ser = 'all';

      const setPressed = (group: string, val: string) => {
        document.querySelectorAll<HTMLElement>(`[data-${group}]`).forEach((b) => {
          if (b.tagName !== 'BUTTON') return;
          const on = b.dataset[group] === val;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      };

      let cat = 'all';
      const apply = () => {
        const term = (q?.value ?? '').trim().toLowerCase();
        let shown = 0;
        wraps.forEach((w) => {
          const ok =
            (year === 'all' || w.dataset.year === year) &&
            (ser === 'all' || w.dataset.series === ser) &&
            (cat === 'all' || w.dataset.cat === cat) &&
            (!term || (w.dataset.hay ?? '').includes(term));
          w.hidden = !ok;
          if (ok) shown++;
        });
        /* A year heading with nothing under it is a heading for an empty
           room. Hide the whole block instead. */

        if (countEl) {
          countEl.textContent = shown === wraps.length
            ? `${wraps.length} talk${wraps.length === 1 ? '' : 's'}`
            : `${shown} of ${wraps.length}`;
        }
        if (emptyEl) emptyEl.hidden = shown !== 0;
      };

      document.querySelectorAll<HTMLElement>('button[data-year]').forEach((b) => {
        b.addEventListener('click', () => { year = b.dataset.year ?? 'all'; setPressed('year', year); apply(); });
      });
      document.querySelectorAll<HTMLElement>('button[data-series]').forEach((b) => {
        b.addEventListener('click', () => { ser = b.dataset.series ?? 'all'; setPressed('series', ser); apply(); });
      });
      document.querySelectorAll<HTMLElement>('button[data-cat]').forEach((b) => {
        b.addEventListener('click', () => { cat = b.dataset.cat ?? 'all'; setPressed('cat', cat); apply(); });
      });
      q?.addEventListener('input', apply);
      clearBtn?.addEventListener('click', () => {
        year = 'all'; ser = 'all'; cat = 'all';
        if (q) q.value = '';
        setPressed('year', 'all'); setPressed('series', 'all'); setPressed('cat', 'all');
        apply();
        q?.focus();
      });
      apply();
    }
  </script>

  {/* The comp closes Watch on a yellow band. Its three lines are the comp's own
      copy, not Denvil's, and are flagged as such: they promise a cadence
      ("New videos every month") that nobody has committed to, so the promise is
      dropped and the rows describe what the room already is. */}
  <CloseBand tone="yellow"
             heading="Want more teachings like this?"
             mark="more" markKind="circle-loose" markColor="blue"
             dek="Sermons, teachings and conversations, gathered in one place."
             href="/subscribe/" cta="Subscribe to updates">
    <ul class="cband-pts" slot="aside">
      <li><Glyph name="play"  tone="blue"  />Talks and full teachings</li>
      <li><Glyph name="note"  tone="coral" />Reflections that go deeper</li>
      <li><Glyph name="heart" tone="green" />Practical wisdom for everyday life</li>
    </ul>
  </CloseBand>
</Shell>
