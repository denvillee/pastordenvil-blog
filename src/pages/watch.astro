---
/*
  Watch. Embeds only, never re-hosted, newest year first.

  The reference shows category filters. There is no category in the data and
  inventing one would be a taxonomy the content cannot support, so the page
  groups by the one real axis it has, which is the year the talk was given.
*/
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import VideoCard from '../components/VideoCard.astro';
import site from '../data/site.json';
import labels from '../data/labels.json';

const all = await getCollection('watch');
/* Grouped by year, newest year first, newest talk first inside each year.
   Nothing is pulled out as a featured item: Denvil has not asked for one, and
   lifting the first talk above its own year broke the ordering the spec
   asks for. Sort on the day it was given where we have it, and fall back to
   the year plus the manual order where we do not. */
const talks = all
  .filter((t: any) => !t.data.draft)
  .sort((a: any, b: any) => {
    if (a.data.year !== b.data.year) return b.data.year - a.data.year;
    const ad = a.data.givenOn ? a.data.givenOn.getTime() : 0;
    const bd = b.data.givenOn ? b.data.givenOn.getTime() : 0;
    if (ad !== bd) return bd - ad;
    return b.data.order - a.data.order || a.data.title.localeCompare(b.data.title);
  });

const years = [...new Set(talks.map((t: any) => t.data.year))].sort((a, b) => b - a);
---
<Shell title={`${labels.watchHeading} · ${site.name}`} description={labels.watchDek} current="watch">
  <div class="arch">
    <Mark kind="brush" color="yellow" class="arch-brush" />

    <section class="shell watch-hero">
      <div>
        <h1 class="page-h is-display">{labels.watchHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          Teachings and conversations,&#32;<span class="u">embedded from where they were first shared.<Mark kind="underline" color="yellow" /></span>
        </p>
        {/* No empty state. */}
      </div>
      <div class="watch-feat">
        <ColorDisc lines={["theology","leadership","life"]} class="watch-disc" />
      </div>
    </section>

    {years.map((y) => (
      <section class="shell watch-year">
        <div class="sec-head"><h2 class="sec-h">{y}</h2></div>
        <div class="vcards">
          {talks.filter((t: any) => t.data.year === y).map((t: any) => <VideoCard entry={t} />)}
        </div>
      </section>
    ))}

    {talks.length > 0 && (
      <section class="shell watch-more">
        {/* The Chapel's own 2024 sermon library. Denvil is one voice among the
            others in it, which is exactly why it belongs here as a way out
            rather than as more of his cards. */}
        <a class="go" href="https://vimeo.com/showcase/10899137" rel="noopener nofollow" target="_blank">
          More from The Chapel's sermon library <span aria-hidden="true">&#8599;</span>
        </a>
      </section>
    )}

    {talks.length > 0 && <p class="shell watch-note">{labels.watchRights}</p>}
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}
</Shell>
