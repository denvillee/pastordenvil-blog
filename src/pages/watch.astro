---
/*
  Watch. Embeds only, never re-hosted, newest year first.

  The reference shows category filters. There is no category in the data and
  inventing one would be a taxonomy the content cannot support, so the page
  groups by the one real axis it has, which is the year the talk was given.
*/
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import Photo from '../components/Photo.astro';
import ImageMask from '../components/ImageMask.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import VideoCard from '../components/VideoCard.astro';
import Signup from '../components/Signup.astro';
import site from '../data/site.json';
import labels from '../data/labels.json';

const all = await getCollection('watch');
const talks = all.filter((t: any) => !t.data.draft)
  .sort((a: any, b: any) => b.data.year - a.data.year
    || b.data.order - a.data.order
    || a.data.title.localeCompare(b.data.title));

const [featured, ...rest] = talks;
const years = [...new Set(rest.map((t: any) => t.data.year))].sort((a, b) => b - a);
---
<Shell title={`${labels.watchHeading} · ${site.name}`} description={labels.watchDek} current="watch">
  <div class="arch">
    <Mark kind="brush" color="yellow" class="arch-brush" />

    <section class="shell watch-hero">
      <div>
        <h1 class="page-h is-display">{labels.watchHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          Teachings and conversations on&#32;<span class="u">theology<Mark kind="underline" color="yellow" /></span>,&#32;<span class="u">leadership<Mark kind="underline" color="green" /></span>, and&#32;<span class="u">ordinary life<Mark kind="underline" color="coral" /></span>.
        </p>
        {talks.length === 0 && <p class="empty-note">{labels.watchEmpty}</p>}
      </div>
      {featured
        ? <div class="watch-feat"><VideoCard entry={featured} featured={true} /></div>
        : <div class="watch-feat">
            <ImageMask shape="torn">
              <Photo name="dl-watch" width={1400} height={933}
                     sizes="(max-width: 900px) 92vw, 52vw"
                     alt="Denvil Lee teaching, arms open, a slide behind him." />
            </ImageMask>
            <ColorDisc lines={["theology","leadership","life"]} class="watch-disc" />
          </div>}
    </section>

    {years.map((y) => (
      <section class="shell watch-year">
        <div class="sec-head"><h2 class="sec-h">{y}</h2></div>
        <div class="vcards">
          {rest.filter((t: any) => t.data.year === y).map((t: any) => <VideoCard entry={t} />)}
        </div>
      </section>
    ))}

    {talks.length > 0 && <p class="shell watch-note">{labels.watchRights}</p>}
  </div>
  <Signup tone="yellow" note="Good news for ordinary people." />
</Shell>
