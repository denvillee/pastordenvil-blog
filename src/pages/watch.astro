---
import Base from '../layouts/Base.astro';
import Embed from '../components/Embed.astro';
import Signup from '../components/Signup.astro';
import { published, fmtShort } from '../lib/content';
const clips = await published('watch');
const KIND: Record<string, string> = {
  hook: 'Monday · the hook',
  'micro-teaching': 'Wednesday · micro teaching',
  human: 'Friday · the human one',
  question: 'Saturday · a real question',
};
---
<Base title="Watch" description="Vertical clips, thirty to sixty seconds, captions burned in.">
  <section class="ph on-dark">
    <div class="wrap">
      <p class="label">Four to five a week</p>
      <h1 class="ph__h">Watch</h1>
      <p class="ph__dek">
        Thirty to sixty seconds, vertical, captions burned in. Four clips a week,
        all cut from one message and one recording session. Nothing here is a
        trailer for something else.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      {clips.length === 0
        ? <p class="empty">The first clips post the week of August 31.</p>
        : <div class="grid grid--4">
            {clips.map((c) => (
              <article class="clip reveal">
                <Embed provider={c.data.provider} videoId={c.data.videoId} title={c.data.title} vertical credit={c.data.sourceCredit} />
                <p class="clip__kind label">{KIND[c.data.kind] ?? c.data.kind}</p>
                <h2 class="clip__h">{c.data.title}</h2>
                <p class="clip__meta tabular">
                  {fmtShort(c.data.publishAt)}{c.data.seconds ? ` · ${c.data.seconds}s` : ''}
                </p>
              </article>
            ))}
          </div>}

      <p class="note">
        Messages preached on a church platform are embedded from that church's
        own channel, never re-uploaded here. Credit and traffic stay where they
        belong.
      </p>
    </div>
  </section>
  <Signup tone="ivy" />
</Base>
<style>
  .ph { padding-block: clamp(2.8rem, 2.2rem + 3vw, 5rem); }
  .ph__h { font-size: var(--step-5); margin-top: 1rem; }
  .ph__dek { margin-top: 1.2rem; max-width: 54ch; font-family: var(--font-warm); font-size: var(--step-1); line-height: 1.65; color: var(--fg-muted); }
  .empty { color: var(--fg-muted); font-family: var(--font-warm); font-size: var(--step-1); }
  .clip { display: flex; flex-direction: column; gap: 0.5rem; }
  .clip__kind { margin-top: 0.7rem; }
  .clip__h { font-size: var(--step-0); font-weight: 700; letter-spacing: -0.02em; }
  .clip__meta { font-size: var(--step--2); color: var(--fg-faint); }
  .note { margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: var(--step--1); color: var(--fg-faint); max-width: 56ch; }
</style>
