---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import { live, readMinutes, displayDate, isoDate } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';
const entries = await live('frameworks');
const years = [...new Set(entries.map((e: any) => e.data.publishAt.getFullYear()))];
const byYear = years.map((y) => ({ year: y, items: entries.filter((e: any) => e.data.publishAt.getFullYear() === y) }));
const title = labels.frameworksHeading;
const dek = labels.frameworksDek;
---
<Base title={`${title} — ${site.name}`} description={dek}>
  <section class="band shell">
    <div class="sec-head">
      <h1>{title}</h1>
    </div>
    <p class="art-dek" style="margin-bottom:1.6rem">{dek}</p>
    {byYear.map((group) => (
      <section class="arc-year">
        {years.length > 1 && <h2 class="arc-year-h">{group.year}<span>{group.items.length}</span></h2>}
        <div class="list">
          {group.items.map((e: any) => (
            <a class="list-item" href={`/frameworks/${e.id}/`}>
              <span class="date"><time datetime={isoDate(e.data.publishAt)}>{displayDate(e.data.publishAt)}</time></span>
              <span class="t">{e.data.title}<span class="d">{e.data.dek}</span></span>
              <span class="r">{readMinutes(e.body)} min</span>
            </a>
          ))}
        </div>
      </section>
    ))}
    {entries.length === 0 && <p class="art-dek">{labels.frameworksEmpty}</p>}
  </section>
  <Signup />
</Base>
