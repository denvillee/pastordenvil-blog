---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import { published, fmtDate } from '../../lib/content';
const items = (await published('frameworks')).sort((a, b) => a.data.number - b.data.number);
---
<Base title="Frameworks" description="A theological system, drawn. One diagram, one essay, one clip, one guide.">
  <section class="ph">
    <div class="wrap">
      <p class="label">Monthly</p>
      <h1 class="ph__h">Frameworks</h1>
      <p class="ph__dek">
        A drawn idea travels further than a described one, and people want the
        system rather than the verse list. Each framework is one diagram, one
        essay, one sixty-second clip, and a one-page guide you can print.
      </p>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      {items.length === 0
        ? <p class="empty">Framework 01, The Two Ages, publishes September 2.</p>
        : <div class="fw-list">
            {items.map((f) => (
              <a class="fw reveal" href={`/frameworks/${f.id}/`}>
                <span class="fw__num tabular">{String(f.data.number).padStart(2, '0')}</span>
                <span class="fw__body">
                  <span class="fw__h">{f.data.title}</span>
                  <span class="fw__dek">{f.data.summary}</span>
                  {f.data.beats.length > 0 && (
                    <span class="fw__beats">{f.data.beats.map((b) => <span class="fw__beat">{b}</span>)}</span>
                  )}
                  <span class="fw__date">{fmtDate(f.data.publishAt)}</span>
                </span>
              </a>
            ))}
          </div>}
    </div>
  </section>
  <Signup tone="brass" heading="The guides come by email"
    dek="Each framework ships with a one-page printable guide. Subscribers get it the day it publishes." />
</Base>
<style>
  .ph { padding-block: clamp(2.8rem, 2.2rem + 3vw, 5rem) clamp(1.8rem, 1.4rem + 1.6vw, 2.8rem); border-bottom: 1px solid var(--line); }
  .ph__h { font-size: var(--step-5); margin-top: 1rem; }
  .ph__dek { margin-top: 1.2rem; max-width: 54ch; font-family: var(--font-warm); font-size: var(--step-1); line-height: 1.65; color: var(--fg-muted); }
  .empty { color: var(--fg-muted); font-family: var(--font-warm); font-size: var(--step-1); }
  .fw-list { display: flex; flex-direction: column; gap: 1rem; }
  .fw {
    display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.2rem;
    padding: 1.5rem 1.5rem 1.6rem; text-decoration: none;
    border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--ground-raised);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .fw:hover { border-color: var(--accent); transform: translateX(3px); }
  @media (max-width: 620px) { .fw { grid-template-columns: 1fr; gap: 0.5rem; } }
  /* Brass is a SURFACE, never text — as brass-on-bone is 1.46:1. So the
     numeral sits in a brass block carrying Ink, which clears 11.4:1. */
  .fw__num {
    display: grid; place-items: center;
    width: 3.4rem; height: 3.4rem; border-radius: var(--radius);
    background: var(--highlight); color: var(--highlight-on);
    font-size: var(--step-2); font-weight: 800; line-height: 1; letter-spacing: -0.03em;
  }
  .fw__body { display: flex; flex-direction: column; gap: 0.5rem; }
  .fw__h { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.03em; }
  .fw__dek { font-family: var(--font-warm); font-size: var(--step--1); line-height: 1.6; color: var(--fg-muted); max-width: 56ch; }
  .fw__beats { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem; }
  .fw__beat {
    font-size: var(--step--2); padding: 0.22rem 0.6rem; border-radius: 999px;
    background: var(--accent-wash); color: var(--accent);
  }
  .fw__date { margin-top: 0.5rem; font-size: var(--step--2); color: var(--fg-faint); }
</style>
