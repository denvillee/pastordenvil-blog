---
import Shell from '../../layouts/Shell.astro';
import site from '../../data/site.json';
---
<Shell title={`Thank you · ${site.name}`} description="Your note is in." noindex={true}>
  <section class="band shell err">
    <div>
      <h1 style="font-size:clamp(2rem,7vw,4rem)">Got it</h1>
      <p class="art-dek" style="margin-inline:auto">Your note comes straight to me. I read every one of them myself.</p>
      <p><a class="btn btn-primary" href="/">Back home</a></p>
    </div>
  </section>
</Shell>
