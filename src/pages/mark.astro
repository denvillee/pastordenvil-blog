---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
const DAYS = 71;
---
<Base title="The Mark Reading Plan" description="Seventy-one days through the Gospel of Mark, together, by email. Starting January 2027.">
  <section class="ph on-dark">
    <div class="wrap ph__grid">
      <div>
        <p class="label ph__k">January 2027 · free</p>
        <h1 class="ph__h">Read Mark with us. Seventy-one days.</h1>
        <p class="ph__dek">
          Mark is the shortest Gospel and the fastest — he uses the word
          "immediately" more than forty times. So there is something contrary
          about taking seventy-one days to read it. That is the point.
        </p>
        <p class="ph__dek">
          Short daily readings by email, a weekly frame for small groups, and
          notes for whoever is preaching alongside it. A whole church can run
          this, and several have.
        </p>
      </div>
      <div class="cal" aria-hidden="true">
        {Array.from({ length: DAYS }).map((_, i) => (
          <span class:list={['cal__d', { 'is-week': i % 7 === 0 }]}></span>
        ))}
      </div>
    </div>
  </section>

  <Signup offer="mark" tone="brass" heading="Save me a seat in January"
    dek="One email now to confirm, then nothing until the plan opens. If you want the booklet as a PDF to print for your church, say so when you reply and I will send it."
    cta="Sign me up" />

  <section class="band">
    <div class="wrap wrap--read">
      <h2 class="h2">How it runs</h2>
      <ol class="how">
        <li><strong>Day one lands the first week of January.</strong> A short passage, and two or three sentences from me. Nothing that takes longer than the reading itself.</li>
        <li><strong>Every seventh day is a frame, not a reading.</strong> Where you have been, what Mark is doing with it, and the questions worth taking to a group.</li>
        <li><strong>It finishes at Easter.</strong> Which is the only reasonable place to finish Mark.</li>
        <li><strong>Churches are welcome to run it.</strong> Free, no permission needed, no attribution required. Tell me if you do — I like knowing.</li>
      </ol>
    </div>
  </section>
</Base>
<style>
  .ph { padding-block: clamp(3rem, 2.4rem + 3.5vw, 6rem); }
  .ph__grid { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 4rem); grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr); align-items: center; }
  @media (max-width: 820px) { .ph__grid { grid-template-columns: 1fr; } }
  .ph__k { color: var(--brass); }
  .ph__h { font-size: var(--step-4); margin-top: 1rem; max-width: 16ch; }
  .ph__dek { margin-top: 1.2rem; max-width: 50ch; font-family: var(--font-warm); font-size: var(--step-1); line-height: 1.65; color: var(--fg-muted); }
  .cal { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; max-width: 260px; margin-inline: auto; }
  .cal__d { aspect-ratio: 1; border-radius: 2px; background: color-mix(in srgb, var(--brass) 22%, transparent); }
  .cal__d.is-week { background: var(--brass); }
  .h2 { font-size: var(--step-3); }
  .how { margin-top: 1.6rem; padding-left: 1.2rem; display: grid; gap: 1rem; font-family: var(--font-warm); font-size: var(--step-1); line-height: 1.6; }
  .how strong { font-family: var(--font-loud); font-size: 0.92em; }
</style>
