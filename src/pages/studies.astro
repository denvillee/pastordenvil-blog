---
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import ImageMask from '../components/ImageMask.astro';
import Photo from '../components/Photo.astro';
import TopicIcon from '../components/TopicIcon.astro';
import home from '../data/home.json';
import site from '../data/site.json';

const STUDY='https://grabyourbibles.com/quietly-at-work/';
const coming=[
  {title:'Prayers for Real Life',label:'PSALMS',copy:'Walk through the Psalms and discover how to bring your whole self to God.',image:'dl-studies'},
  {title:'Faith That Works',label:'JAMES',copy:'A practical look at what it means to live out your faith every day.',image:'dl-pile'},
  {title:'Joy, No Matter What',label:'PHILIPPIANS',copy:"Paul's letter on contentment, unity, and joy in every season.",image:'dl-hero-v2'},
  {title:'Leading with Wisdom',label:'LEADERSHIP',copy:'Timeless principles for leading people the way Jesus did.',image:'dl-books'},
];
const steps=[
  {icon:'book',tone:'blue',title:'1. Choose a study',copy:'Pick a study that fits your season and your goals.'},
  {icon:'calendar',tone:'yellow',title:'2. Set your rhythm',copy:'Work through it at your own pace, individually or with a group.'},
  {icon:'people',tone:'coral',title:'3. Go deeper together',copy:'Use the prompts, reflections, and Scripture to grow in wisdom and love.'},
  {icon:'plant',tone:'green',title:'4. Live it out',copy:'Take what you learn into your everyday life and leadership.'},
] as const;
---
<Shell title={`Studies · ${site.name}`} description="Guided Bible studies you can walk through on your own or with a group." current="studies">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />
    <section class="shell std-hero">
      <div><h1 class="page-h is-display"><span class="u">Studies<Mark kind="underline" color="blue" draw={true} /></span></h1><p class="page-dek">Resources for going deeper, individually or <span class="u">in community.<Mark kind="underline" color="green" /></span></p><p class="std-intro-copy">Theology isn't just for the classroom. These studies are for your everyday, your Bible, your people, your pace.</p><p class="std-quick">Short on time?<br />Each study is designed to fit real life.</p></div>
      <div class="std-art"><ImageMask shape="torn" tape="blue" tapeAt="tr"><Photo name="dl-studies" width={1400} height={1050} sizes="(max-width:900px) 92vw, 46vw" alt="An open Bible, a mug, and a notebook on a table." /></ImageMask><StickyNote tone="paper" tilt={1.3} tape={false} class="std-side-note">Let's grow in wisdom, together.</StickyNote></div>
    </section>

    <section class="shell"><div class="panel panel-dark std-feat"><Mark kind="zigzag" color="blue" class="panel-zig" /><div class="std-feat-copy"><p class="std-eyebrow">{home.studiesPill}</p><h2 class="panel-h"><span class="u">Grab Your Bibles.<Mark kind="underline" color="blue" /></span></h2><p class="std-feat-name">Quietly at Work</p><p class="std-feat-sub">Finding God's Presence in the Book of Ruth</p><p class="panel-dek">God never speaks out loud in Ruth, and he never stops working. Seven sessions learning to recognize God's presence in the ordinary parts of the story.</p><p class="std-feat-meta">7 sessions · on your own or with a group</p><a class="btn btn-light" href={STUDY} rel="noopener">Start the study <span class="arw" aria-hidden="true">&rarr;</span></a></div><div class="std-feat-art"><Photo name="ruth-cover" width={1600} height={845} sizes="(max-width:760px) 92vw, 44vw" alt="Cover art for the Ruth study Quietly at Work." /><span class="chip chip-light std-tag">RUTH</span></div></div></section>

    <section class="shell std-more"><div class="sec-head"><h2 class="sec-h"><span class="u">Explore more studies<Mark kind="underline" color="yellow" /></span></h2><a class="go" href="/studies/">See all studies <span aria-hidden="true">&rarr;</span></a></div><div class="std-more-grid">{coming.map((s)=>(<article class="std-coming"><div class="std-coming-art"><Photo name={s.image} width={900} height={580} sizes="(max-width:760px) 92vw, 22vw" alt="" /><span class="study-pill">{s.label}</span></div><h3>{s.title}</h3><p>{s.copy}</p><span class="status">Coming soon</span></article>))}</div></section>

    <section class="shell std-how"><h2 class="sec-h"><span class="u">How studies work<Mark kind="underline" color="green" /></span></h2><div class="std-how-grid">{steps.map((s)=>(<div class="std-step"><span class={`tico-wrap tico-${s.tone}`}><TopicIcon icon={s.icon} /></span><h3>{s.title}</h3><p>{s.copy}</p></div>))}</div></section>
  </div>
</Shell>
