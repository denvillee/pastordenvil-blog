---
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Doorway from '../components/Doorway.astro';
import Mark from '../components/marks/Mark.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import ImageMask from '../components/ImageMask.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import home from '../data/home.json';
import site from '../data/site.json';

const STUDY = 'https://grabyourbibles.com/quietly-at-work/';
const landingDoc = await getEntry('landing', 'studies');
const { Content: LandingBody } = landingDoc ? await render(landingDoc) : { Content: null };

const coming = [
  { title:'The next study', copy:'A future guided study will live here.' },
  { title:'Another way into Scripture', copy:'This card is ready for the next resource.' },
  { title:'For groups or on your own', copy:'New studies can slot into this same system.' },
  { title:'A study for leaders', copy:'Room is already built for a different kind of guide.' },
];
const steps = [
  { kind:'studies', title:'1. Choose a study', copy:'Pick the resource that fits what you want to explore.' },
  { kind:'moments', title:'2. Set your rhythm', copy:'Work through it at your own pace, alone or with others.' },
  { kind:'leaders', title:'3. Go deeper together', copy:'Use the questions, Scripture, and reflection to engage.' },
  { kind:'reading', title:'4. Live it out', copy:'Take what you notice into the ordinary life in front of you.' },
] as const;
---
<Shell title={`Studies · ${site.name}`} description="Guided Bible studies you can walk through on your own or with a group." current="studies">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />
    <section class="shell std-hero">
      <div><h1 class="page-h is-display"><span class="u">Studies<Mark kind="underline" color="blue" draw={true} /></span></h1><p class="page-dek">Guided ways into Scripture, for yourself or&#32;<span class="u">with others.<Mark kind="underline" color="green" /></span></p><p class="std-quick">A study should help you engage Scripture, not simply finish a lesson.</p></div>
      <div class="std-art"><ImageMask shape="torn" tape="blue" tapeAt="tr"><Photo name="dl-studies" width={1400} height={1050} sizes="(max-width: 900px) 92vw, 46vw" alt="A stack of Denvil's books on a table, spines out." /></ImageMask><StickyNote tone="paper" tilt={1.3} tape={false} class="std-side-note">May you find him, fall in love with him, and follow him.</StickyNote></div>
    </section>
    {LandingBody && <Doorway tone="coral" collapsed={true}><LandingBody /></Doorway>}
    <section class="shell"><div class="panel panel-dark std-feat"><Mark kind="zigzag" color="blue" class="panel-zig" /><div class="std-feat-copy"><p class="std-eyebrow">{home.studiesPill}</p><h2 class="panel-h"><span class="u">{home.studiesHeading}<Mark kind="underline" color="blue" /></span></h2><p class="std-feat-name">Quietly at Work</p><p class="std-feat-sub">Finding God's Presence in the Book of Ruth</p><p class="panel-dek">God never speaks out loud in Ruth, and he never stops working. Seven sessions learning to recognize God's presence in loss, provision, waiting, ordinary faithfulness, and the parts of the story we cannot yet see.</p><p class="std-feat-meta">7 sessions &middot; on your own or with a group</p><a class="btn btn-light" href={STUDY} rel="noopener">{home.studiesCta} <span class="arw" aria-hidden="true">&rarr;</span></a></div><div class="std-feat-art"><Photo name="ruth-cover" width={1600} height={845} sizes="(max-width: 760px) 92vw, 44vw" alt="Cover art for the Ruth study: the word Ruth in deep navy over a barley field, with Grab Your Bibles circled above it." /><span class="chip chip-light std-tag">Ruth</span></div></div></section>
    <section class="shell std-more"><div class="sec-head"><h2 class="sec-h"><span class="u">Explore more studies<Mark kind="underline" color="yellow" /></span></h2></div><div class="std-more-grid">{coming.map((s) => (<article class="std-coming"><div class="std-coming-art"><Placeholder label="Future study artwork" ratio="1.55 / 1" /></div><h3>{s.title}</h3><p>{s.copy}</p><span class="status">Coming soon</span></article>))}</div></section>
    <section class="shell std-how"><h2 class="sec-h"><span class="u">How studies work<Mark kind="underline" color="green" /></span></h2><div class="std-how-grid">{steps.map((s) => (<div class="std-step"><CategoryIcon kind={s.kind} /><h3>{s.title}</h3><p>{s.copy}</p></div>))}</div></section>
  </div>
</Shell>
