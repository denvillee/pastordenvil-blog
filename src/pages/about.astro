---
import { getEntry } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import Photo from '../components/Photo.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { latest, ROOMS } from '../lib/publish';
import site from '../data/site.json';

const entry = await getEntry('pages', 'about');
const feature = await latest();
const featureHref = feature ? `/${ROOMS[feature.room].path}/${feature.id}/` : '/essays/';
const areas = [
  { kind:'essays', href:'/essays/', t:'Faith & Theology', d:'Deepen your grasp of Scripture and the good news of the kingdom.' },
  { kind:'moments', href:'/moments/', t:'Everyday Faith', d:'Reflections for ordinary days, work, family, rest, and everything in between.' },
  { kind:'studies', href:'/leaders/', t:'Leadership', d:'Encouragement and wisdom for leading with humility and kingdom perspective.' },
  { kind:'reading', href:'/bookshelf/', t:'Culture & Life', d:'Thoughts on navigating culture with faith, grace, and courage.' },
] as const;
---
<Shell title={`About · ${site.name}`} description={entry!.data.dek} current="about">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />
    <section class="shell abt-hero">
      <div>
        <h1 class="page-h is-display">About<span class="dot">.</span><Mark kind="underline" color="blue" class="page-uline" draw={true} /></h1>
        <p class="abt-hi"><span class="u">Hey, I'm Denvil.<Mark kind="underline" color="yellow" /></span></p>
        <p class="abt-bio">I'm a follower of Jesus, a husband, dad, and a pastor who loves helping people see how the kingdom of God meets us in <span class="u">real, ordinary life.<Mark kind="underline" color="green" /></span></p>
        <p class="hero-acts"><a class="btn btn-blue" href={featureHref}>Read my latest essay <span class="arw" aria-hidden="true">&rarr;</span></a></p>
      </div>
      <div class="abt-art">
        <Photo name="dl-hero-v2" width={1600} height={1000} sizes="(max-width:900px) 92vw, 58vw" alt="Denvil Lee sitting at a table with an open Bible." />
        <ColorDisc lines={["theology","leadership","life"]} class="abt-disc" />
      </div>
    </section>

    <section class="shell abt-why">
      <div class="abt-why-copy">
        <h2 class="sec-h"><span class="u">Why this site exists<Mark kind="underline" color="yellow" /></span></h2>
        <p>This space exists to explore what it looks like to live under the rule of Jesus, right here, right now.</p>
        <p>No hype. No pretense. Just honest reflections from Scripture and life, for those who are learning, leading, and longing to live faithfully in a noisy world.</p>
      </div>
      <div class="abt-quote" aria-label="A central conviction"><span class="qmark q1" aria-hidden="true">“</span><blockquote>The kingdom of God isn't just future, it's here, and it's changing everything.</blockquote><span class="qmark q2" aria-hidden="true">”</span></div>
    </section>

    <section class="band shell">
      <div class="sec-head"><h2 class="sec-h"><span class="u">What we explore here<Mark kind="underline" color="green" /></span></h2></div>
      <div class="abt-explore">
        <div class="shortcuts abt-areas">{areas.map((a)=>(<a class="short" href={a.href}><CategoryIcon kind={a.kind} /><h3>{a.t}</h3><p>{a.d}</p><span class="arw" aria-hidden="true">&rarr;</span></a>))}</div>
        <div class="panel panel-light abt-sign"><h2 class="panel-h"><span class="u">Kingdom theology. Ordinary life.<Mark kind="underline" color="blue" /></span></h2><p class="panel-dek">That's the heartbeat of everything I write.</p><p class="panel-dek">Thanks for being here. I hope these words encourage and equip you on the way.</p><p class="abt-name">Denvil</p></div>
      </div>
    </section>

    <section class="shell mock-signup" aria-label="Email updates">
      <div><h2><span class="u">Let's keep growing together.<Mark kind="underline" color="green" /></span></h2><p>New essays, studies, and reflections straight to your inbox. No noise, just something worth sharing.</p></div>
      <div class="mock-email"><span>Enter your email</span><a href="/subscribe/">Subscribe <span aria-hidden="true">&rarr;</span></a></div>
      <div class="mock-thanks">Thanks for reading.<br />You're not alone.<span class="mock-heart" aria-hidden="true"></span></div>
    </section>
  </div>
</Shell>
