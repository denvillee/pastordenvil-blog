---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import site from '../data/site.json';
import labels from '../data/labels.json';
const entry = await getEntry('pages', 'about');
const { Content } = await render(entry!);
---
<Base title={`${entry!.data.title} — ${site.name}`} description={entry!.data.dek}>
  <section class="band shell">
    <div class="sec-head"><h1>{entry!.data.title}</h1><span class="label">{labels.aboutLabel}</span></div>
    <div class="prose"><Content /></div>
  </section>
  <Signup />
</Base>
