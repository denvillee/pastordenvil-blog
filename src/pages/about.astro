---
import CloseBand from '../components/CloseBand.astro';
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import Tape from '../components/marks/Tape.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import Photo from '../components/Photo.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { latest, ROOMS } from '../lib/publish';
import site from '../data/site.json';

const entry = await getEntry('pages', 'about');
const feature = await latest();
const featureHref = feature ? `/${ROOMS[feature.room].path}/${feature.id}/` : '/essays/';

/* Denvil's own line, already on the page, kept word for word. */
/* Denvil's own paragraph, 29 Aug. */
const conviction = "Everything here grows out of one conviction: God's kingdom has already arrived in Jesus, and it has not yet come in fullness. Most of the questions I care about live somewhere in that tension. I want to keep asking what the good news means for Scripture, leadership, work, relationships, formation, and the ordinary life in front of us.";

/* The site's own rooms, in the site's own vocabulary. The page used to list
   "Faith & Theology", "Everyday Faith" and "Leadership", which are three names
   the site does not use anywhere else. */
const areas = [
  { kind: 'essays',  href: '/essays/',    t: 'Essays',
    d: 'Longer reflections where I have room to follow an idea.' },
  { kind: 'moments', href: '/moments/',   t: 'Moments',
    d: 'Things I am trying to notice before I explain them away.' },
  { kind: 'reading', href: '/bookshelf/', t: 'Bookshelf',
    d: 'The books and voices shaping how I think.' },
  { kind: 'studies', href: '/studies/',   t: 'Studies',
    d: 'Ways to open Scripture and learn to see for yourself.' },
  { kind: 'leaders', href: '/leaders/',   t: 'For Leaders',
    d: 'Lessons from a few short steps ahead.' },
] as const;
---
<Shell title={`About · ${site.name}`} description={entry!.data.dek} current="about">
  <div class="arch">
    <Mark kind="arrow" color="coral" class="edge edge-r abt-edge" />
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell abt-hero">
      <div>
        <h1 class="page-h is-display">About<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="abt-hi"><span class="u">Hey, I'm Denvil.<Mark kind="underline" color="yellow" /></span></p>
        <p class="abt-bio">
          I'm a follower of Jesus, husband to Krista, dad to three incredible kids, and a
          pastor who cares about what faith looks like in the real world. I'm especially
          interested in the&#32;<span class="u">kingdom of God,<Mark kind="underline" color="yellow" /></span> forming healthy leaders,
          and helping people come alive to the reality of God's love in ordinary life.
        </p>
        <p class="hero-acts">
          <a class="btn btn-blue" href={featureHref}>Read my latest essay <span class="arw" aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
      <div class="abt-art">
          {/* One person, because a reader who came to find out who he is should
              not have to guess which one he is. The lit panels behind him are
              graded down to two soft darks; his shirt already sits close to
              --card, which is why this frame belongs on this palette. */}
          <Photo name="dl-about-v2" width={900} height={1180}
                 sizes="(max-width: 900px) 92vw, 40vw"
                 alt="Denvil Lee standing, hands in his pockets, looking at the camera." />
        <ColorDisc lines={["theology","leadership","life"]} class="abt-disc" />
      </div>
    </section>

    <section class="shell abt-why">
      <div class="abt-why-copy">
        <h2 class="sec-h"><span class="u">Why this site exists<Mark kind="underline" color="yellow" /></span></h2>
        <p>{conviction}</p>
      </div>
      {/* The comp sets a handwritten line to the right of this paragraph, in
          large blue quote marks, with a dashed rule between the two columns.

          Its wording was "The kingdom of God isn't just future — it's here, and
          it's changing everything." Not used: Denvil's own version of that
          sentence is already on the home page, and his is the one that goes
          here. */}
      <blockquote class="abt-quote">
        <span class="abt-q abt-q-o" aria-hidden="true">&ldquo;</span>
        <p>The kingdom is&#32;<span class="u">already here,<Mark kind="underline" color="blue" /></span>
           and&#32;<span class="u">still coming.<Mark kind="underline" color="blue" /></span></p>
        <span class="abt-q abt-q-c" aria-hidden="true">&rdquo;</span>
      </blockquote>
    </section>

    <section class="band shell">
      <div class="sec-head">
        <h2 class="sec-h"><span class="u">What we explore here<Mark kind="underline" color="green" /></span></h2>
      </div>
      <div class="abt-explore">
      <div class="shortcuts abt-areas">
        {areas.map((a) => (
          <a class="short" href={a.href}>
            <CategoryIcon kind={a.kind} />
            <h3>{a.t}</h3>
            <p>{a.d}</p>
            <span class="arw" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>

      {/* The comp's blue panel: a short statement, a taped polaroid with a
          handwritten caption, and a zigzag at the corner. */}
      <aside class="abt-panel">
        <h3 class="abt-panel-h">
          <span class="u">Kingdom theology.<Mark kind="underline" color="blue" /></span><br />Ordinary life.
        </h3>
        <p>That is the heartbeat of everything I write. Thanks for being here.</p>
        <figure class="abt-pola">
          <Tape color="blue" class="abt-pola-tape" />
          <Photo name="dl-stage-open" width={1600} height={1000}
                 sizes="(max-width: 900px) 60vw, 18vw"
                 alt="Denvil Lee teaching on stage in a yellow hoodie, arms open, under a Come Alive banner." />
          <figcaption>Keep walking.<Mark kind="underline" color="coral" /></figcaption>
        </figure>
        <p class="abt-name">Denvil<Mark kind="underline" color="blue" /></p>
        <Mark kind="zigzag" color="yellow" class="abt-panel-zig" />
      </aside>
      </div>
    </section>

    {/* The standalone "Kingdom theology. Ordinary life." panel that used to sit
        here is gone: the comp puts that line inside the blue panel beside
        "What we explore here", which is where it now lives. Two of them on one
        page said the same thing twice. His signature moved up with it. */}
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}

  {/* The comp closes About on a black band with an inline email field. The field
      itself is not reproduced here: the 29 Aug decision moved every signup to
      one place so the site stopped asking on every page, and two live forms for
      one list is a maintenance trap, not a design gain. The band and its CTA are
      the comp; the destination is /subscribe/. */}
  <CloseBand tone="dark"
             heading="Let's keep growing together."
             mark="together"
             dek="New essays, studies, and reflections."
             href="/subscribe/" cta="Subscribe" />
</Shell>
