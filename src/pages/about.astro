---
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import ImageMask from '../components/ImageMask.astro';
import Photo from '../components/Photo.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { latest, ROOMS } from '../lib/publish';
import site from '../data/site.json';

const entry = await getEntry('pages', 'about');
const feature = await latest();
const featureHref = feature ? `/${ROOMS[feature.room].path}/${feature.id}/` : '/essays/';

/* Denvil's own line, already on the page, kept word for word. */
/* Denvil's own paragraph, 29 Aug. */
const conviction = "Everything here grows out of one conviction: God's kingdom has already arrived in Jesus, and it has not yet come in fullness. Most of the questions I care about live somewhere in that tension. I want to keep asking what the good news means for Scripture, leadership, work, relationships, formation, and the ordinary life in front of us.";

/* The site's own rooms, in the site's own vocabulary. The page used to list
   "Faith & Theology", "Everyday Faith" and "Leadership", which are three names
   the site does not use anywhere else. */
const areas = [
  { kind: 'essays',  href: '/essays/',    t: 'Essays',
    d: 'Longer reflections where I have room to follow an idea.' },
  { kind: 'moments', href: '/moments/',   t: 'Moments',
    d: 'Things I am trying to notice before I explain them away.' },
  { kind: 'reading', href: '/bookshelf/', t: 'Bookshelf',
    d: 'The books and voices shaping how I think.' },
  { kind: 'studies', href: '/studies/',   t: 'Studies',
    d: 'Ways to open Scripture and learn to see for yourself.' },
  { kind: 'leaders', href: '/leaders/',   t: 'For Leaders',
    d: 'Lessons from a few short steps ahead.' },
] as const;
---
<Shell title={`About · ${site.name}`} description={entry!.data.dek} current="about">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell abt-hero">
      <div>
        <h1 class="page-h is-display">About<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="abt-hi"><span class="u">Hey, I'm Denvil.<Mark kind="underline" color="yellow" /></span></p>
        <p class="abt-bio">
          I'm Denvil, a pastor, teacher, husband, dad, and longtime student of Scripture.
          Before ministry, I worked in law enforcement, which probably explains some of my
          instinct to keep asking what is really happening beneath the surface. I care about
          the kingdom of God and what following Jesus looks like in the ordinary places we
          actually live.
        </p>
        <p class="hero-acts">
          <a class="btn btn-blue" href={featureHref}>Read my latest essay <span class="arw" aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
      <div class="abt-art">
        <ImageMask shape="torn">
          {/* A candid rather than a speaking photo, per the 29 Aug packet: the
              About page should read as a person, not as a platform. */}
          <Photo name="dl-candid" width={782} height={976}
                 sizes="(max-width: 900px) 92vw, 40vw"
                 alt="Denvil Lee in a church meeting room, in a green argyle vest, laughing at something off camera." />
        </ImageMask>
        <ColorDisc lines={["theology","leadership","life"]} class="abt-disc" />
      </div>
    </section>

    <section class="shell abt-why">
      <div class="abt-why-copy">
        <h2 class="sec-h"><span class="u">Why this site exists<Mark kind="underline" color="yellow" /></span></h2>
        <p>{conviction}</p>
      </div>
      {/* The sticky note restated the paragraph beside it in slogan form and
          was not supplied. */}
    </section>

    <section class="band shell">
      <div class="sec-head">
        <h2 class="sec-h"><span class="u">What we explore here<Mark kind="underline" color="green" /></span></h2>
      </div>
      <div class="shortcuts abt-areas">
        {areas.map((a) => (
          <a class="short" href={a.href}>
            <CategoryIcon kind={a.kind} />
            <h3>{a.t}</h3>
            <p>{a.d}</p>
            <span class="arw" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <section class="shell">
      <div class="panel panel-light abt-sign">
        <Mark kind="zigzag" color="yellow" class="panel-zig panel-zig-r" />
        <h2 class="panel-h"><span class="u">Kingdom theology. Ordinary life.<Mark kind="underline" color="blue" /></span></h2>
        <p class="panel-dek">That's the heartbeat of everything I write. Thanks for being here.</p>
        <p class="abt-name">Denvil</p>
      </div>
    </section>
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}
</Shell>
