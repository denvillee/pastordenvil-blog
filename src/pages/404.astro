---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import labels from '../data/labels.json';
---
<Base title={`Not here — ${site.name}`} description="That page does not exist." noindex={true}>
  <section class="shell err">
    <div>
      <h1>{labels.notFoundHeading}</h1>
      <p class="art-dek" style="margin-inline:auto" set:html={labels.notFoundBody}></p>
    </div>
  </section>
</Base>
