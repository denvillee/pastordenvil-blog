---
/*
  Kept deliberately simple. The old page said the same thing about what arrives
  and how often in three different places; it says it once now, in Denvil's own
  words, and no cadence is promised anywhere.
*/
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import StickyNote from '../../components/marks/StickyNote.astro';
import DotGrid from '../../components/marks/DotGrid.astro';
import ArtPlate from '../../components/ArtPlate.astro';
import Tape from '../../components/marks/Tape.astro';
import site from '../../data/site.json';
import { KIT_ACTION } from '../../lib/signup';
---
<Shell title={`Subscribe · ${site.name}`}
       description="New essays, reflections and studies, straight to your inbox.">
  <section class="band shell sub-page">
    <div>
      <h1 class="page-h is-display">Good news in your <span class="u">inbox<span class="dot">.</span><Mark kind="underline" color="blue" draw={true} /></span></h1>
      <p class="page-dek">{site.signupCopy}</p>

      <form class="form sub-form" method="post" action={KIT_ACTION}>
        <label class="sr-only" for="email">Email address</label>
        <input class="fake" id="email" name="email_address" type="email" required
               placeholder="you@example.com" autocomplete="email" />
        <input type="hidden" name="fields[source]" value="/subscribe/" />
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
        <button class="btn btn-blue" type="submit">{site.signupButton}</button>
      </form>
      <p class="sub-print">{site.signupSmallPrint}</p>
    </div>
    {/* "Good news for ordinary people." is gone: it competed with the real
        brand line and was never supplied. */}
    <div class="sub-art">
      <DotGrid cols={7} rows={5} class="sub-dots" />
      <ArtPlate kind="letter" class="artp-hero" />
    </div>
  </section>
</Shell>
