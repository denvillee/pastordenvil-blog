---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
---
<Base title={`You are in — ${site.name}`} description="Confirm your email." noindex={true}>
  <section class="band shell err">
    <div>
      <h1 style="font-size:clamp(2rem,7vw,4rem)">You are in</h1>
      <p class="art-dek" style="margin-inline:auto">
        Check your inbox and confirm your email. If it is not there in a few minutes, look in
        promotions.
      </p>
      <p><a class="btn btn-primary" href="/">Back home</a></p>
    </div>
  </section>
</Base>
