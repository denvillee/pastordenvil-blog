---
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
---
<Base title="Subscribe" description="The Monday Note — one idea a week, named plainly.">
  <section class="ph">
    <div class="wrap wrap--read">
      <p class="label">The Monday Note</p>
      <h1 class="ph__h">One idea a week, named plainly.</h1>
      <div class="prose ph__body">
        <p>
          Every Monday I name the one idea the week is built on, and then say
          where it went — the essay, the two devotionals, the note for leaders,
          the clips. About five hundred words. It takes two minutes.
        </p>
        <p>
          I am not going to email you daily, I am not going to sell your address,
          and there is no funnel behind this. If it stops being worth two minutes,
          unsubscribe and no hard feelings.
        </p>
      </div>
      <ul class="what">
        <li><strong>Weekly</strong> — Monday morning, Eastern.</li>
        <li><strong>Free</strong> — all of it, permanently.</li>
        <li><strong>Portable</strong> — hosted on Kit, and the list is mine, not a platform's.</li>
      </ul>
    </div>
  </section>
  <Signup tone="brass" cta="Send it to me" />
  <section class="band band--sunk">
    <div class="wrap wrap--read">
      <h2 class="alt__h">Also: the Mark reading plan</h2>
      <p class="alt__d">
        In January the whole list reads the Gospel of Mark together over
        seventy-one days, delivered by email. If that is what you actually came
        for, sign up on <a href="/mark/">the reading plan page</a> instead and I
        will put you on that track.
      </p>
    </div>
  </section>
</Base>
<style>
  .ph { padding-block: clamp(2.8rem, 2.2rem + 3vw, 5rem); }
  .ph__h { font-size: var(--step-4); margin-top: 1rem; }
  .ph__body { margin-top: 1.6rem; }
  .what { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 0.6rem; }
  .what li { font-size: var(--step--1); color: var(--fg-muted); padding-left: 1.1rem; position: relative; }
  .what li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .alt__h { font-size: var(--step-2); }
  .alt__d { margin-top: 0.9rem; font-family: var(--font-warm); font-size: var(--step-1); line-height: 1.65; color: var(--fg-muted); }
  .alt__d a { color: var(--accent); }
</style>
