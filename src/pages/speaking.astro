---
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import site from '../data/site.json';
import Photo from '../components/Photo.astro';
import labels from '../data/labels.json';
const entry = await getEntry('pages', 'speaking');
const { Content } = await render(entry!);
/* Netlify Forms. data-netlify="true" registers the form at build time.
   Submissions land in Netlify and forward to hello@denvillee.com
   (Cloudflare Email Routing, hosting runbook §5). */
---
<Shell current="speaking" title={`${entry!.data.title} · ${site.name}`} description={entry!.data.dek}>
  <section class="band shell">
    <div class="sec-head">
      <h1 class="page-h is-display">Speaking + Coaching<span class="dot">.</span></h1>
      {/* The "availability" chip is gone with the cohort: it implied a
          schedule Denvil never supplied. */}
    </div>
    <div class="speak">
      <div class="speak-copy prose">
        {/* Him actually teaching in a room, which is what this page is asking
            people to book. Landscape rather than portrait so it sits shorter
            than the copy beside it instead of towering over it. */}
        <Photo name="dl-speaking" width={1200} height={900} class="speak-art"
               sizes="(max-width: 860px) 92vw, 42vw"
               alt="Denvil Lee teaching from a stage, the room and the screens behind him." />
        <Content />
      </div>
      <form class="speak-form" name="speaking" method="POST" data-netlify="true" netlify-honeypot="company" action="/speaking/thanks/">
        <input type="hidden" name="form-name" value="speaking" />
        {/* Netlify's honeypot. It was a labelled field reading "Leave this
            empty", hidden only by moving it off-screen, so a screen reader
            announced it as a real question and a keyboard user could tab into
            it. Taken out of the accessibility tree and the tab order instead;
            Netlify still checks the same field name. */}
        <input type="text" name="company" tabindex="-1" autocomplete="off"
               aria-hidden="true" class="hp" />
        <label>Your name<input type="text" name="name" required autocomplete="name" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
        <label>Church or organization<input type="text" name="organization" /></label>
        <label>Date or window<input type="text" name="eventDate" placeholder="Second weekend in March" /></label>
        <label>What kind of event
          <select name="eventType">
            <option>Weekend teaching</option>
            <option>Conference or retreat</option>
            <option>Staff or leadership intensive</option>
            <option>Coaching</option>
            <option>Something else</option>
          </select>
        </label>
        <label>What are you hoping for?<textarea name="message" rows="5" required></textarea></label>
        <button class="btn btn-primary" type="submit">Send it</button>
      </form>
    </div>
  </section>
</Shell>
