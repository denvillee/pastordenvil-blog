---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureEssay from '../components/FeatureEssay.astro';
import Streams from '../components/Streams.astro';
import StudiesCard from '../components/StudiesCard.astro';
import ReadingShelf from '../components/ReadingShelf.astro';
import Signup from '../components/Signup.astro';
import DesignNotes from '../components/DesignNotes.astro';
import { live, readMinutes, ROOMS } from '../lib/publish';
import home from '../data/home.json';
import site from '../data/site.json';
import labels from '../data/labels.json';

const essays = await live('essays');
const leaders = await live('leaders');
const moments = await live('moments');
const books = await live('reading');

const feature = essays[0];

/* The sticker on the feature used to be the fixed string "This week", bolted to
   the newest essay no matter how old it was — miss a week and the home page
   confidently labelled three-week-old writing as this week's. It now tells the
   truth: "This week" only while the piece really is from the last seven days,
   then it steps down gracefully instead of lying. Every string stays editable. */
const DAY = 86_400_000;
const featureAgeDays = feature
  ? Math.floor((Date.now() - feature.data.publishAt.getTime()) / DAY)
  : 0;
const featureLabel =
  featureAgeDays <= 7  ? home.featureLabel :
  featureAgeDays <= 21 ? home.featureLabelRecent :
                         home.featureLabelOlder;

const streamItems = [
  essays[0] && { room: labels.homeStreamEssayTag, cls: 's1', href: `/essays/${essays[0].id}/`,
    title: essays[0].data.title, dek: essays[0].data.dek, foot: home.essayCadence },
  leaders[0] && { room: labels.homeStreamLeadersTag, cls: 's2', href: `/leaders/${leaders[0].id}/`,
    title: leaders[0].data.title, dek: leaders[0].data.dek, foot: home.leadersCadence },
  moments[0] && { room: labels.homeStreamMomentsTag, cls: 's3', href: `/moments/${moments[0].id}/`,
    title: moments[0].data.title, dek: moments[0].data.dek, foot: home.momentsCadence },
].filter(Boolean) as any[];

const now = books.find((b: any) => b.data.shelfStatus === 'now')?.data;
const shelf = books.filter((b: any) => b.data.shelfStatus !== 'now')
  .sort((a: any, b: any) => a.data.order - b.data.order)
  .map((b: any) => ({ ...b.data, note: b.body?.trim() || '' }));


---
<Base
  title={`${site.name} — ${site.tagline}`}
  description={site.metaDescription}
>
  <Hero />

  {feature && (
    <FeatureEssay
      href={`/essays/${feature.id}/`}
      title={feature.data.title}
      dek={feature.data.dek}
      scripture={feature.data.scripture}
      readMinutes={readMinutes(feature.body)}
      label={featureLabel}
    />
  )}

  {streamItems.length > 0 && <Streams items={streamItems} />}

  <StudiesCard />

  <ReadingShelf now={now ? { ...now, note: books.find((b: any) => b.data.shelfStatus === 'now')?.body?.trim() ?? '' } : undefined} shelf={shelf} tie={home.readingTie} />

  <Signup />
  {labels.showDesignNotes && <DesignNotes />}
</Base>
