---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LatestCard from '../components/LatestCard.astro';
import Streams from '../components/Streams.astro';
import StudiesCard from '../components/StudiesCard.astro';
import NowReading from '../components/NowReading.astro';
import Signup from '../components/Signup.astro';
import DesignNotes from '../components/DesignNotes.astro';
import { live, latest, readMinutes } from '../lib/publish';
import home from '../data/home.json';
import site from '../data/site.json';
import labels from '../data/labels.json';

const books = await live('reading');

/* The newest thing across the three streams, whatever kind it is. Bookshelf and
   Studies are states, not streams, and sit in their own bands below. */
const feature = await latest();

/* The sticker used to be the fixed string "This week", bolted to the newest
   essay no matter how old it was: miss a week and the home page confidently
   labelled three-week-old writing as this week's. It now tells the truth, and
   steps down gracefully instead of lying. Every string stays editable. */
const DAY = 86_400_000;
const featureAgeDays = feature
  ? Math.floor((Date.now() - feature.data.publishAt.getTime()) / DAY)
  : 0;
const featureLabel =
  featureAgeDays <= 7  ? home.featureLabel :
  featureAgeDays <= 21 ? home.featureLabelRecent :
                         home.featureLabelOlder;

/* A reading time is only meaningful for something long enough to have one. A
   ninety-word note with a photograph should not claim "1 min". */
const featureMinutes = feature && feature.body.trim().split(/\s+/).filter(Boolean).length >= 150
  ? readMinutes(feature.body)
  : undefined;

const now = books.find((b: any) => b.data.shelfStatus === 'now')?.data;


---
<Base
  title={`${site.name} · ${site.tagline}`}
  description={site.metaDescription}
>
  <Hero />

  {feature && (
    <LatestCard
      room={feature.room}
      href={feature.href}
      title={feature.data.title}
      dek={feature.data.dek}
      scripture={feature.data.scripture}
      readMinutes={featureMinutes}
      image={feature.data.image}
      imageAlt={feature.data.imageAlt}
      label={featureLabel}
    />
  )}

  <Streams />

  <StudiesCard />

  <NowReading book={now ? { ...now, note: books.find((b: any) => b.data.shelfStatus === 'now')?.body?.trim() ?? '' } : undefined} />

  <Signup />
  {labels.showDesignNotes && <DesignNotes />}
</Base>
