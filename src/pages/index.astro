---
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import DotGrid from '../components/marks/DotGrid.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import ImageMask from '../components/ImageMask.astro';
import Placeholder from '../components/Placeholder.astro';
import Photo from '../components/Photo.astro';
import { latest, openingParagraph, readMinutes, displayDate, isoDate, ROOMS } from '../lib/publish';
import { isStandin } from '../lib/media';
import site from '../data/site.json';
import home from '../data/home.json';
import labels from '../data/labels.json';

const feature = await latest();
const featureRoom = feature ? ROOMS[feature.room] : null;
const featureMinutes = feature && feature.body.trim().split(/\s+/).filter(Boolean).length >= 150
  ? readMinutes(feature.body) : undefined;

const shortcuts = [
  { kind: 'leaders', href: '/leaders/',   label: labels.navLeaders,
    dek: 'Reflections for leading with wisdom, humility, and courage.' },
  { kind: 'moments', href: '/moments/',   label: labels.navMoments,
    dek: 'Short thoughts for the everyday moments that shape us.' },
  { kind: 'studies', href: '/studies/',   label: labels.navStudies,
    dek: 'Resources for going deeper, individually or in community.' },
  { kind: 'reading', href: '/bookshelf/', label: labels.navReading,
    dek: 'Books that are shaping the way I think, lead, and live.' },
] as const;
---
<Shell title={`${site.name} · ${site.tagline}`} description={site.metaDescription}>

  {/* ── hero ─────────────────────────────────────────────────────────── */}
  <section class="hero">
    <Mark kind="brush" color="coral" class="hero-brush" />
    <div class="shell hero-in">
      <div class="hero-copy">
        <h1 class="hero-h is-display">
          <span class="u">Good news<Mark kind="underline" color="blue" draw={true} /></span>
          <span class="hero-br">for&#32;<span class="c">ordinary<Mark kind="circle" color="yellow" draw={true} /></span></span>
          <span class="hero-br">life<span class="dot">.</span></span>
        </h1>
        <p class="hero-dek">
          Applied theology for ordinary life, from the tension of the kingdom
          <span class="u">already here<Mark kind="underline" color="green" /></span>&#32;and&#32;<span class="u">still coming<Mark kind="underline" color="green" /></span>.
        </p>
        <p class="hero-acts">
          {feature && (
            <a class="btn btn-blue" href={`/${featureRoom!.path}/${feature.id}/`}>
              Read the latest essay <span class="arw" aria-hidden="true">&rarr;</span>
            </a>
          )}
          <a class="go hero-go" href="/studies/">Start a study <span class="arw" aria-hidden="true">&rarr;</span></a>
        </p>
      </div>

      <div class="hero-art">
        <DotGrid cols={7} rows={5} class="hero-dots" />
        <ImageMask shape="organic">
          <Photo name="dl-hero" width={1400} height={1050} eager={true}
                 sizes="(max-width: 900px) 92vw, 46vw"
                 alt="Denvil Lee speaking at a lectern, one hand resting on his chest." />
        </ImageMask>
        <ColorDisc lines={["theology","leadership","life"]} class="hero-disc" />
      </div>
    </div>
  </section>

  {/* ── latest ───────────────────────────────────────────────────────── */}
  <section class="band shell sec-latest">
    <div class="sec-head">
      <h2 class="sec-h"><span class="u">Latest from the blog<Mark kind="underline" color="yellow" draw={true} /></span></h2>
      <a class="go" href="/essays/">See all essays <span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>

    <div class="latest-deck">
      {feature ? (
        <article class="feat">
          <a class="feat-art" href={`/${featureRoom!.path}/${feature.id}/`} tabindex="-1" aria-hidden="true">
            <ImageMask shape="soft">
              {feature.data.image && !isStandin(feature.data.image)
                ? <img src={feature.data.image} alt="" width="960" height="640" loading="lazy" decoding="async" />
                : <Placeholder label={`Image for ${feature.data.title}`} ratio="3 / 2" />}
            </ImageMask>
            <span class="chip chip-yellow">{featureRoom!.label}</span>
          </a>
          <div class="feat-body">
            <h3 class="feat-h"><a href={`/${featureRoom!.path}/${feature.id}/`}>{feature.data.title}</a></h3>
            <p class="feat-dek">{feature.data.dek}</p>
            <p class="feat-open">{openingParagraph(feature.body, 190)}</p>
            <p class="feat-meta">
              <time datetime={isoDate(feature.data.publishAt)}>{displayDate(feature.data.publishAt)}</time>
              {featureMinutes && <> &middot; {featureMinutes} min read</>}
            </p>
            <a class="go" href={`/${featureRoom!.path}/${feature.id}/`}>Read now <span class="arw" aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      ) : (
        <p class="empty-note">{labels.essaysEmpty}</p>
      )}

      <div class="shortcuts">
        {shortcuts.map((s) => (
          <a class="short" href={s.href}>
            <CategoryIcon kind={s.kind} />
            <h3>{s.label}</h3>
            <p>{s.dek}</p>
            <span class="arw" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── the two panels ───────────────────────────────────────────────── */}
  <section class="band shell panels">
    <div class="panel panel-dark">
      <Mark kind="zigzag" color="blue" class="panel-zig" />
      <h2 class="panel-h"><span class="u">{home.studiesHeading}<Mark kind="underline" color="blue" /></span></h2>
      <p class="panel-dek">A study through the book of Ruth.</p>
      <a class="btn btn-light" href="https://grabyourbibles.com/study/in-every-season/" rel="noopener">
        {home.studiesCta} <span class="arw" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="panel panel-light">
      <Mark kind="zigzag" color="yellow" class="panel-zig panel-zig-r" />
      <h2 class="panel-h"><span class="u">New here?<Mark kind="underline" color="green" /></span></h2>
      <p class="panel-dek">Here's why this site exists, what you'll find here, and how to connect.</p>
      <StickyNote tone="paper" tilt={-1.8} class="panel-note">
        Because good news should be for ordinary life.
      </StickyNote>
      <a class="go" href="/about/">Take a look <span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

</Shell>
