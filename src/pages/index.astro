---
/*
  The home page, round 9.

  Order and grounds: hero on pine, Latest on paper, the three rooms as colour
  blocks, the shelf on paper, Studies on pine, Everything on paper, Subscribe on
  brass. Every block opens with an eyebrow and a hairline, which is what keeps
  one section from running into the next.

  A visitor should meet a piece once, properly. Everything else is a door.
*/
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LatestBlock from '../components/LatestBlock.astro';
import Streams from '../components/Streams.astro';
import StudiesCard from '../components/StudiesCard.astro';
import NowReading from '../components/NowReading.astro';
import EverythingPill from '../components/EverythingPill.astro';
import Signup from '../components/Signup.astro';
import DesignNotes from '../components/DesignNotes.astro';
import { live, latest, readMinutes, openingParagraph, displayDate, ROOMS } from '../lib/publish';
import site from '../data/site.json';
import labels from '../data/labels.json';

const books = await live('reading');
const feature = await latest();

/* Reading time is only meaningful for something long enough to have one; a
   short note with a picture should not claim "1 min". */
const featureMinutes = feature && feature.body.trim().split(/\s+/).filter(Boolean).length >= 150
  ? readMinutes(feature.body)
  : undefined;

/* One sticker per page, and its words have to be true of the build today. A
   piece published in the last fortnight earns "New ...", and when nothing is
   that fresh the study is still seven sessions, so the fallback is true too. */
const DAY = 86_400_000;
const freshDays = feature ? (Date.now() - feature.data.publishAt.getTime()) / DAY : Infinity;
const NEW_LABEL: Record<string, string> = {
  essays: 'New essay', moments: 'New moment', leaders: 'New lesson',
};
const sticker = freshDays <= 14 ? NEW_LABEL[feature!.room] : labels.studySticker;

const now = books.find((b: any) => b.data.shelfStatus === 'now');
const nowBook = now ? { ...now.data, note: now.body?.trim() || '' } : undefined;
const shelf = books
  .filter((b: any) => b !== now && b.data.shelfStatus !== 'next')
  .sort((a: any, b: any) => a.data.order - b.data.order)
  .map((b: any) => ({ ...b.data, note: b.body?.trim() || '' }));

/* The count on the Everything door comes from the archive itself. */
const totalPieces = (await Promise.all(
  (Object.keys(ROOMS) as (keyof typeof ROOMS)[]).map((k) => live(k))
)).reduce((n, list) => n + list.length, 0);
---
<Base
  title={`${site.name} · ${site.tagline}`}
  description={site.metaDescription}
  masthead={true}
>
  <Hero sticker={sticker} />

  {feature && (
    <LatestBlock
      room={feature.room}
      href={feature.href}
      title={feature.data.title}
      opening={openingParagraph(feature.body)}
      dateLabel={displayDate(feature.data.publishAt)}
      scripture={feature.data.scripture}
      readMinutes={featureMinutes}
      linkLabel={labels.latestMore}
    />
  )}

  <Streams />

  <NowReading book={nowBook} shelf={shelf} />

  <StudiesCard />

  <EverythingPill total={totalPieces} label={labels.archiveLink} />

  <Signup />
  {labels.showDesignNotes && <DesignNotes />}
</Base>
