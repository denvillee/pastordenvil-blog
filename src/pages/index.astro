---
import Shell from '../layouts/Shell.astro';
import Mark from '../components/marks/Mark.astro';
import DotGrid from '../components/marks/DotGrid.astro';
import ColorDisc from '../components/marks/ColorDisc.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import HandGlyph from '../components/HandGlyph.astro';
import ImageMask from '../components/ImageMask.astro';
import Placeholder from '../components/Placeholder.astro';
import ArtPlate from '../components/ArtPlate.astro';
import Photo from '../components/Photo.astro';
import Tape from '../components/marks/Tape.astro';
import { live, latest, openingParagraph, readMinutes, displayDate, isoDate, ROOMS, nextInSeries } from '../lib/publish';
import { isStandin } from '../lib/media';
import site from '../data/site.json';
import home from '../data/home.json';
import labels from '../data/labels.json';

const feature = await latest();
/* The three newest live essays, excluding whatever is already in the featured
   slot above so the page never shows the same piece twice. */
const recentEssays = (await live('essays'))
  .filter((e: any) => e.id !== feature?.id)
  .slice(0, 3);
const featureRoom = feature ? ROOMS[feature.room] : null;
/* The launch module from Denvil's 30 Aug package: the featured essay carries a
   small series label under it, and once the following essay is live it is
   surfaced as the next essay rather than the two reading as halves of one
   chapter. Both lines disappear on their own when the piece is not part of a
   run, or when nothing follows it yet. */
const featureSeries = feature?.data.series as string | undefined;
const featureNext = feature && feature.room === 'essays'
  ? await nextInSeries('essays', featureSeries, feature.data.seriesOrder)
  : null;
const featureMinutes = feature && feature.body.trim().split(/\s+/).filter(Boolean).length >= 150
  ? readMinutes(feature.body) : undefined;

/* The five primary content sections, with Denvil's own captions. Each caption
   is a doorway rather than a description: the words are his, verbatim from the
   29 Aug revision packet, and they are the same sentences that open each
   section's own page. */
/* The six main areas, in the order Denvil's layout map sets them, with his own
   captions. Watch joins the row: the map asks for six pathways and Watch was the
   one room the old five-item list left out, even though it is in the masthead.
   Each caption is a doorway rather than a description, and they are the same
   sentences that open each section's own page. */
const shortcuts = [
  { kind: 'essays',    href: '/essays/',    label: labels.essaysHeading,
    dek: 'Ideas and reflections on faith, life, and the kingdom of God.' },
  { kind: 'leaders',   href: '/leaders/',   label: labels.leadersHeading,
    dek: 'Practical wisdom for pastors and everyday leaders.' },
  { kind: 'moments',   href: '/moments/',   label: labels.momentsHeading,
    dek: 'Short thoughts to encourage you in the in-between.' },
  { kind: 'studies',   href: '/studies/',   label: labels.studiesHeading,
    dek: 'Guides to help you go deeper with Scripture.' },
  { kind: 'bookshelf', href: '/bookshelf/', label: labels.readingHeading,
    dek: 'Books that have shaped my thinking and ministry.' },
  { kind: 'watch',     href: '/watch/',     label: labels.watchHeading,
    dek: 'Messages and conversations to watch and share.' },
] as const;
---
{/* Denvil supplied this title exactly, with a pipe. */}
<Shell title={`${site.name} | ${site.tagline}`} description={site.metaDescription}>

  {/* ── hero ─────────────────────────────────────────────────────────── */}
  <section class="hero">
    <Mark kind="brush" color="coral" class="hero-brush" />
    {/* The map's marginalia: a small blue star at the top corner and a green
        coil beside the introduction. They are the difference between a layout
        and a page somebody drew. */}
    <Mark kind="star" color="blue" class="hero-star" />
    <Mark kind="spiral" color="green" class="hero-coil" />
    <div class="shell hero-in">
      <div class="hero-copy">
        <h1 class="hero-h is-display">
          <span class="u">Good news<Mark kind="underline" color="blue" draw={true} /></span>
          <span class="hero-br">for&#32;<span class="c">ordinary<Mark kind="circle" color="yellow" draw={true} /></span></span>
          <span class="hero-br">life<span class="dot">.</span></span>
        </h1>
        {/* Denvil's own introduction, 29 Aug. It comes before the conviction
            line on purpose: the site should read as a person inviting you to
            think with him, not as a ministry brand announcing itself. */}
        <p class="hero-dek">
          I'm Denvil, a&#32;<span class="u">pastor and teacher<Mark kind="underline" color="yellow" /></span> trying to help
          people see what the good news of God's kingdom means for real life.
        </p>
        {/* No buttons. Denvil's layout map: "Big introduction. Clear who I am.
            No buttons. Strong visual energy." The hero states who he is; the
            six pathways below are where a reader chooses. A pair of calls to
            action here asks for a decision before the page has earned one. */}
      </div>

      <div class="hero-art">
        <DotGrid cols={7} rows={5} class="hero-dots" />
        <ImageMask shape="organic" tape="blue" tapeAt="tr">
          {/* The strongest teaching frame he has sent leads the site. The
              source is portrait and the slot is 4:3, so the crop closes in on
              him rather than on an empty stage. */}
          <Photo name="dl-hero-v2" width={1400} height={1050} eager={true}
                 sizes="(max-width: 900px) 92vw, 46vw"
                 alt="Denvil Lee teaching on stage in a coral polo, both hands reaching out as he makes a point." />
        </ImageMask>
        <ColorDisc lines={["theology","leadership","life"]} class="hero-disc" />
        {/* The arrow the map draws under the photo, running into the disc. */}
        <Mark kind="arrow" color="ink" class="hero-curl" />
      </div>
    </div>
  </section>

  {/* ── latest ───────────────────────────────────────────────────────────
      The map gives this its own tinted band, photo taped down on the left and
      the copy beside it, under a small green label rather than a headline. It
      is the one band on the page that changes every time he publishes, and
      the tint is what says so without a word.

      This goes back to side by side. It was stacked on 1 Sep because it was
      sharing its row with the pathways and the photo was landing wrong in a
      narrow column. The pathways have their own band now, so the photo has
      the room the map draws it in. */}
  {feature && (
    <section class="latestband">
      <div class="shell lb-in">
        <a class="lb-art" href={`/${featureRoom!.path}/${feature.id}/`} tabindex="-1" aria-hidden="true">
          <Tape color="green" class="lb-tape" />
          <ImageMask shape="soft">
            {feature.data.image && !isStandin(feature.data.image)
              ? <img src={feature.data.image} alt="" width="960" height="720" loading="lazy" decoding="async" />
              : feature.room === 'moments'
                ? <span class="lb-plate"><ArtPlate kind="morning" /></span>
                : <Placeholder label={`Image for ${feature.data.title}`} ratio="4 / 3" />}
          </ImageMask>
        </a>

        <div class="lb-body">
          <p class="lb-k">Latest {featureRoom!.piece}</p>
          <h2 class="lb-h"><a href={`/${featureRoom!.path}/${feature.id}/`}>{feature.data.title}</a></h2>
          {/* Moments carry no teaser, so the band falls back to the opening
              line rather than leaving a gap where the sentence should be. */}
          <p class="lb-d">{feature.data.teaser || feature.data.dek || openingParagraph(feature.body, 165)}</p>
          <p class="lb-meta">
            <time datetime={isoDate(feature.data.publishAt)}>{displayDate(feature.data.publishAt)}</time>
            {featureMinutes && <> &middot; {featureMinutes} min read</>}
          </p>
          <a class="lb-go" href={`/${featureRoom!.path}/${feature.id}/`}>
            <span class="u">Read the {featureRoom!.piece}<Mark kind="underline" color="yellow" draw={true} /></span>
            <span class="arw" aria-hidden="true">&rarr;</span>
          </a>

          {featureSeries && (
            <p class="lb-ser">
              Part of <a href="/essays/#ser-h">{featureSeries}</a>
              {featureNext && (<>{' '}&middot; Next: <a href={featureNext.href}>{featureNext.title}</a></>)}
            </p>
          )}
        </div>
      </div>
      <DotGrid cols={9} rows={6} class="lb-dots" />
    </section>
  )}

  {/* ── the six pathways ───────────────────────────────────────
      Denvil's map puts the six main areas in their own full width band, drawn
      "Big, visual, colorful", not tucked beside something else. So they get
      the whole measure and a row of their own rather than a column next to
      the featured piece. */}
  <section class="shell paths" aria-label="Explore">
    <div class="shortcuts">
      {shortcuts.map((s) => (
        <a class="short" href={s.href}>
          <HandGlyph name={s.kind} />
          <h3>{s.label}</h3>
          <p>{s.dek}</p>
          <span class="arw" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  {/* ── Grab your Bibles, the signature banner ───────────────────────────
      Denvil's map: "Signature section. Encouragement. Visual punch." Black
      ground, the blue scribble at the left, a yellow splash behind the study's
      cover, a heart, and the dots. This is the one full-bleed dark band on the
      page and it is doing the punching, which is why the panels that used to
      sit here have gone: two grey boxes side by side were not punching. */}
  <section class="shell gyb-wrap">
    <div class="gyb">
      <Mark kind="spiral" color="blue" class="gyb-coil" />
      {/* Heading, sentence and button are three siblings rather than two
          groups, so the band can place them by grid area: heading over button
          on the left with the sentence beside them on a wide screen, and
          heading, sentence, button in that order once it stacks. Grouped the
          other way, the phone got the button before the sentence explaining
          what it was for. */}
      <h2 class="gyb-h"><span class="u">{home.studiesHeading}<Mark kind="underline" color="blue" /></span></h2>
      <p class="gyb-dek">
        The book of Ruth is a story of grace, loyalty, and God's faithfulness in
        unexpected places.
      </p>
      <a class="btn btn-light gyb-cta" href="https://grabyourbibles.com/quietly-at-work/" rel="noopener">
        Start reading Ruth <span class="arw" aria-hidden="true">&rarr;</span>
      </a>
      <div class="gyb-art">
        <span class="gyb-splash" aria-hidden="true"></span>
        <Photo name="ruth-cover" width={520} height={720}
               sizes="(max-width: 900px) 40vw, 16rem"
               alt="The cover of the Quietly at Work study in the book of Ruth." />
        <span class="gyb-heart" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 20S3 15 3 9a4.5 4.5 0 0 1 9-1.7A4.5 4.5 0 0 1 21 9c0 6-9 11-9 11z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg>
        </span>
      </div>
      {/* The spray of white specks the map throws off the bottom of the
          splash. Hand placed rather than gridded: a grid of dots is a
          pattern, and this is meant to read as something that scattered. */}
      <svg class="gyb-speck" viewBox="0 0 120 64" fill="none" aria-hidden="true">
        {[[6,44],[15,30],[19,50],[27,38],[31,17],[34,56],[41,29],[45,45],[52,12],[54,35],
          [60,52],[63,24],[70,41],[74,9],[78,57],[84,31],[88,47],[95,19],[99,38],[104,54],
          [110,27],[114,44]].map(([x,y], i) => (
          <circle cx={x} cy={y} r={i % 3 === 0 ? 2.4 : i % 3 === 1 ? 1.7 : 1.2} fill="currentColor" />
        ))}
      </svg>
    </div>
  </section>

  {/* ── Recent essays ────────────────────────────────────────────────────
      "3 latest essays. Quick scan. Easy to dive in." The featured slot above
      can hold any room, so this row is the one place on the page that is
      always essays. */}
  {recentEssays.length > 0 && (
    <section class="shell recents">
      <div class="sec-head">
        <h2 class="recents-k">Recent essays</h2>
        <a class="go" href="/essays/">
          <span class="u">View all essays<Mark kind="underline" color="yellow" /></span>
          <span class="arw" aria-hidden="true">&rarr;</span>
        </a>
      </div>
      <div class="recent-grid">
        {recentEssays.map((e: any) => (
          <a class="recent" href={`/essays/${e.id}/`}>
            <span class="recent-art">
              {e.data.image && !isStandin(e.data.image)
                ? <img src={e.data.image} alt="" width="640" height="480" loading="lazy" decoding="async" />
                : <ArtPlate kind="passage" />}
            </span>
            <span class="recent-body">
              <span class="recent-h">{e.data.title}</span>
              <span class="recent-d">{e.data.teaser ?? e.data.dek}</span>
              <span class="go">Read essay <span class="arw" aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* ── Stay connected ───────────────────────────────────────────────────
      "Simple invite. Human, warm. Not salesy." So the invitation is in his
      handwriting rather than in a headline, and the form is one field. */}
  <section class="shell sub-wrap">
    <div class="subband">
      <Tape color="green" class="sub-tape" />
      <div class="sub-copy">
        <p class="sub-hand">
          Thanks for reading.
          <span class="sub-heart" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 20S3 15 3 9a4.5 4.5 0 0 1 9-1.7A4.5 4.5 0 0 1 21 9c0 6-9 11-9 11z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          </span>
        </p>
        <p class="sub-hand sub-hand-y">You&#8217;re not alone.</p>
      </div>
      <div class="sub-form">
        <p class="sub-dek">Get new essays, moments, and resources in your inbox.</p>
        <form name="subscribe-home" method="POST" data-netlify="true" action="/subscribe/thanks/" class="sub-row">
          <input type="hidden" name="form-name" value="subscribe-home" />
          <label class="vh" for="sub-email">Your email</label>
          <input id="sub-email" type="email" name="email" required placeholder="Your email" autocomplete="email" />
          <button type="submit" class="btn btn-gold">Subscribe <span class="arw" aria-hidden="true">&rarr;</span></button>
        </form>
      </div>
      <DotGrid cols={7} rows={4} class="subband-dots" />
      <span class="sub-env" aria-hidden="true">
        <svg viewBox="0 0 90 64" fill="none">
          <path d="M6 12h78v46H6z" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
          <path d="M6 14l39 27 39-27" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M78 4l5-3M86 12l5-1M74 2l1-4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
        </svg>
      </span>
    </div>
  </section>

</Shell>
