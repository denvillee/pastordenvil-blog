---
/*
  Template A, the archive. Essays is the fullest version of it; For Leaders and
  Moments use the same structure with their own personality.

  Two controls from the reference are deliberately absent until the archive has
  the volume to justify them: a sort dropdown and a "load more" button. With
  three published pieces both would be controls that do nothing, and a control
  that does nothing is worse than no control.
*/
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import DotGrid from '../../components/marks/DotGrid.astro';
import ArtPlate from '../../components/ArtPlate.astro';
import StickyNote from '../../components/marks/StickyNote.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import EssayCard from '../../components/EssayCard.astro';
import SeriesBlock from '../../components/SeriesBlock.astro';
import Doorway from '../../components/Doorway.astro';
import { live, introPost, currentSeries } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';

const entries = await live('essays');
const intro = await introPost('essays');
/* The introduction opens the page rather than sitting in a card beside it:
   Denvil's revision packet asks each section to open with a doorway in his
   own voice. It is still the same real, linkable, CMS-editable post. */
const { Content: IntroBody } = intro ? await render(intro) : { Content: null };
const series = await currentSeries('essays');

const [featured, ...rest] = entries;
---
<Shell title={`${labels.essaysHeading} · ${site.name}`} description={labels.essaysDek} current="essays">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell arch-head">
      <div>
        <h1 class="page-h is-display">{labels.essaysHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          What there&#32;<span class="u">wasn't time to say<Mark kind="underline" color="yellow" /></span>&#32;on Sunday.
        </p>
      </div>
      {/* The right of this row was a field of dots and nothing else. */}
      <div class="head-art">
        <DotGrid cols={7} rows={4} class="head-dots" />
        <ArtPlate kind="passage" class="artp-band" />
      </div>
    </section>

    {IntroBody && (
      <Doorway tone="yellow" collapsed={entries.length > 0}>
        <IntroBody />
        <StickyNote slot="rail" tone="green" tilt={-1.6} tape={false} class="side-note">
          The kingdom is already here, and still coming. Most of what I write
          lives somewhere in that tension.
        </StickyNote>
      </Doorway>
    )}

    <div class="shell arch-deck">
      <div class="arch-main">
        {featured && (
          <FeaturedEssay href={`/essays/${featured.id}/`} entry={featured}
                         room={labels.essaysHeading} />
        )}

        {series && series.parts.length > 1 && (
          <SeriesBlock name={series.name} dek={series.dek} parts={series.parts} />
        )}

        {rest.length > 0 && (
          <>
            <div class="sec-head arch-sub">
              <h2 class="sec-h">All essays</h2>
              <span class="count">{entries.length} {entries.length === 1 ? 'essay' : 'essays'}</span>
            </div>
            <div class="ecards">
              {rest.map((e: any) => (
                <EssayCard href={`/essays/${e.id}/`} entry={e} room={labels.essaysHeading} />
              ))}
            </div>
          </>
        )}

        {/* No empty state. If nothing is published the doorway carries the
            page on its own. */}
      </div>

      <aside class="arch-side" aria-label="More on this site">
        {/* Explore by topic is hidden until a topic has enough pieces to be
            worth exploring. Two of the four led to a page with one essay on
            it, which exposes the content system rather than the content. Tags
            stay in the model and on the article. */}

        <StickyNote tone="green" tilt={-1.6} tape={false} class="side-note">
          The kingdom is already here, and still coming. Most of what I write
          lives somewhere in that tension.
        </StickyNote>
      </aside>
    </div>

    <section class="shell">
      <div class="panel panel-dark panel-wide">
        <Mark kind="zigzag" color="blue" class="panel-zig" />
        <h2 class="panel-h"><span class="u">Grab your Bibles.<Mark kind="underline" color="blue" /></span></h2>
        <p class="panel-dek">Quietly at Work. Seven sessions in the book of Ruth, one screen at a time.</p>
        <a class="btn btn-light" href="https://grabyourbibles.com/quietly-at-work/" rel="noopener">
          Start the study <span class="arw" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </div>
</Shell>
