---
/*
  /essays/ reads top to bottom as: what this is, then the run in progress, then
  the pieces that stand alone, then the record of everything.

  The two lists draw on the same essays on purpose and answer different
  questions. "On its own" is a reading list, ordered by what someone arriving
  should read. "By date" is a record, ordered by when it happened, and is
  deliberately plainer than the lists above it.
*/
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import IntroRow from '../../components/IntroRow.astro';
import SeriesBlock from '../../components/SeriesBlock.astro';
import Timeline from '../../components/Timeline.astro';
import { live, introPost, readMinutes, displayDate, isoDate, currentSeries } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';
import home from '../../data/home.json';

const entries = await live('essays');
const intro = await introPost('essays');
const series = await currentSeries('essays');

/* An essay stands alone when it is not part of the running series. */
const inSeries = new Set(
  series ? entries.filter((e: any) => e.data.series === series.name).map((e: any) => e.id) : []
);
const standalone = entries.filter((e: any) => !inSeries.has(e.id));

const items = entries.map((e: any) => ({
  href: `/essays/${e.id}/`, title: e.data.title, dek: e.data.dek, publishAt: e.data.publishAt,
}));

const title = labels.essaysHeading;
const dek = labels.essaysDek;
---
<Base title={`${title} · ${site.name}`} description={dek}>
  <section class="band shell">
    <div class="sec-head">
      <h1>{title}</h1>
    </div>
    <p class="sec-sub">{labels.essaysSubtitle}</p>

    {/* First thing after the heading and the one sentence, whether or not a
        series is running and whether or not anything else is published yet. */}
    {intro && (
      <div class="list list-intro">
        <IntroRow href={`/essays/${intro.id}/`} title={intro.data.title}
                  dek={intro.data.dek} body={intro.body ?? ''} label={labels.introFlag} />
      </div>
    )}

    {series && series.parts.length > 1 && (
      <SeriesBlock name={series.name} dek={series.dek} parts={series.parts} />
    )}

    {standalone.length > 0 && (
      <section class="ess-alone" aria-labelledby="alone-h">
        {series && series.parts.length > 1 && <h2 class="sec-h2" id="alone-h">{labels.essaysStandaloneHeading}</h2>}
        <div class="list">
          {standalone.map((e: any) => (
            <a class="list-item" href={`/essays/${e.id}/`}>
              <span class="date"><time datetime={isoDate(e.data.publishAt)}>{displayDate(e.data.publishAt)}</time></span>
              <span class="t">{e.data.title}<span class="d">{e.data.dek}</span></span>
              <span class="r">{readMinutes(e.body)} min</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {entries.length === 0 && labels.essaysEmpty && <p class="empty-note">{labels.essaysEmpty}</p>}

    {/* By date renders only when a series is running. A series is the only
        thing that makes the list above non-chronological, and therefore the
        only thing that makes a chronological record say anything different.
        With no series the two lists are identical (round 8, R8-4). */}
    {series && series.parts.length > 1 && (
      <Timeline items={items} heading={labels.timelineHeading} sub={labels.essaysTimelineSub} />
    )}

    {entries.length > 0 && (
      <p class="sec-more"><a class="readlink" href="/archive/">{labels.archiveLink} <span>&rarr;</span></a></p>
    )}
  </section>
  <Signup />
</Base>
