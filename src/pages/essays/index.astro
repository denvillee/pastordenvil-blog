---
/*
  Template A, the archive. Essays is the fullest version of it; For Leaders and
  Moments use the same structure with their own personality.

  Two controls from the reference are deliberately absent until the archive has
  the volume to justify them: a sort dropdown and a "load more" button. With
  three published pieces both would be controls that do nothing, and a control
  that does nothing is worse than no control.
*/
import { render } from 'astro:content';
import CloseBand from '../../components/CloseBand.astro';
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import DotGrid from '../../components/marks/DotGrid.astro';
import ArtPlate from '../../components/ArtPlate.astro';
import StickyNote from '../../components/marks/StickyNote.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import EssayCard from '../../components/EssayCard.astro';
import TopicList from '../../components/TopicList.astro';
import Tape from '../../components/marks/Tape.astro';
import SeriesBlock from '../../components/SeriesBlock.astro';
import Doorway from '../../components/Doorway.astro';
import { live, introPost, currentSeries } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';

const entries = await live('essays');
const intro = await introPost('essays');
/* The introduction opens the page rather than sitting in a card beside it:
   Denvil's revision packet asks each section to open with a doorway in his
   own voice. It is still the same real, linkable, CMS-editable post. */
const { Content: IntroBody } = intro ? await render(intro) : { Content: null };
const series = await currentSeries('essays');

/* The featured slot honours `pinned`, matching what latest() does for the home
   page. Before this they disagreed: home showed the pinned opening essay while
   this page led with the newest, so the same series had a different "first"
   depending on which page you arrived on, and a new reader landed on part two.
   Denvil, 1 Sep: "the first essay should be the first one." */
const pinnedIdx = entries.findIndex((e: any) => e.data.pinned);
const ordered = pinnedIdx > 0
  ? [entries[pinnedIdx], ...entries.filter((_: any, i: number) => i !== pinnedIdx)]
  : entries;
const [featured, ...rest] = ordered;
/* The front door for a first-time reader: the pinned essay, which is Denvil
   saying where to start. Null when nothing is pinned, and the card goes with it. */
const frontDoor = entries.find((e: any) => e.data.pinned);
---
<Shell title={`${labels.essaysHeading} · ${site.name}`} description={labels.essaysDek} current="essays">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell arch-head">
      <div>
        <h1 class="page-h is-display">{labels.essaysHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          What there&#32;<span class="u">wasn't time to say<Mark kind="underline" color="yellow" /></span>&#32;on Sunday.
        </p>
      </div>
      {/* The right of this row was a field of dots and nothing else. */}
      <div class="head-art">
        <DotGrid cols={7} rows={4} class="head-dots" />
        <ArtPlate kind="passage" class="artp-band" />
      </div>
    </section>

    {IntroBody && (
      <Doorway tone="yellow" collapsed={entries.length > 0}>
        <IntroBody />
        <StickyNote slot="rail" tone="green" tilt={-1.6} tape={true} class="side-note">
          The kingdom is already here, and still coming. Most of what I write
          lives somewhere in that tension.
        </StickyNote>
      </Doorway>
    )}

    <div class="shell arch-deck">
      <div class="arch-main">
        {featured && (
          <FeaturedEssay href={`/essays/${featured.id}/`} entry={featured}
                         room={labels.essaysHeading} />
        )}

        {series && series.parts.length > 1 && (
          <SeriesBlock name={series.name} dek={series.dek} parts={series.parts} />
        )}

        {/* No empty state. If nothing is published the doorway carries the
            page on its own. */}
      </div>

      <aside class="arch-side" aria-label="More on this site">
        {/* Explore by topic, restored 1 Sep to match the comp. It had been
            pulled because two of the four topics led to a page with a single
            essay on it, which exposes the content system rather than the
            content. That was a content problem, not a design one, and the
            component already guards itself: a topic renders only when a
            published piece actually carries one of its tags. As the archive
            fills, the rest turn themselves on. */}
        <TopicList rooms={['essays']} />

        <StickyNote tone="green" tilt={-1.6} tape={true} class="side-note">
          The kingdom is already here, and still coming. Most of what I write
          lives somewhere in that tension.
        </StickyNote>

        {/* The comp's "New here?" card. Its wording was "Start with some of the
            most loved essays" — not used, because nothing measures which essays
            are loved and the site would be claiming something it cannot know.
            The pinned essay is the honest front door: pinning one IS Denvil
            saying where to start. The card disappears when nothing is pinned. */}
        {frontDoor && (
          <section class="side-card side-new" aria-labelledby="newhere-h">
            <h2 class="side-h" id="newhere-h">New here?</h2>
            <p>Start where the run starts.</p>
            <a class="go" href={`/essays/${frontDoor.id}/`}>
              {frontDoor.data.title} <span class="arw" aria-hidden="true">&rarr;</span>
            </a>
            <p class="side-slip">
              <Tape color="blue" class="side-slip-tape" />
              {site.tagline}
            </p>
          </section>
        )}
      </aside>
    </div>

    {/* The listing takes the full measure. The rail beside it is two blocks
        tall and the listing is not, so keeping the listing inside the rail's
        column left a column of empty page down the right for the whole
        scroll. */}
    {rest.length > 0 && (
      <section class="shell arch-list">
        <div class="sec-head">
          <h2 class="sec-h">All essays</h2>
          <span class="count">{entries.length} {entries.length === 1 ? 'essay' : 'essays'}</span>
        </div>
        <div class="ecards">
          {rest.map((e: any) => (
            <EssayCard href={`/essays/${e.id}/`} entry={e} room={labels.essaysHeading} />
          ))}
        </div>
      </section>
    )}

    {/* This was a bespoke full-width panel with a single zigzag, and everything
        in it sat in the left third against two thirds of empty navy. Denvil,
        2 Sep: "look at the grab your bibles bar, it looks boring." It is the
        same job as the closing band he liked on Bookshelf and For Leaders, so
        it uses that component: two columns, a zigzag at the outer corner and
        speckles opposite. */}
    <CloseBand tone="dark"
               heading="Grab your Bibles."
               mark="Bibles"
               dek="Quietly at Work. Seven sessions in the book of Ruth, one screen at a time."
               href="https://grabyourbibles.com/quietly-at-work/"
               cta="Start the study" external={true} />
  </div>
</Shell>
