---
import CloseBand from '../components/CloseBand.astro';
/*
  Bookshelf. Real covers, real books, Denvil's own one-line takeaways.

  The reference shows a category filter bar. The reading collection has no
  category field and inventing one would be a taxonomy the content cannot
  support, so the page uses the axis the data actually has: what he is reading
  now, this month's shelf, and what is next.
*/
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import ArtPlate from '../components/ArtPlate.astro';
import Doorway from '../components/Doorway.astro';
import Mark from '../components/marks/Mark.astro';
import BookCard from '../components/BookCard.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import ImageMask from '../components/ImageMask.astro';
import Placeholder from '../components/Placeholder.astro';
import Photo from '../components/Photo.astro';
import { live } from '../lib/publish';
import site from '../data/site.json';
import home from '../data/home.json';
import labels from '../data/labels.json';

const books = await live('reading');
const now = books.find((b: any) => b.data.shelfStatus === 'now');
const next = books.filter((b: any) => b.data.shelfStatus === 'next');
const shelf = books.filter((b: any) => b !== now && b.data.shelfStatus !== 'next')
  .sort((a: any, b: any) => a.data.order - b.data.order);

/* The comp's Featured Recommendation panel. One book, flagged in the editor. */
const pick = shelf.find((b: any) => b.data.featured);
const rest = pick ? shelf.filter((b: any) => b !== pick) : shelf;

/* The comp's filter row. Same rule as Watch: a chip renders only when books
   actually carry that category, so the row grows as the shelf is labelled and
   never shows a chip with nothing behind it. */
const CAT: Record<string,string> = {
  leadership:'Leadership', theology:'Theology', formation:'Personal Growth',
  culture:'Culture', communication:'Communication', teams:'Teams', strategy:'Strategy',
};
const catCount = new Map<string,number>();
for (const b of shelf) { const c = (b as any).data.category; if (c) catCount.set(c,(catCount.get(c)??0)+1); }
const cats = Object.keys(CAT).filter((c) => catCount.has(c));
const showCats = cats.length >= 2;

/* The section's own introduction, in Denvil's voice, opening the page. */
const landingDoc = await getEntry('landing', 'bookshelf');
const { Content: LandingBody } = landingDoc ? await render(landingDoc) : { Content: null };
---
<Shell title={`${labels.readingHeading} · ${site.name}`} description={labels.readingDek} current="reading">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell book-hero">
      <div>
        <h1 class="page-h is-display">{labels.readingHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          The books and voices shaping how I&#32;<span class="u">think,<Mark kind="underline" color="yellow" /></span>&#32;<span class="u">teach,<Mark kind="underline" color="green" /></span> and&#32;<span class="u">lead.<Mark kind="underline" color="coral" /></span>
        </p>
      </div>
      <ImageMask shape="torn" tape="coral">
        <Photo name="dl-books" width={1600} height={900}
               sizes="(max-width: 900px) 92vw, 48vw"
               alt="A shelf of Denvil's books, spines out: Ladd, McKnight, N. T. Wright, Boesak and a run of titles on the kingdom and Revelation." />
      </ImageMask>
    </section>

    {LandingBody && (
      <Doorway tone="green" collapsed={books.length > 0}>
        <LandingBody />
        {/* The doorway band is 1200px wide and its copy is 633, so without a
            rail the right half of it was empty tint. The pack draws a rail on
            every section page; this is the site's own drawing, so nothing is
            bought and nothing is invented. */}
        <ArtPlate slot="rail" kind="shelf" class="artp-band" />
      </Doorway>
    )}

    {now && (
      <section class="shell">
        <div class="sec-head"><h2 class="sec-h"><span class="u">What I'm reading now<Mark kind="underline" color="yellow" /></span></h2></div>
        <div class="book-feat"><BookCard book={now} /></div>
      </section>
    )}

    {shelf.length > 0 && (
      <section class="band shell">
        <div class="sec-head">
          <h2 class="sec-h">On the shelf</h2>
          {/* The count belongs to THIS section, not to the whole collection.
              It said 13 while the section listed a subset, because "now" and
              "next" are pulled out above and below it. */}
          <span class="count">{shelf.length} {shelf.length === 1 ? 'book' : 'books'}</span>
        </div>
        {showCats && (
          <div class="arc-filters bfilters" role="group" aria-label="Filter by category">
            <button type="button" class="chip-btn on" data-bcat="all" aria-pressed="true">All Books</button>
            {cats.map((c) => (
              <button type="button" class="chip-btn" data-bcat={c} aria-pressed="false">{CAT[c]}</button>
            ))}
          </div>
        )}

        {pick && (
          <div class="bfeat">
            <p class="bfeat-k">Featured recommendation</p>
            <div class="bfeat-in">
              <BookCard book={pick} />
              {pick.data.pullQuote && (
                <blockquote class="bfeat-q">
                  <Mark kind="asterisk" color="coral" class="bfeat-star" />
                  <p>{pick.data.pullQuote}<Mark kind="underline" color="coral" /></p>
                  <cite>{pick.data.author}</cite>
                </blockquote>
              )}
            </div>
          </div>
        )}

        <div class="bcards">{rest.map((b: any) => (
          <div class="bwrap" data-bcat={b.data.category ?? ''}><BookCard book={b} /></div>
        ))}</div>
      </section>
    )}

    {next.length > 0 && (
      <section class="shell">
        <div class="sec-head"><h2 class="sec-h">On my list next</h2></div>
        <div class="bcards bcards-tight">{next.map((b: any) => <BookCard book={b} />)}</div>
      </section>
    )}

    <section class="shell book-note">
      <StickyNote tone="green" tilt={-1.4} tape={false}>{home.readingTie}</StickyNote>
      <p class="mt"><a class="go" href="/bookshelf/all/">Every book <span class="arw" aria-hidden="true">&rarr;</span></a></p>
    </section>
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}

  <CloseBand tone="dark"
             heading="Always learning. Always growing."
             mark="learning"
             dek="The books and voices shaping how I think, teach, and lead."
             href="/subscribe/" cta="Subscribe" />

  <script>
    /* Same shape as the Watch filter: chips toggle, cards hide, and the whole
       control is absent from the markup when there is nothing to filter. */
    {
      const wraps = Array.from(document.querySelectorAll<HTMLElement>('.bwrap'));
      const btns  = Array.from(document.querySelectorAll<HTMLElement>('button[data-bcat]'));
      if (wraps.length && btns.length) {
        btns.forEach((b) => b.addEventListener('click', () => {
          const v = b.dataset.bcat ?? 'all';
          btns.forEach((x) => {
            const on = x.dataset.bcat === v;
            x.classList.toggle('on', on);
            x.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          wraps.forEach((w) => { w.hidden = !(v === 'all' || w.dataset.bcat === v); });
        }));
      }
    }
  </script>
</Shell>
