---
/*
  Layer 2 of the Bookshelf: this month. The now-reading book expanded at the
  top, the rest of the month beneath it, and one door to /bookshelf/all/.
  Never renders empty: with no books in the newest month it falls back to the
  most recent month that has any.
*/
import Base from '../layouts/Base.astro';
import Signup from '../components/Signup.astro';
import LandingCopy from '../components/LandingCopy.astro';
import { live } from '../lib/publish';
import { monthLabel, latestMonth } from '../lib/shelf';
import site from '../data/site.json';
import home from '../data/home.json';
import labels from '../data/labels.json';

const entries = await live('reading');
const books = entries.map((b: any) => ({ ...b.data, note: b.body?.trim() || '' }));
const month = latestMonth(books);
const monthBooks = books.filter((b: any) => b.shelfMonth === month);
const now = monthBooks.find((b: any) => b.shelfStatus === 'now')
  ?? books.find((b: any) => b.shelfStatus === 'now')
  ?? monthBooks[0];
const shelf = monthBooks.filter((b: any) => b !== now)
  .sort((a: any, b: any) => a.order - b.order);

function progressPct(s?: string): number | null {
  if (!s) return null;
  const pct = s.match(/(\d{1,3}(?:\.\d+)?)\s*%/);
  if (pct) { const v = Number(pct[1]); return v >= 0 && v <= 100 ? v : null; }
  const frac = s.match(/(\d+)\s*(?:of|\/)\s*(\d+)/i);
  if (frac) { const a = Number(frac[1]), b = Number(frac[2]); return b > 0 && a <= b ? (a / b) * 100 : null; }
  return null;
}
const pct = progressPct(now?.progress);
---
<Base title={`Bookshelf · ${site.name}`} description={labels.readingDek}>
  <section class="band shell">
    <div class="sec-head">
      <h1>{labels.readingHeading}</h1>
      <span class="label">{monthLabel(month)}</span>
    </div>
    <p class="sec-sub">{labels.readingSubtitle}</p>
    <LandingCopy room="bookshelf" />

    {now && (
      <div class="now-read" style="margin-bottom:2rem">
        {now.cover
          ? <img class="cover" src={now.cover} alt={`Cover of ${now.title}`} width="96" loading="lazy" decoding="async" />
          : <span class={`spine sp-${now.spine}`}><span>{now.title}</span></span>}
        <span class="bk">
          <span class="ba">{labels.readingNowLabel}</span>
          <span class="bt">{now.link ? <a href={now.link} rel="noopener">{now.title}</a> : now.title}</span>
          <span class="ba" style="letter-spacing:.08em">{now.author}{now.year ? ` · ${now.year}` : ''}</span>
          <span class="bn" set:html={now.note}></span>
          {now.progress && (
            <>
              {pct !== null && <span class="bar"><i style={`width:${pct.toFixed(1)}%`}></i></span>}
              <span class="bar-l">{now.progress}</span>
            </>
          )}
        </span>
      </div>
    )}

    {shelf.length > 0 && (
      <div class="shelf">
        {shelf.map((b: any) => (
          <div class="shelf-row">
            {b.cover
              ? <img class="mini-cover" src={b.cover} alt="" width="38" loading="lazy" decoding="async" />
              : <span class="mini plate" aria-hidden="true">{b.title.split(/\s+/).filter((w: string) => /^[A-Za-z]/.test(w)).slice(0, 3).map((w: string) => w[0].toUpperCase()).join('')}</span>}
            <span>
              <span class="st">{b.title}<span class="sa">{b.author}</span></span>
              <span class="sv" set:html={b.note}></span>
            </span>
          </div>
        ))}
      </div>
    )}

    <p class="shelf-tie">{home.readingTie}</p>
    <p><a class="readlink" href="/bookshelf/all/">Every book <span aria-hidden="true">&rarr;</span></a></p>
  </section>
  <Signup />
</Base>
