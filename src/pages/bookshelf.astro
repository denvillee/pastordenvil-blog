---
import Base from '../layouts/Base.astro';
import ReadingShelf from '../components/ReadingShelf.astro';
import Signup from '../components/Signup.astro';
import { live } from '../lib/publish';
import site from '../data/site.json';
import home from '../data/home.json';
const books = await live('reading');
const nowEntry = books.find((b: any) => b.data.shelfStatus === 'now');
const now = nowEntry ? { ...nowEntry.data, note: nowEntry.body?.trim() ?? '' } : undefined;
const shelf = books.filter((b: any) => b.data.shelfStatus !== 'now')
  .sort((a: any, b: any) => a.data.order - b.data.order)
  .map((b: any) => ({ ...b.data, note: b.body?.trim() || '' }));
---
<Base title={`Bookshelf — ${site.name}`} description="What I am reading now, and the books behind the writing.">
  <ReadingShelf now={now} shelf={shelf} tie={home.readingTie} />
  <Signup />
</Base>
