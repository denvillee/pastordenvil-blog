---
/*
  Bookshelf. Real covers, real books, Denvil's own one-line takeaways.

  The reference shows a category filter bar. The reading collection has no
  category field and inventing one would be a taxonomy the content cannot
  support, so the page uses the axis the data actually has: what he is reading
  now, this month's shelf, and what is next.
*/
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Doorway from '../components/Doorway.astro';
import Mark from '../components/marks/Mark.astro';
import BookCard from '../components/BookCard.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import ImageMask from '../components/ImageMask.astro';
import Placeholder from '../components/Placeholder.astro';
import Photo from '../components/Photo.astro';
import Signup from '../components/Signup.astro';
import { live } from '../lib/publish';
import site from '../data/site.json';
import home from '../data/home.json';
import labels from '../data/labels.json';

const books = await live('reading');
const now = books.find((b: any) => b.data.shelfStatus === 'now');
const next = books.filter((b: any) => b.data.shelfStatus === 'next');
const shelf = books.filter((b: any) => b !== now && b.data.shelfStatus !== 'next')
  .sort((a: any, b: any) => a.data.order - b.data.order);

/* The section's own introduction, in Denvil's voice, opening the page. */
const landingDoc = await getEntry('landing', 'bookshelf');
const { Content: LandingBody } = landingDoc ? await render(landingDoc) : { Content: null };
---
<Shell title={`${labels.readingHeading} · ${site.name}`} description={labels.readingDek} current="reading">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell book-hero">
      <div>
        <h1 class="page-h is-display">{labels.readingHeading}<span class="dot">.</span>
          <Mark kind="underline" color="blue" class="page-uline" draw={true} />
        </h1>
        <p class="page-dek">
          Books shape the way I&#32;<span class="u">think<Mark kind="underline" color="yellow" /></span>,&#32;<span class="u">lead<Mark kind="underline" color="green" /></span>, and&#32;<span class="u">live<Mark kind="underline" color="coral" /></span>. Here are the ones that have stayed with me.
        </p>
      </div>
      <ImageMask shape="torn">
        <Photo name="dl-books" width={1600} height={900}
               sizes="(max-width: 900px) 92vw, 48vw"
               alt="A shelf of Denvil's books, spines out: Ladd, McKnight, N. T. Wright, Boesak and a run of titles on the kingdom and Revelation." />
      </ImageMask>
    </section>

    {LandingBody && (
      <Doorway tone="green">
        <LandingBody />
      </Doorway>
    )}

    {now && (
      <section class="shell">
        <div class="sec-head"><h2 class="sec-h"><span class="u">What I'm reading now<Mark kind="underline" color="yellow" /></span></h2></div>
        <div class="book-feat"><BookCard book={now} /></div>
      </section>
    )}

    {shelf.length > 0 && (
      <section class="band shell">
        <div class="sec-head">
          <h2 class="sec-h">On the shelf</h2>
          <span class="count">{books.length} books</span>
        </div>
        <div class="bcards">{shelf.map((b: any) => <BookCard book={b} />)}</div>
      </section>
    )}

    {next.length > 0 && (
      <section class="shell">
        <div class="sec-head"><h2 class="sec-h">On my list next</h2></div>
        <div class="bcards bcards-tight">{next.map((b: any) => <BookCard book={b} />)}</div>
      </section>
    )}

    <section class="shell book-note">
      <StickyNote tone="green" tilt={-1.4} tape={false}>{home.readingTie}</StickyNote>
      <p class="mt"><a class="go" href="/bookshelf/all/">Every book <span class="arw" aria-hidden="true">&rarr;</span></a></p>
    </section>
  </div>
  <Signup tone="dark" />
</Shell>
