---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import DotGrid from '../../components/marks/DotGrid.astro';
import StickyNote from '../../components/marks/StickyNote.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import MomentCard from '../../components/MomentCard.astro';
import Photo from '../../components/Photo.astro';
import ColorDisc from '../../components/marks/ColorDisc.astro';
import { live, introPost } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';

const entries = await live('moments');
const intro = await introPost('moments');
const { Content: IntroBody } = intro ? await render(intro) : { Content: null };
const [featured, ...rest] = entries;
const ghostCount = Math.max(0, 8 - rest.length);
---
<Shell title={`${labels.momentsHeading} · ${site.name}`} description={labels.momentsDek} current="moments">
  <div class="arch">
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell mom-hero">
      <div>
        <h1 class="page-h is-display"><span class="c">{labels.momentsHeading}<Mark kind="circle-loose" color="yellow" draw={true} /></span></h1>
        <p class="page-dek">{labels.momentsSubtitle}</p>
      </div>
      <div class="mom-quote">
        <DotGrid cols={6} rows={4} class="mom-dots" />
        <StickyNote tone="blue" tilt={1.2} tape={true}>These are the moments I am trying to notice before I explain them away.</StickyNote>
      </div>
    </section>

    <section class="shell mom-feature-layout">
      <div>
        <div class="sec-head" style="margin-bottom:1rem"><h2 class="sec-h"><span class="u">Featured moment<Mark kind="underline" color="coral" /></span></h2></div>
        {featured ? (
          <FeaturedEssay href={`/moments/${featured.id}/`} entry={featured} label="Featured" room={labels.momentsHeading} tone="coral" />
        ) : (
          <div class="lead-mini" style="min-height:230px;justify-content:center"><span class="chip chip-coral" style="align-self:flex-start">Featured</span><h2 style="font-size:1.65rem;margin:.9rem 0 .45rem">The first Moment will live here.</h2><p>The frame is ready for a photograph, a short reflection, or one idea worth keeping.</p></div>
        )}
      </div>
      <div class="tiny-observation">
        <h2><span class="u">Tiny observation<Mark kind="underline" color="blue" /></span></h2>
        <div class="tiny-card"><span class="cico cico-yellow" aria-hidden="true">✦</span><p>Something small can live here without needing to become an essay.</p><time>Moments</time></div>
      </div>
    </section>

    <section class="shell" style="padding-top:2.2rem">
      <div class="sec-head" style="margin-bottom:1rem"><h2 class="sec-h">Recent moments</h2></div>
      {rest.length > 0 && <div class="mcards">{rest.map((e:any,i:number)=><MomentCard href={`/moments/${e.id}/`} entry={e} i={i} />)}</div>}
      {ghostCount > 0 && (
        <div class="moment-ghosts" aria-label="Space reserved for future Moments">
          {Array.from({length:Math.min(ghostCount,8)}).map((_,i)=><div class="moment-ghost" style={`--tilt:${[-1.1,.8,-.6,1.2][i%4]}deg`}>A Moment can live here.</div>)}
        </div>
      )}
    </section>

    <section class="shell mom-bottom">
      <div class="mom-bottom-copy">
        <ColorDisc lines={["theology","leadership","life"]} />
        <div>
          <p>These are intentionally a little looser. Sometimes there may be a reflection, sometimes a photograph, sometimes simply an idea I do not want to lose.</p>
          {IntroBody && (<details><summary class="go">Why Moments exists <span class="arw" aria-hidden="true">&rarr;</span></summary><div style="margin-top:1rem"><IntroBody /></div></details>)}
        </div>
      </div>
      <Photo name="dl-about-v2" width={900} height={1180} sizes="(max-width:900px) 92vw, 46vw" alt="Denvil Lee standing and smiling." />
    </section>
  </div>
</Shell>
