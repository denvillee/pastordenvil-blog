---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import DotGrid from '../../components/marks/DotGrid.astro';
import Photo from '../../components/Photo.astro';
import StickyNote from '../../components/marks/StickyNote.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import MomentCard from '../../components/MomentCard.astro';
import Doorway from '../../components/Doorway.astro';
import ArtPlate from '../../components/ArtPlate.astro';
import { live, introPost } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';

const entries = await live('moments');
const intro = await introPost('moments');
/* The introduction opens the page rather than sitting in a card beside it:
   Denvil's revision packet asks each section to open with a doorway in his
   own voice. It is still the same real, linkable, CMS-editable post. */
const { Content: IntroBody } = intro ? await render(intro) : { Content: null };
const [featured, ...rest] = entries;
---
<Shell title={`${labels.momentsHeading} · ${site.name}`} description={labels.momentsDek} current="moments">
  <div class="arch">
    <Mark kind="brush" color="coral" class="edge edge-l mom-edge" />
    <section class="shell mom-hero">
      <div>
        <h1 class="page-h is-display"><span class="c">{labels.momentsHeading}<Mark kind="circle-loose" color="yellow" draw={true} /></span></h1>
        <p class="page-dek">{labels.momentsSubtitle}</p>
      </div>
      <div class="mom-quote">
        {/* The sticky note read "Grace is not the absence of struggle, but the
            presence of God." It was never supplied, it reads as a generic
            inspirational line, and it interrupted the opening.

            The helmet takes that space instead. It is the only humorous picture
            on the site, so it belongs where someone has already chosen to come
            rather than on the front page, where it would be spent on every
            visit. Cut out on the page ground, one coral dot, and nothing else:
            no tape, no doodles, no arrow. The restraint is the joke. */}
        <Photo name="dl-helmet-v2" width={1000} height={1250} class="mom-art"
               sizes="(max-width: 900px) 80vw, 34vw"
               alt="Denvil Lee wearing a gold toy space helmet, cut out among drawn marks." />
        <DotGrid cols={6} rows={4} class="mom-dots" />
      </div>
    </section>

    {IntroBody && (
      <Doorway tone="coral" collapsed={entries.length > 0}>
        <IntroBody />
        {/* Moments has no sticky note, because a note needs words and none
            were written for it. Designed art instead, per Denvil's 30 Aug
            note that not every page needs a photograph of him. */}
        <ArtPlate slot="rail" kind="notice" class="artp-band" />
      </Doorway>
    )}

    <section class="shell">
      {/* When nothing is published the listing is simply absent. The site
          never announces its own emptiness. */}
      {featured && (
        <FeaturedEssay href={`/moments/${featured.id}/`} entry={featured}
                       label="Featured moment" room={labels.momentsHeading} tone="coral" />
      )}

      {rest.length > 0 && (
        <>
          <div class="sec-head arch-sub"><h2 class="sec-h">Recent moments</h2></div>
          <div class="mcards">
            {rest.map((e: any, i: number) => (
              <MomentCard href={`/moments/${e.id}/`} entry={e} i={i} />
            ))}
          </div>
        </>
      )}

    </section>
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}
</Shell>
