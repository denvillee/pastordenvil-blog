---
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import DotGrid from '../../components/marks/DotGrid.astro';
import Photo from '../../components/Photo.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import MomentCard from '../../components/MomentCard.astro';
import Doorway from '../../components/Doorway.astro';
import ArtPlate from '../../components/ArtPlate.astro';
import ColorDisc from '../../components/marks/ColorDisc.astro';
import NoteCard from '../../components/NoteCard.astro';
import Glyph from '../../components/Glyph.astro';
import { live, introPost, displayDate } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';

const entries = await live('moments');
const intro = await introPost('moments');
/* The introduction opens the page rather than sitting in a card beside it:
   Denvil's revision packet asks each section to open with a doorway in his
   own voice. It is still the same real, linkable, CMS-editable post. */
const { Content: IntroBody } = intro ? await render(intro) : { Content: null };
const pinnedIdx = entries.findIndex((e: any) => e.data.pinned);
const ordered = pinnedIdx > 0
  ? [entries[pinnedIdx], ...entries.filter((_: any, i: number) => i !== pinnedIdx)]
  : entries;

/* The comp splits the page three ways, and the split is by FORMAT, not by date:
   one featured moment, one "tiny observation" pulled out beside it, and the
   remainder as a grid of handwritten scraps.

   A tiny is shorter than a note and carries no argument. It gets its own slot
   because putting it in the grid would make it look like a note that ran short.
   Newest tiny wins; if none is published the slot is simply absent, the way the
   rest of this page already handles emptiness. */

/* The paper, the clip and the drawn mark are authored per post in the CMS. The
   tone cycles blue -> yellow -> coral -> green so a row of scraps carries the
   same four-colour rotation the rest of the system uses. */
const TONES = ['blue', 'yellow', 'coral', 'green'] as const;
---
<Shell title={`${labels.momentsHeading} · ${site.name}`} description={labels.momentsDek} current="moments">
  <div class="arch">
    <Mark kind="brush" color="coral" class="edge edge-l mom-edge" />
    <section class="shell mom-hero">
      <div>
        <h1 class="page-h is-display"><span class="c">{labels.momentsHeading}<Mark kind="circle-loose" color="yellow" draw={true} /></span></h1>
        <p class="page-dek">{labels.momentsSubtitle}</p>
      </div>
      <div class="mom-quote">
        {/* PULLED, 2 Sep. The blue note here carried "Grace is not the
            absence of struggle, but the presence of God." Nobody wrote it.
            The comment above it in the previous version said so, and then a
            second comment claimed it came from one of Denvil's documents, and
            both cannot be true. A sentence in his voice, in his colours, on
            his page, is his whether or not it is in quotation marks, so it
            comes out until he supplies one he actually said. The space is
            better empty than borrowed. */}
        <DotGrid cols={6} rows={4} class="mom-dots" />
      </div>
    </section>

    {IntroBody && (
      <Doorway tone="coral" collapsed={entries.length > 0}>
        <IntroBody />
        {/* Moments has no sticky note, because a note needs words and none
            were written for it. Designed art instead, per Denvil's 30 Aug
            note that not every page needs a photograph of him. */}
        <ArtPlate slot="rail" kind="notice" class="artp-band" />
      </Doorway>
    )}

    <section class="shell">
      {/* ── the wall ──────────────────────────────────────────────────────
          Denvil, 2 Sep: "the moments are supposed to be the photos." So the
          page is the wall of cards and nothing else. The old split -- one
          featured moment in a big box, a tiny observation beside it, then a
          grid -- was three treatments for what is now one kind of thing, and
          the featured box was advertising the one Moment that has no card yet
          by drawing a placeholder in its place.

          A Moment with a card is its card. A Moment that is a piece of writing
          rather than a card keeps the note treatment, so the wall never has a
          hole in it. Pinned leads, and leads at double width when it has the
          art to carry it.

          When nothing is published the listing is simply absent. The site
          never announces its own emptiness. */}
      {ordered.length > 0 && (
        <>
          <div class="sec-head">
            <h2 class="sec-h"><span class="u">Recent moments<Mark kind="underline" color="coral" draw={true} /></span></h2>
          </div>
          <div class="mwall">
            {ordered.map((e: any, i: number) => (
              <MomentCard href={`/moments/${e.id}/`} entry={e} i={i}
                          lead={i === 0} eager={i < 3} />
            ))}
          </div>
        </>
      )}
    </section>

    {/* The comp closes Moments with a band on the page ground: the colour disc
        at the left, two short lines, and a photograph on the right. Its words
        are the comp's, held until Denvil replaces them. */}
    <section class="shell mom-close">
      <ColorDisc lines={["theology","leadership","life"]} class="mom-close-disc" />
      <div class="mom-close-t">
        <p>These aren't polished. They're just real.</p>
        <p>Thanks for being here. I hope something here encourages you today.</p>
        <a class="go" href="/subscribe/">Subscribe for more <span class="arw" aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="mom-close-art">
        <Photo name="dl-stage-open" width={1600} height={1000}
               sizes="(max-width: 900px) 92vw, 46vw"
               alt="Denvil Lee teaching on stage in a yellow hoodie, both hands open, under a Come Alive banner." />
      </div>
      <Mark kind="scribble" color="yellow" class="mom-close-zig" />
    </section>
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}
</Shell>
