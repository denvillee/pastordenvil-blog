---
import Glyph from '../../components/Glyph.astro';
import leadData from '../../data/leader-topics.json';
import TopicList from '../../components/TopicList.astro';
import CloseBand from '../../components/CloseBand.astro';
import { render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Mark from '../../components/marks/Mark.astro';
import ColorDisc from '../../components/marks/ColorDisc.astro';
import StickyNote from '../../components/marks/StickyNote.astro';
import Placeholder from '../../components/Placeholder.astro';
import Photo from '../../components/Photo.astro';
import ImageMask from '../../components/ImageMask.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import EssayCard from '../../components/EssayCard.astro';
import Doorway from '../../components/Doorway.astro';
import { live, introPost } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';

const entries = await live('leaders');
const intro = await introPost('leaders');
/* The introduction opens the page rather than sitting in a card beside it:
   Denvil's revision packet asks each section to open with a doorway in his
   own voice. It is still the same real, linkable, CMS-editable post. */
const { Content: IntroBody } = intro ? await render(intro) : { Content: null };
const [featured, ...rest] = entries;
---
<Shell title={`${labels.leadersHeading} · ${site.name}`} description={labels.leadersDek} current="leaders">
  <div class="arch">
    <Mark kind="star" color="green" class="edge edge-l lead-edge" />
    <Mark kind="brush" color="coral" class="arch-brush" />

    <section class="shell lead-hero">
      <div>
        <h1 class="page-h is-display"><span class="u">{labels.leadersHeading}<Mark kind="underline" color="yellow" draw={true} /></span></h1>
        <p class="page-dek">
          Following Jesus while&#32;<span class="u">leading people.<Mark kind="underline" color="blue" /></span>
        </p>
        <p class="lead-sub">{labels.leadersSubtitle}</p>
        {featured && (
          <p class="hero-acts">
            <a class="btn btn-blue" href={`/leaders/${featured.id}/`}>
              Read the latest essay <span class="arw" aria-hidden="true">&rarr;</span>
            </a>
            {/* The comp writes a handwritten note beside this button with an
                arrow pointing back at it. Its words were "Practical wisdom for
                everyday ministry"; Denvil's own description of this room, from
                the site's own labels, is used instead. */}
            <span class="hero-anno">
              <Mark kind="arrow" color="ink" class="hero-anno-arw" />
              <span class="hero-anno-t">{labels.leadersDek}</span>
            </span>
          </p>
        )}
      </div>
      <div class="lead-art">
        <ImageMask shape="torn" tape="yellow">
          <Photo name="dl-leaders-v2" width={900} height={1125}
                 sizes="(max-width: 900px) 92vw, 46vw"
                 alt="Denvil Lee at a lectern in a cream shirt, one hand resting on his chest." />
        </ImageMask>
        {/* The comp sets a blue blob over the corner of this photograph with
            three short lines in it, the same device as the coral disc elsewhere. */}
        <ColorDisc lines={["Lead well.","Love deep.","Finish strong."]} color="blue" class="lead-blob" />
        {/* The "Lead well. Love deep. Finish strong." disc came out 29 Aug at
            Denvil's instruction: it read as a slogan rather than as him. The
            McDonald's story in the doorway below establishes the page instead. */}
      </div>
    </section>

    {IntroBody && (
      <Doorway tone="blue" collapsed={entries.length > 0}>
        <IntroBody />
        {/* While the room is empty the note moves up beside the doorway. The
            aside below it has nothing to sit against yet, and the doorway's
            own column left the right half of the page blank for 800px. */}
        <StickyNote slot="rail" tone="blue" tilt={-1.6} tape={false} class="side-note">
          Leadership isn't about having all the answers. It's about keeping your
          eyes on Jesus and serving the people in front of you.
        </StickyNote>
      </Doorway>
    )}

    <div class="shell arch-deck">
      <div class="arch-main">
        {/* No empty state: the doorway carries the page until there is a piece. */}
        {featured && (
          <FeaturedEssay href={`/leaders/${featured.id}/`} entry={featured}
                         label="Featured essay" room={labels.leadersHeading} tone="blue" />
        )}

        {rest.length > 0 && (
          <>
            <div class="sec-head arch-sub">
              <h2 class="sec-h">Short reflections for real leadership</h2>
              <span class="count">{entries.length}</span>
            </div>
            <div class="ecards">
              {rest.map((e: any) => (
                <EssayCard href={`/leaders/${e.id}/`} entry={e} room={labels.leadersHeading} tone="blue" />
              ))}
            </div>
          </>
        )}
      </div>

      {entries.length > 0 && (
        <aside class="arch-side" aria-label="More on this site">
          {/* The comp gives For Leaders its own taxonomy row — Leading Yourself,
              Vision & Calling, People & Culture, Ministry in Context — as five
              coloured circle icons. Those five categories exist only in the comp:
              no post carries them, and no page would be behind them. Rather than
              invent a taxonomy and five empty rooms, this is the same device
              driven by the tags posts actually carry, scoped to this room. It
              fills out as he writes. */}
          <TopicList rooms={['leaders']} />

          <StickyNote tone="blue" tilt={-1.6} tape={false} class="side-note">
            Leadership isn't about having all the answers. It's about keeping your
            eyes on Jesus and serving the people in front of you.
          </StickyNote>
        </aside>
      )}
    </div>

    {/* The comp's two taxonomies. Both are content Denvil fills; the rows and
        their icons are copied from the comp exactly. */}
    <section class="shell ltopics">
      <div class="sec-head">
        <h2 class="sec-h"><span class="u">Leadership topics<Mark kind="underline" color="yellow" draw={true} /></span></h2>
      </div>
      <ul class="lgrid">
        {leadData.topics.map((t: any) => (
          <li>
            <Glyph name={t.icon} tone={t.tone} />
            <h3>{t.label}</h3>
            <p>{t.dek}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="shell lthemes">
      <div class="sec-head">
        <h2 class="sec-h"><span class="u">Explore by theme<Mark kind="underline" color="blue" draw={true} /></span></h2>
      </div>
      <ul class="lgrid lgrid-5">
        {leadData.themes.map((t: any) => (
          <li class="lcard">
            <Glyph name={t.icon} tone={t.tone} />
            <h3>{t.label}</h3>
            <p>{t.dek}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}

  {/* The comp closes For Leaders on a black band with a second panel beside it.
      The comp's band read "Weekly essays and reflections" — a cadence promise
      nobody has made — so the dek says what the room is instead. */}
  <CloseBand tone="dark"
             heading="Keep growing. Keep leading."
             mark="growing"
             dek="Lessons I am learning about following Jesus while leading people."
             href="/subscribe/" cta="Subscribe">
    <div class="cband-note" slot="aside">
      <h3 class="cband-note-h">A note from Denvil</h3>
      <p>I'm a pastor, husband, and dad who loves the local church and believes God is not finished.</p>
      <a class="go go-light" href="/about/">More about me <span class="arw" aria-hidden="true">&rarr;</span></a>
    </div>
  </CloseBand>
</Shell>
