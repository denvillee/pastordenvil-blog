---
import Base from '../../layouts/Base.astro';
import Signup from '../../components/Signup.astro';
import LandingCopy from '../../components/LandingCopy.astro';
import Timeline from '../../components/Timeline.astro';
import { live, readMinutes, displayDate, isoDate, currentSeries } from '../../lib/publish';
import site from '../../data/site.json';
import labels from '../../data/labels.json';
const entries = await live('leaders');
const series = await currentSeries('leaders');
const years = [...new Set(entries.map((e: any) => e.data.publishAt.getFullYear()))];
/* The same by-date view the Essays page uses. It stays off until the section
   has enough in it to have a shape worth showing: with three posts a timeline
   is just the list again, one size smaller. */
const timelineItems = entries.map((e: any) => ({
  href: `/leaders/${e.id}/`, title: e.data.title, dek: e.data.dek, publishAt: e.data.publishAt,
}));
const byYear = years.map((y) => ({ year: y, items: entries.filter((e: any) => e.data.publishAt.getFullYear() === y) }));
const title = labels.leadersHeading;
const dek = labels.leadersDek;
const subtitle = labels.leadersSubtitle;
---
<Base title={`${title} · ${site.name}`} description={dek}>
  <section class="band shell">
    <div class="sec-head">
      <h1>{title}</h1>
    </div>
    <p class="sec-sub">{subtitle}</p>
    <LandingCopy room="leaders" />
    {byYear.map((group) => (
      <section class="arc-year">
        {years.length > 1 && <h2 class="arc-year-h">{group.year}<span>{group.items.length}</span></h2>}
        <div class="list">
          {group.items.map((e: any) => (
            <a class="list-item" href={`/leaders/${e.id}/`}>
              <span class="date"><time datetime={isoDate(e.data.publishAt)}>{displayDate(e.data.publishAt)}</time></span>
              <span class="t">{e.data.title}<span class="d">{e.data.dek}</span></span>
              {/* Only a full essay claims a reading time here, for the same
                  reason it does on the piece itself. */}
              {e.data.format === 'essay' && <span class="r">{readMinutes(e.body)} min</span>}
            </a>
          ))}
        </div>
      </section>
    ))}
    {/* Same rule as /essays/: no series, no by-date block. Six standalone
        pieces with no series would still produce two identical lists
        (round 8, R8-4, superseding the earlier count threshold). */}
    {series && series.parts.length > 1 && (
      <Timeline items={timelineItems} heading={labels.timelineHeading} />
    )}

    {entries.length === 0 && labels.leadersEmpty && <p class="empty-note">{labels.leadersEmpty}</p>}
  </section>
  <Signup />
</Base>
