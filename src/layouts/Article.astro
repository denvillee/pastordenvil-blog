---
import Shell from './Shell.astro';
import Mark from '../components/marks/Mark.astro';
import StickyNote from '../components/marks/StickyNote.astro';
import RelatedContent from '../components/RelatedContent.astro';
import Respond from '../components/Respond.astro';
import ReadAloud from '../components/ReadAloud.astro';
import { displayDate, isoDate, ROOMS, linkCitedBooks, type RoomKey } from '../lib/publish';
import { getPassages } from '../lib/bible';
import { enrich } from '../lib/enrich';
import site from '../data/site.json';
import labels from '../data/labels.json';

interface Sibling { k: string; t: string; m: string; href: string }
interface Props {
  room: RoomKey;
  title: string; dek: string; metaDescription?: string;
  /* Opt-in, per piece. See components/Respond.astro for why this is not a
     comments section and why Moments do not get one by default. */
  respond?: boolean;
  image?: string; imageAlt?: string;
  next?: { series: string; title: string; dek: string; href: string } | null;
  publishAt: Date; scripture?: string; series?: string;
  week?: number; idea?: string | null; movement?: string | null;
  seriesPlace?: { name: string; order: number; total: number } | null;
  readMinutes?: number; notes?: string;
  ogImage?: string; siblings?: Sibling[];
  /* One word in the title may be circled by hand, the way the references mark
     a heading. Optional and per piece, because which word carries the idea is
     an editorial judgement and not something a template can guess. */
  titleMark?: string;
  /* The artwork already sets the title. The h1 stays in the document for
     screen readers, search and the outline, and comes out of the picture. */
  titleInImage?: boolean;
  slug?: string;
}
const {
  room, title, dek, metaDescription, respond = false, image, imageAlt, next = null, publishAt, scripture, series,
  week, idea, movement, readMinutes, notes, ogImage, siblings = [], seriesPlace = null,
  titleMark, titleInImage = false, slug,
} = Astro.props;

/* Split the title around the marked word so the circle wraps just that word. */
const markIdx = titleMark ? title.toLowerCase().indexOf(titleMark.toLowerCase()) : -1;
const titleParts = markIdx >= 0
  ? [title.slice(0, markIdx), title.slice(markIdx, markIdx + titleMark!.length), title.slice(markIdx + titleMark!.length)]
  : null;

const meta = ROOMS[room];
/* Any book named in "Where this comes from" that is already on the Bookshelf
   becomes a link to its entry there, which is what makes Essays and Bookshelf
   feel like one site rather than two lists. */
const notesLinked = await linkCitedBooks(notes ?? '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: metaDescription ?? dek,
  datePublished: isoDate(publishAt),
  author: { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href },
  publisher: { '@type': 'Person', name: site.name },
  mainEntityOfPage: canonical,
};
const passages = await getPassages(scripture);

/* The writing is authored as plain markdown and designed here. enrich() finds
   the callouts and the scripture quotations in the rendered HTML and gives
   them the treatments the rest of the site uses. See lib/enrich.ts. */
/* Then every book named anywhere in the piece, footnotes included, becomes a
   link to its Bookshelf entry, the same way the notes block already works.
   Enrich first so a title inside a pulled quotation gets linked too. */
const prose = await linkCitedBooks(await enrich((await Astro.slots.render('default')) ?? ''));
---
<Shell
  title={`${title} · ${site.name}`}
  description={metaDescription ?? dek}
  ogType="article"
  ogImage={ogImage}
  publishedTime={isoDate(publishAt)}
  current={room}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>

  <article>
    <header class="read art-head">
      <div class="art-kicker">
        <span class={`type ${meta.cls}`}>{meta.label}</span>
        {week && <span class="wk">Season one &middot; week {week}{movement ? ` · ${movement}` : ''}</span>}
      </div>
      <h1 class:list={['art-title', 'is-display', titleInImage && 'vh']}>{titleParts
        ? <>{titleParts[0]}<span class="c">{titleParts[1]}<Mark kind="circle" color="yellow" draw={true} /></span>{titleParts[2]}</>
        : title}<span class="dot">.</span></h1>
      {!titleInImage && <p class="art-dek">{dek}</p>}
      <div class="art-meta">
        {/* The site's own mark rather than a photograph. A face at 30px is a
            smudge, it dates the moment the photograph does, and the name is
            already sitting right beside it. Decorative, so the alt is empty
            and a screen reader reads the name once, not twice. */}
        <img class="art-face" src="/assets/img/byline-mark.png" alt=""
             width="64" height="64" loading="lazy" decoding="async" />
        <span class="art-by">Denvil Lee</span>
        <span><time datetime={isoDate(publishAt)}>{displayDate(publishAt)}</time></span>
        {scripture && <span>{scripture}</span>}
        {readMinutes ? <span>{readMinutes} min read</span> : null}
        {/* The run's name, linking back to the whole list. It used to read
            "Part 1 of 2", and Denvil's 30 Aug package rules that out: these go
            out as standalone essays, with no chapter numbers and no language
            that makes the site look like a book being serialised. The name is
            the useful half anyway. */}
        {seriesPlace
          ? <span><a class="art-series" href={`/${meta.path}/#ser-h`}>{seriesPlace.name}</a></span>
          : series && <span>{series}</span>}
      </div>

      {/* The hero. It sits under the meta row rather than above the headline
          so that the first thing on the page is still the writing, and it only
          appears when the piece actually has art: a post with none runs
          text-only at the same measure rather than reaching for a stock
          picture. */}
      {image && (
        <figure class="art-hero">
          <img src={image} alt={imageAlt ?? ''} width="1536" height="1024"
               loading="eager" decoding="async" />
        </figure>
      )}

      {/* The opening passage uses the same control as every quotation in the
          body, so one choice moves the whole page. */}
      {passages.length > 0 && (
        <figure class="vs vs-head" data-vs data-ref={scripture}>
          {passages.map((p, i) => (
            <blockquote class="vs-pane" data-pane={p.code} hidden={i !== 0}>
              <p>{p.text}</p>
              {/* Named where it is quoted, the same as every passage in the
                  body. The NET's licence asks for this. */}
              {p.link && <p class="vs-src"><a href={p.link} rel="noopener">{p.label}</a></p>}
            </blockquote>
          ))}
          <blockquote class="vs-pane" data-pane="NLT" hidden>
            <p class="vs-wait">Loading the New Living Translation.</p>
            <p class="vs-src"><a href="https://www.newlivingtranslation.com" rel="noopener">New Living Translation</a></p>
          </blockquote>
          <figcaption class="vs-cite">
            <cite class="vs-ref">{scripture}</cite>
            <span class="vs-tabs" role="group" aria-label={`Translation for ${scripture}`}>
              {passages.map((p, i) => (
                <button type="button" class="vs-tab" data-vs-set={p.code} aria-pressed={i === 0 ? 'true' : 'false'}>{p.label}</button>
              ))}
              <button type="button" class="vs-tab" data-vs-set="NLT" aria-pressed="false">NLT</button>
            </span>
          </figcaption>
        </figure>
      )}
    </header>

    <div class="read">
      {idea && (
        <div class="idea-rail">
          <span class="k" set:html={labels.articleIdeaLabel}></span>
          <span class="v">{idea}</span>
        </div>
      )}

      {/* Above the writing, not floating over it: somebody who wants to
          listen decides that before they start reading, and somebody who does
          not should be able to ignore one quiet line. */}
      {ROOMS[room].listen && <ReadAloud piece={ROOMS[room].piece} />}

      <div class="prose" set:html={prose}></div>

      {notes && (
        <div class="notes-block">
          <h2>{labels.articleNotesHeading}</h2>
          <div set:html={notesLinked}></div>
        </div>
      )}

      <div class="art-end">
        <div class="share">
        <span class="lbl">{labels.articleShareLabel}</span>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${enc(canonical)}`} rel="noopener nofollow">Facebook</a>
        <a href={`https://x.com/intent/tweet?url=${enc(canonical)}&text=${enc(title)}`} rel="noopener nofollow">X</a>
        <a href={`mailto:?subject=${enc(title)}&body=${enc(canonical)}`}>Email</a>
        <a href={canonical} data-copy-link>Copy link</a>
        </div>

        {/* The comp closes a piece with a handwritten thanks and a drawn arrow
            pointing back at the share row. Its wording was "Thanks for reading!
            If this helped you, share it with a friend." — Denvil's own version of
            that sentence already exists, at the end of his For Leaders
            introduction, so his is used rather than the comp's. */}
        <p class="art-thanks">
          I hope this helps. If not, just share it with somebody you think it
          might benefit.
          <Mark kind="arrow-curl" color="ink" class="art-thanks-arw" />
        </p>
      </div>

      {/* The next essay in the run. It renders only when that essay is live,
          so the last piece published never shows a card pointing at nothing. */}
      {next && (
        <aside class="art-onward">
          <p class="art-onward-k">Next in {next.series}</p>
          <h2 class="art-onward-t"><a href={next.href}>{next.title}</a></h2>
          <p class="art-onward-d">{next.dek}</p>
          <p class="art-onward-a">
            <a class="btn btn-blue" href={next.href}>Continue the series <span class="arw" aria-hidden="true">&rarr;</span></a>
          </p>
        </aside>
      )}

      {/* Denvil's own invitation, on the pieces he is writing in public.
          Not a comments section and never labelled feedback: see
          components/Respond.astro. */}
      {respond && (
        <Respond variant={room === 'studies' ? 'studies' : 'essays'} title={title} url={canonical} />
      )}

      {/* An editorial invitation rather than a generic "thanks for reading".
          The two links are the ones a reader actually wants at the end of an
          essay: the books behind it, and the rest of the writing. */}
      <nav class="art-next" aria-label="Keep exploring">
        <h2 class="art-next-h">Keep exploring</h2>
        <ul>
          {ROOMS[room].sources && (
            <li><a class="go" href="/bookshelf/">See the books behind this {ROOMS[room].piece} <span class="arw" aria-hidden="true">&rarr;</span></a></li>
          )}
          <li><a class="go" href={`/${ROOMS[room].path}/`}>Back to {ROOMS[room].plural ?? ROOMS[room].label} <span class="arw" aria-hidden="true">&rarr;</span></a></li>
        </ul>
      </nav>

      {siblings.length > 0 && (
        <div class="week-rest">
          {siblings.map((s) => (
            <a href={s.href}>
              <span class="k">{s.k}</span>
              <span class="t">{s.t}</span>
              <span class="m">{s.m}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </article>

  <RelatedContent room={room} slug={slug} />
  {/* The Subscribe block was removed from every content page on 29 Aug.
      The site asked for an email too often. Subscribe now lives in one
      place: the masthead action, the footer link, and /subscribe/. */}
</Shell>

<script>
  import '../scripts/read-aloud.js';

  /* One translation choice for the whole page, remembered between visits.

     "As quoted" is the default and is what Denvil actually wrote: the other
     panes are an offer, not a correction, so a reader who never touches the
     control reads the essay exactly as he set it.

     The NLT is the one translation not written into the page. Tyndale permits
     displaying it and not storing it, so its pane ships empty and is filled
     from our own /api/nlt proxy when a reader asks for it, held for the life
     of the tab and gone when it closes. Same rule as the study site. */
  const KEY = 'dl.translation';
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-vs]'));

  if (groups.length) {
    const nltMemory = new Map<string, string>();

    const read = () => {
      try { return localStorage.getItem(KEY) || 'AS'; } catch { return 'AS'; }
    };

    async function fillNlt(group: HTMLElement) {
      const pane = group.querySelector<HTMLElement>('[data-pane="NLT"]');
      const ref = group.dataset.ref || '';
      if (!pane || !ref || pane.dataset.loaded === ref) return;
      try {
        let text = nltMemory.get(ref);
        if (text === undefined) {
          const res = await fetch('/api/nlt?ref=' + encodeURIComponent(ref), { cache: 'no-store' });
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          text = (data.verses || []).map((v: { t: string }) => v.t).join(' ');
          if (!text) throw new Error('empty');
          nltMemory.set(ref, text);
        }
        pane.textContent = '';
        const p = document.createElement('p');
        p.textContent = text;
        pane.appendChild(p);
        pane.dataset.loaded = ref;
      } catch {
        pane.textContent = '';
        const p = document.createElement('p');
        p.className = 'vs-wait';
        p.textContent = navigator.onLine
          ? 'The New Living Translation could not be loaded just now.'
          : 'The New Living Translation needs a connection.';
        pane.appendChild(p);
      }
    }

    function apply(code: string) {
      groups.forEach((group) => {
        const panes = Array.from(group.querySelectorAll<HTMLElement>('.vs-pane'));
        const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('.vs-tab'));
        /* A group that has no pane for this translation keeps its own first
           one, so a reference the build could not resolve never goes blank. */
        const has = panes.some((p) => p.dataset.pane === code);
        const shown = has ? code : (panes[0]?.dataset.pane ?? '');
        panes.forEach((p) => { p.hidden = p.dataset.pane !== shown; });
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.vsSet === shown)));
        if (shown === 'NLT') fillNlt(group);
      });
      try { localStorage.setItem(KEY, code); } catch {}
    }

    groups.forEach((group) => {
      group.querySelectorAll<HTMLButtonElement>('.vs-tab').forEach((btn) => {
        btn.addEventListener('click', () => apply(btn.dataset.vsSet || 'AS'));
      });
    });

    apply(read());
  }
</script>