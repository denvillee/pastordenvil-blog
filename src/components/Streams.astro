---
/*
  Three solid blocks, one per stream. They replace the bordered cards, which had
  become three thin objects adrift between two heavy neighbours once the band's
  heading came off (round 8, R8-1). Colour carries the weight the label used to.

  Each block is a whole-block link. The deks are Denvil's short lines from round
  7, unchanged; the sizing here is set so none of the three breaks with a single
  orphan word on the second line (round 8, R8-2).
*/
import labels from '../data/labels.json';

const rooms = [
  { name: labels.essaysHeading,  dek: labels.essaysDek,  href: '/essays/',  cls: 'rb-pine' },
  { name: labels.leadersHeading, dek: labels.leadersDek, href: '/leaders/', cls: 'rb-clay' },
  { name: labels.momentsHeading, dek: labels.momentsDek, href: '/moments/', cls: 'rb-sage' },
];
---
<section class="band shell rooms" id="streams">
  <div class="rb-grid">
    {rooms.map((r) => (
      <a class:list={['rb', r.cls]} href={r.href}>
        <span class="rb-name">{r.name}</span>
        {r.dek && <span class="rb-dek">{r.dek}</span>}
        <span class="rb-go" aria-hidden="true">Read &rarr;</span>
      </a>
    ))}
  </div>
</section>
