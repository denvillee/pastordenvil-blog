---
/*
  A directory of the three streams, not a feed. With little published, a
  "latest" feed can only echo the featured essay above it; a directory stays
  true at any content volume. Empty rooms simply say "Under construction." on
  arrival, per the standing rule.

  There is deliberately no heading over these cards. Each card already names
  itself and says what it holds, so a label announcing that they are sections
  told the reader something the cards were already showing. A hairline
  separates the band from the featured essay instead.

  The class names below are internal and keep the old word; nothing a reader
  ever sees says "rooms".
*/
import labels from '../data/labels.json';
/* Three, not four. Bookshelf came out: it is a STATE, one continuing thing
   with no feed, and its own band sits directly below this row, so it was on
   the page twice. A stream publishes discrete dated items, competes for the
   Latest slot and gets a card here; a state gets a band. */
const rooms = [
  { name: labels.essaysHeading, dek: labels.essaysDek, href: '/essays/' },
  { name: labels.leadersHeading, dek: labels.leadersDek, href: '/leaders/' },
  { name: labels.momentsHeading, dek: labels.momentsDek, href: '/moments/' },
];
---
<section class="band shell band-tight" id="streams">
  <hr class="band-rule" />
  <div class="rooms-dir">
    {rooms.map((r) => (
      <a class="room-link reveal" href={r.href}>
        <h3 class="rl-name">{r.name}</h3>
        {r.dek && <span class="rl-dek">{r.dek}</span>}
        <span class="rl-go" aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </div>
</section>
