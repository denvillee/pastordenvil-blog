---
import QuoteCard from './cards/QuoteCard.astro';
import VerseCard from './cards/VerseCard.astro';
import MemeCard from './cards/MemeCard.astro';
import TextThreadCard from './cards/TextThreadCard.astro';
import PosterCard from './cards/PosterCard.astro';
import StillCard from './cards/StillCard.astro';
import { KIT } from '../lib/kit';
interface Props { showLink?: boolean }
import home from '../data/home.json';
import labels from '../data/labels.json';
const { showLink = true } = Astro.props;
---
<section class="band kit" id="kit">
  <div class="shell">
    <div class="sec-head reveal">
      <h2>{labels.homeKitHeading}</h2>
      <span class="label" set:html={labels.homeKitLabel}></span>
    </div>
    <div class="kit-grid">
      <div class="reveal"><QuoteCard {...KIT.quote} /></div>
      <div class="reveal"><VerseCard {...KIT.verse} /></div>
      <div class="reveal"><MemeCard {...KIT.meme} /></div>
      <div class="reveal"><TextThreadCard {...KIT.thread} /></div>
      <div class="reveal"><PosterCard {...KIT.poster} /></div>
      <div class="reveal"><StillCard {...KIT.still} /></div>
    </div>
    <p class="kit-note reveal">
      <span set:html={home.kitNote}></span>
      {showLink && <a class="kit-link" href="/kit/" set:html={labels.homeKitLink}></a>}
    </p>
  </div>
</section>
