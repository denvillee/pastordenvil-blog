---
import labels from '../data/labels.json';
import { toSeconds, clockTime } from '../lib/publish';
/*
  Click to load. The poster is a still; the player is only built when somebody
  asks for it, so a page of talks does not open fifteen third-party players
  before a reader has chosen one. Until then the page contacts nobody.
*/
interface Props { entry: any; featured?: boolean }
const { entry, featured = false } = Astro.props;
/* The featured talk is the first thing under the page's h1, so it takes h2 and
   the rest of the grid sits at h3 under their year headings. */
const Tag = featured ? 'h2' : 'h3';
const d = entry.data;

/* Where the teaching begins inside the recording. Some of these are whole
   services and the sermon starts well in; see startsAt in content.config.ts. */
const startAt = toSeconds(d.startsAt);
const endAt = toSeconds(d.endsAt);

/* Vimeo's own embed address, taken from their share panel and their oEmbed
   response: app_id is the parameter their embed code carries. playsinline
   keeps a phone from throwing the video into the system fullscreen player the
   moment it starts, which is what happens without it on iOS.

   The two players take a start time differently. YouTube reads `start` (and
   `end`) as query parameters. Vimeo reads a `#t=` fragment and ignores a query
   parameter entirely, which is the kind of thing that looks like it works
   until you actually watch the video open at zero. */
const ytClip = `${startAt ? `&start=${startAt}` : ''}${endAt ? `&end=${endAt}` : ''}`;
const embed = d.provider === 'vimeo'
  ? `https://player.vimeo.com/video/${d.videoId}?app_id=122963&autoplay=1&playsinline=1&title=0&byline=0&portrait=0${startAt ? `#t=${startAt}s` : ''}`
  : `https://www.youtube-nocookie.com/embed/${d.videoId}?autoplay=1&playsinline=1&rel=0${ytClip}`;
/* Kept in the data model for attribution and maintenance. Deliberately not
   rendered as a link: a reader should never be pushed off the site to watch.
   It carries the start too, so a copied link lands in the same place. */
const sourceUrl = d.provider === 'vimeo'
  ? `https://vimeo.com/${d.videoId}${startAt ? `#t=${startAt}s` : ''}`
  : `https://www.youtube.com/watch?v=${d.videoId}${startAt ? `&t=${startAt}s` : ''}`;
/* A self-hosted stem, or a derived YouTube thumbnail for a YouTube entry. */
const localPoster = d.poster as string | undefined;
const remotePoster = !localPoster && d.provider === 'youtube'
  ? `https://i.ytimg.com/vi/${d.videoId}/hqdefault.jpg` : undefined;

/* The day it was given, spelled out. Where he was teaching leads the card, so
   this line only has to date it. */
const given = d.givenOn
  ? d.givenOn.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : undefined;

/* The length printed on the card is the length of the teaching. On a whole
   service that is the runtime from where the sermon starts to where it ends,
   not the runtime of the recording: a card promising a hundred minutes of a
   forty-minute sermon is a card nobody clicks. */
const runtime = d.durationSeconds
  ? Math.max(0, (endAt ?? d.durationSeconds) - (startAt ?? 0))
  : undefined;
const len = clockTime(runtime);
---
<article class:list={['vcard', featured && 'vcard-feat']}>
  <div class="vframe" data-embed={embed} data-title={d.title} data-source={sourceUrl} data-fallback={labels.watchFallback}>
    <button type="button" class="vplay" aria-label={`Play: ${d.title}`}>
      {localPoster ? (
        <picture>
          <source srcset={`/assets/img/${localPoster}.webp`} type="image/webp" />
          <img src={`/assets/img/${localPoster}.jpg`} alt="" width="1280" height="720"
               loading={featured ? 'eager' : 'lazy'} decoding="async" />
        </picture>
      ) : remotePoster ? (
        <img src={remotePoster} alt="" width="640" height="360"
             loading={featured ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
      ) : <span class="vposter-none" aria-hidden="true"></span>}
      <span class="vveil" aria-hidden="true"></span>
      <span class="vtri" aria-hidden="true">&#9654;</span>
      {len && <span class="vlen">{len}</span>}
    </button>
  </div>
  <div class="vmeta">
    {d.context && <p class="veyebrow">{d.context}</p>}
    <Tag class="vtitle">{d.title}</Tag>
    <p class="vsub">
      {d.givenOn
        ? <time datetime={d.givenOn.toISOString().slice(0, 10)}>{given}</time>
        : d.year}
    </p>
    {/* The card's action plays the video in place. The source address stays in
        the data for attribution and maintenance, and out of the interface. */}
    <button type="button" class="go vgo" data-play aria-label={`Play: ${d.title}`}>
      Watch now <span class="arw" aria-hidden="true">&rarr;</span>
    </button>
  </div>
</article>
