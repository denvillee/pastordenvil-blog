---
/*
  Explore by topic.

  Driven by real tags. A topic renders only when a published piece actually
  carries one of its tags, because a reader who clicks into an empty topic has
  been told something untrue about the site. The whole card hides itself when
  nothing qualifies, which is the state a thin archive should be in.
*/
import TopicIcon from './TopicIcon.astro';
import { live, type RoomKey } from '../lib/publish';
import data from '../data/topics.json';

interface Props { rooms?: RoomKey[] }
const { rooms = ['essays', 'leaders', 'moments'] } = Astro.props;

const all: any[] = [];
for (const r of rooms) all.push(...(await live(r)));

const topics = data.topics
  .map((t) => ({ ...t, n: all.filter((e) => (e.data.tags ?? []).some((g: string) => t.tags.some((x: string) => x.toLowerCase() === g.toLowerCase()))).length }))
  .filter((t) => t.n > 0);
---
{topics.length > 0 && (
  <section class="side-card" aria-labelledby="topics-h">
    <h2 class="side-h" id="topics-h">
      <span class="u">Explore by topic<span class="mk mk-underline mk-yellow" aria-hidden="true">
        <svg viewBox="0 0 200 12" fill="none" preserveAspectRatio="none"><path d="M3 8.4c22-3.1 46-4.9 71-5.2 31-.4 62 1.3 93 3.6 12 .9 22 1.9 30 2.8" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
      </span></span>
    </h2>
    <ul class="topics">
      {topics.map((t) => (
        <li>
          <a class="topic" href={`/topics/${t.slug}/`}>
            <span class:list={['tico-wrap', `tico-${t.tone}`]}><TopicIcon icon={t.icon as any} /></span>
            <span class="topic-txt">
              <strong>{t.label}</strong>
              <span>{t.dek}</span>
            </span>
            <span class="arw" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
