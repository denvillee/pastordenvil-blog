---
/*
  The Latest slot: the newest thing across essays, moments and For Leaders,
  whatever kind of thing it is. It sits ON the line where the hero ends, because
  a hard horizontal edge reads as a seam and an object crossing the line turns
  that seam into depth.

  Everything about it is type-aware except its geometry. The pill names the
  stream, the link says what you are about to read, and the metadata row is
  built from whatever the piece actually has. A Moment may carry a passage and
  no reading time; a For Leaders post may be a photograph and one idea with
  neither. Where there is nothing to say the row is not rendered, rather than
  rendered empty.

  The image is optional too. With none the card runs text-only at the same
  width. No placeholder: one stock picture standing in for every post is a
  placeholder whether or not it is pretty.
*/
import labels from '../data/labels.json';
import { ROOMS, type RoomKey } from '../lib/publish';

interface Props {
  room: RoomKey;
  href: string;
  title: string;
  dek: string;
  scripture?: string;
  readMinutes?: number;
  image?: string;
  imageAlt?: string;
  label?: string;
}
const {
  room, href, title, dek, scripture, readMinutes, image, imageAlt, label = 'Latest',
} = Astro.props;

const READ_LINK: Record<RoomKey, string> = {
  essays:  labels.latestReadEssay,
  moments: labels.latestReadMoment,
  leaders: labels.latestReadLeaders,
};

/* Only what the piece has. An empty row is worse than no row: it leaves a
   gap the reader reads as something failing to load. */
const meta = [scripture, readMinutes ? `${readMinutes} min` : null].filter(Boolean);
---
<section class="band feature-band" id="latest">
  <div class="shell">
    <div class:list={['feature-card', 'reveal', !image && 'is-textonly']}>
      <div class="feature">
        {image && (
          <div class="feature-media">
            <span class="sticker">{label}</span>
            <a href={href}>
              <img src={image} loading="lazy" decoding="async" alt={imageAlt ?? ''} />
            </a>
          </div>
        )}
        <div class="feature-body">
          <div class="meta">
            {/* With an image the freshness sticker sits on the picture. Without
                one it joins this row rather than stacking above it: as a second
                filled chip directly over the type pill it read as the same
                badge rendered twice, especially for For Leaders, which is the
                same ember. Here it is set as text, so the row says one thing
                of each kind: how fresh, then what kind, then the details. */}
            {!image && <span class="sticker-inline">{label}</span>}
            <span class:list={['pill', ROOMS[room].cls]}>{ROOMS[room].label}</span>
            {meta.map((m) => <span>{m}</span>)}
          </div>
          <h2><a href={href}>{title}</a></h2>
          <p class="dek">{dek}</p>
          <a class="readlink" href={href}>{READ_LINK[room]} <span>&rarr;</span></a>
        </div>
      </div>
    </div>
  </div>
</section>
