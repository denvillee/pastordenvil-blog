---
import { webpFor } from '../lib/img';
import labels from '../data/labels.json';
interface Clip {
  title: string; caption: string; durationSeconds: number;
  scripture?: string; poster: string; href: string;
}
interface Props { clips: Clip[]; note?: string }
const { clips, note } = Astro.props;
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
/* Highlight the last three words of the headline, the way a burned-in caption would. */
function split(line: string) {
  const w = line.split(' ');
  return w.length > 4 ? [w.slice(0, -3).join(' '), w.slice(-3).join(' ')] : ['', line];
}
---
<section class="band watch" id="watch">
  <div class="shell">
    <div class="sec-head reveal">
      <h2>{labels.homeWatchHeading}</h2>
      <span class="label" set:html={labels.homeWatchLabel}></span>
    </div>
    <div class="rail">
      {clips.map((c) => {
        const [head, tail] = split(c.title);
        const webp = webpFor(c.poster);
        return (
          <a class="clip reveal" href={c.href}>
            <picture>
              {webp && <source srcset={webp} type="image/webp" />}
              <img src={c.poster} alt="" width="540" height="960" loading="lazy" decoding="async" />
            </picture>
            <span class="veil"></span>
            <span class="play" aria-hidden="true">&#9654;</span>
            <span class="cap">
              <span class="burn">{head} <em>{tail}</em></span>
              <span class="len">{c.caption}</span>
              <span class="len">{mmss(c.durationSeconds)}{c.scripture ? ` · ${c.scripture}` : ''}</span>
            </span>
          </a>
        );
      })}
    </div>
    {note && <p class="watch-note reveal">{note}</p>}
  </div>
</section>
