---
import site from '../data/site.json';
import labels from '../data/labels.json';
const year = new Date().getFullYear();

/* Each publisher requires its notice only where its text is actually quoted.
   NET and WEB are always on; NIV/NASB need API_BIBLE_KEY and NLT needs
   NLT_API_KEY, so their notices appear the moment those keys are set and
   stay out of the footer until then. */
const apiBible = Boolean(process.env.API_BIBLE_KEY);
const nlt = Boolean(process.env.NLT_API_KEY);
---
<footer class="site-foot">
  <div class="shell foot-in">
    <div class="foot-col">
      <span class="brand-foot">DENVIL<i>.</i>LEE</span>
      <p>{site.footerBlurb}</p>
    </div>
    <div class="foot-col">
      <span class="foot-h">{labels.footRoomsHeading}</span>
      <a href="/essays/">{labels.footEssays}</a>
      <a href="/leaders/">{labels.footLeaders}</a>
      <a href="/moments/">{labels.footMoments}</a>
      <a href="/studies/">{labels.footStudies}</a>
      <a href="/frameworks/">{labels.footFrameworks}</a>
      <a href="/watch/">{labels.footWatch}</a>
      <a href="/bookshelf/">{labels.footReading}</a>
      <a href="/archive/">{labels.footArchive}</a>
    </div>
    <div class="foot-col">
      <span class="foot-h">{labels.footElsewhereHeading}</span>
      <a href="/about/">{labels.footAbout}</a>
      <a href="/speaking/">{labels.footSpeaking}</a>
      <a href="/subscribe/">{labels.footSubscribe}</a>
      <a href="/rss.xml">{labels.footRss}</a>
    </div>
  </div>
  <div class="shell foot-legal">
    <span>&copy; {year} {site.name}</span>
    <span>{site.footerLine}</span>
  </div>
  <div class="shell foot-legal foot-scripture">
    {apiBible && (
      <span>Scripture quotations marked (NIV) are from The Holy Bible, New International Version&reg; NIV&reg;
        Copyright &copy;1973, 1978, 1984, 2011 by Biblica, Inc.&trade; Used by permission. All rights reserved worldwide.</span>
    )}
    <span>Quotations designated (NET) are from the NET Bible&reg; copyright &copy;1996, 2019 by Biblical Studies
      Press, L.L.C. <a href="https://netbible.com" rel="noopener">netbible.com</a>. All rights reserved.</span>
    {nlt && (
      <span>Scripture quotations marked (NLT) are taken from the Holy Bible, New Living Translation, copyright
        &copy;1996, 2004, 2015 by Tyndale House Foundation. Used by permission of Tyndale House Publishers, Inc.,
        Carol Stream, Illinois 60188. All rights reserved.</span>
    )}
    {apiBible && (
      <span>Scripture quotations marked (NASB) are taken from the New American Standard Bible&reg;, Copyright
        &copy;1960, 1971, 1977, 1995, 2020 by The Lockman Foundation. Used by permission.
        <a href="https://www.lockman.org" rel="noopener">www.lockman.org</a></span>
    )}
    <span>Quotations marked (WEB) are from the World English Bible, a public domain translation.</span>
  </div>
</footer>
