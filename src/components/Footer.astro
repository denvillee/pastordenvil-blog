---
/*
  Three columns, named for what they hold. The old "Elsewhere" heading sat over
  a list of internal links, which told a reader the opposite of the truth.
*/
import Wordmark from './Wordmark.astro';
import Mark from './marks/Mark.astro';
import site from '../data/site.json';
import labels from '../data/labels.json';

const cols = [
  { heading: 'Writing', items: [
    { href: '/essays/',  label: labels.footEssays },
    { href: '/leaders/', label: labels.footLeaders },
    { href: '/moments/', label: labels.footMoments },
  ]},
  { heading: 'Resources', items: [
    { href: '/studies/',   label: labels.footStudies },
    { href: '/bookshelf/', label: labels.footReading },
    { href: '/watch/',     label: labels.footWatch },
  ]},
  { heading: 'Connect', items: [
    { href: '/about/',     label: labels.footAbout },
    { href: '/speaking/',  label: 'Speaking + Coaching' },
    { href: '/subscribe/', label: labels.footSubscribe },
    { href: `mailto:${site.contactEmail}`, label: 'Contact' },
  ]},
];
const year = new Date().getFullYear();
---
<footer class="foot">
  <Mark kind="brush" color="coral" class="foot-brush" />
  <div class="shell foot-in">
    <div class="foot-brand">
      <Wordmark />
      <p>{site.footerBlurb}</p>
    </div>

    {cols.map((c) => (
      <nav class="foot-col" aria-label={c.heading}>
        <h2>{c.heading}</h2>
        <ul>{c.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>

  <div class="shell foot-base">
    <p>&copy; {year} {site.name}. <a href="/rss.xml">{labels.footRss}</a></p>
    {/* One line in the footer, not two. The blurb above already carries it. */}
  </div>

  <div class="shell foot-legal">
    <p>Quotations designated (NET) are from the NET Bible&reg; copyright &copy;1996, 2019 by Biblical Studies Press, L.L.C. <a href="https://netbible.com" rel="noopener">netbible.com</a>. All rights reserved.</p>
    <p>Quotations marked (WEB) are from the World English Bible, a public domain translation.</p>
  </div>
</footer>
