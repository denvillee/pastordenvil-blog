---
/*
  The "why this room exists" copy that sits between a section's subtitle and
  its post list. Denvil's own words, 250 to 400 of them.

  The first paragraph is always visible; the rest opens behind a control. A
  first-time visitor reads it, a regular coming back to see what is new steps
  over it, and nobody has to decide which of the two the page is written for.

  Native <details>, so it works with no JavaScript and stays keyboard
  reachable. Both matter here: the site ships a CSP with script-src 'self'.
*/
import { getEntry, render } from 'astro:content';

interface Props { room: string; label?: string }
const { room, label = 'Why this exists' } = Astro.props;

const entry = await getEntry('landing', room);
const Content = entry ? (await render(entry)).Content : null;
---
{entry && Content && (
  <div class="landing">
    <p class="landing-lead">{entry.data.lead}</p>
    <details class="landing-more">
      <summary class="landing-toggle"><span>{label}</span></summary>
      <div class="landing-rest"><Content /></div>
    </details>
  </div>
)}
