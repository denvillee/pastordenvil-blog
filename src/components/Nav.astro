---
import labels from '../data/labels.json';
/* Round 9 gives the home page a masthead rather than a bar: it sits straight on
   the pine hero with no background of its own, and Subscribe joins the list
   instead of being a button. It is the same component and the same links, worn
   differently, so the two can never drift apart. Every other page keeps the bar
   until the alignment pass. */
interface Props { masthead?: boolean }
const { masthead = false } = Astro.props;
/* The bar is the home page scroll order, in the same words. Denvil, 26 Aug:
   the name of the section has to match the CMS and the address, and the tabs
   have to run in the same order as the page. Change one, change all three. */
const links = [
  { label: labels.navEssays, href: '/essays/' },
  { label: labels.navLeaders, href: '/leaders/' },
  { label: labels.navMoments, href: '/moments/' },
  { label: labels.navStudies, href: '/studies/' },
  { label: labels.navReading, href: '/bookshelf/' },
];
/* Frameworks was retired on 28 Aug: the room is gone and /frameworks/ 301s to
   /essays/. The drawings did not go with it. Every essay, leaders piece and
   moment can name a diagram in its `diagram` field and it renders inline, which
   is where they always read better than in a room of their own. */
/* The rooms live in the bar on desktop; the standing pages only ever appear in the
   mobile panel and the footer, so the bar stays short. */
const standing = [
  { label: labels.navWatch, href: '/watch/' },
  { label: labels.navAbout, href: '/about/' },
  { label: labels.navSpeaking, href: '/speaking/' },
  { label: labels.navArchive, href: '/archive/' },
];
---
<nav class:list={["nav", masthead && "nav-mast"]}>
  <div class="nav-in">
    <a class="brand" href="/">DENVIL<i>.</i>LEE</a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    {masthead
      ? <a class="nav-sub" href="/subscribe/">{labels.navCta}</a>
      : <a class="nav-cta" href="/subscribe/">{labels.navCta}</a>}
    <button
      class="nav-burger"
      id="nav-burger"
      type="button"
      aria-controls="nav-panel"
      aria-expanded="false"
      aria-label="Menu"
    >
      <span class="nav-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </div>
  <div class="nav-panel" id="nav-panel">
    <div class="nav-panel-clip">
      <div class="nav-panel-in">
        {[...links, ...standing].map((l) => <a href={l.href}>{l.label}</a>)}
        {/* One page, one treatment: where the masthead shows Subscribe as a
            plain link, the mobile panel does too, rather than the same page
            offering a brass button at one width and a link at another. */}
        {masthead
          ? <a href="/subscribe/">{labels.navCta}</a>
          : <a class="nav-cta" href="/subscribe/">{labels.navCta}</a>}
      </div>
    </div>
  </div>
</nav>

<script>
  /* mobile menu */
  (function () {
    const btn = document.getElementById('nav-burger');
    const panel = document.getElementById('nav-panel');
    if (!btn || !panel) return;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.classList.toggle('open', open);
    };

    btn.addEventListener('click', () => {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });

    /* a link closes it, so the panel never covers the page you just asked for */
    panel.addEventListener('click', (e) => {
      const t = e.target as HTMLElement | null;
      if (t && t.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      btn.focus();
    });

    /* resizing past the breakpoint hides the panel, so reset the button with it */
    const wide = window.matchMedia('(min-width:861px)');
    const sync = () => { if (wide.matches) setOpen(false); };
    if (wide.addEventListener) wide.addEventListener('change', sync);
    else (wide as MediaQueryList).addListener(sync);
  })();
</script>
