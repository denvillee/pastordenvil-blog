---
/* The collection a piece belongs to. Nothing more.

   Denvil, 3 Sep: the site is "a collection of standalone essays", not a book
   published a chapter at a time. So this prints the name and stops. No part
   number, no count, no "start at part 1" - every one of those said serial, and
   a reader arriving at any essay should find a whole thing, not an instalment.

   The manuscript order still exists; it lives on `bookChapter` and is rendered
   only behind /studio/book/, which is private and noindexed.
*/
interface Props { room: any; data: any; }
const { data } = Astro.props;
const name = data?.series;
---
{name && (
  <p class="stag">
    <span class="stag-name">{name}</span>
  </p>
)}
