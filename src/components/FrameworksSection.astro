---
import TwoAges from './diagrams/TwoAges.astro';
interface Item { order: number; title: string; summary: string; href?: string; live: boolean }
interface Props { items: Item[]; caption: string; lead: string }
import home from '../data/home.json';
import labels from '../data/labels.json';
const { items, caption, lead } = Astro.props;
---
<section class="band shell" id="frameworks">
  <div class="sec-head reveal">
    <h2>{labels.homeFrameworksHeading}</h2>
    <span class="label" set:html={labels.homeFrameworksLabel}></span>
  </div>
  <div class="fw">
    <figure class="fw-fig reveal">
      <TwoAges />
      <figcaption set:html={caption}></figcaption>
    </figure>
    <div class="fw-body">
      <p class="fw-lead" set:html={lead}></p>
      {items.length > 0 && (
        <ol class="fw-list">
          {items.map((f) => (
            <li>
              <span class="n">{String(f.order).padStart(2, '0')}</span>
              <span class="t">
                {f.live && f.href ? <a href={f.href}>{f.title}</a> : f.title}
                <span class="s">{f.summary}</span>
              </span>
            </li>
          ))}
        </ol>
      )}
      <p class="fw-park" set:html={home.frameworksParked}></p>
    </div>
  </div>
</section>
