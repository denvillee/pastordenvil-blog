---
/*
  A book. The cover is a real image and its alt text names the book and the
  author, because "Image" tells a reader who cannot see it nothing at all.
  The line underneath is Denvil's own, set in the handwritten face.
*/
interface Props { book: any; note?: string }
const { book, note } = Astro.props;
const b = book.data ?? book;
const line = note ?? (book.body?.trim() ?? '');
const TONE: Record<string, string> = {
  cobalt: 'blue', ivy: 'green', brass: 'yellow', ember: 'coral', ink: 'blue',
};
const rule = TONE[b.spine] ?? 'blue';
---
<article class="bcard">
  <div class="bcard-top">
    {b.cover
      ? <img class="bcover" src={b.cover} alt={`Cover of ${b.title} by ${b.author}.`}
             width="200" height="300" loading="lazy" decoding="async" />
      : <span class:list={['bcover', 'bcover-none', `spine-${b.spine}`]} aria-hidden="true"></span>}
    <div class="bmeta">
      <h3 class="btitle">{b.title}</h3>
      <p class="bauthor">{b.author}{b.year ? ` · ${b.year}` : ''}</p>
      {b.progress && <p class="bprog">{b.progress}</p>}
    </div>
  </div>
  {line && (
    <p class="btake">
      <span class:list={['u', 'btake-u']} set:html={line}></span>
      <span class:list={['btake-rule', `rule-${rule}`]} aria-hidden="true"></span>
    </p>
  )}
</article>
