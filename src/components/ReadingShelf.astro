---
import labels from '../data/labels.json';
interface Book {
  title: string; author: string; year?: number; progress?: string;
  spine: string; note: string; link: string; shelfStatus: string;
}
interface Props { now?: Book; shelf: Book[]; tie: string }
const { now, shelf, tie } = Astro.props;

/* The bar has to mean something. "Chapter 6 of 12", "6 of 12" and "62%" all parse;
   anything else gets the words on their own and no bar at all. */
function progressPct(s?: string): number | null {
  if (!s) return null;
  const pct = s.match(/(\d{1,3}(?:\.\d+)?)\s*%/);
  if (pct) {
    const v = Number(pct[1]);
    return v >= 0 && v <= 100 ? v : null;
  }
  const of = s.match(/(\d+(?:\.\d+)?)\s+of\s+(\d+(?:\.\d+)?)/i);
  if (of) {
    const done = Number(of[1]);
    const total = Number(of[2]);
    if (total > 0 && done >= 0 && done <= total) return (done / total) * 100;
  }
  return null;
}
const pct = progressPct(now?.progress);
const hasBooks = Boolean(now) || shelf.length > 0;
---
<section class="band shell" id="reading">
  <div class="sec-head reveal">
    <h2>{labels.readingHeading}</h2>
    <span class="label">{labels.readingLabel}</span>
  </div>
  {hasBooks ? (
    <div class={now ? 'read' : 'read read-solo'}>
      {now && (
        <div class="now-read reveal">
          <span class={`spine sp-${now.spine}`}><span>{now.title}</span></span>
          <span class="bk">
            <span class="ba">{labels.readingNowLabel}</span>
            <span class="bt">{now.link ? <a href={now.link} rel="noopener">{now.title}</a> : now.title}</span>
            <span class="ba" style="letter-spacing:.08em">{now.author}{now.year ? ` · ${now.year}` : ''}</span>
            <span class="bn" set:html={now.note}></span>
            {now.progress && (
              <>
                {pct !== null && <span class="bar"><i style={`width:${pct.toFixed(1)}%`}></i></span>}
                <span class="bar-l">{now.progress}</span>
              </>
            )}
          </span>
        </div>
      )}
      <div class="reveal">
        {shelf.length > 0 && (
          <div class="shelf">
            {shelf.map((b) => (
              <div class="shelf-row">
                <span class={`mini sp-${b.spine}`}></span>
                <span>
                  <span class="st">{b.title}<span class="sa">{b.author}</span></span>
                  <span class="sv" set:html={b.note}></span>
                </span>
              </div>
            ))}
          </div>
        )}
        <p class="read-tie" set:html={tie}></p>
      </div>
    </div>
  ) : (
    <p class="art-dek reveal">{labels.readingEmpty}</p>
  )}
</section>
