---
import { ROOMS } from '../lib/content';
const path = Astro.url.pathname;
const links = Object.entries(ROOMS).map(([k, v]) => ({ href: v.path + '/', label: v.label }));
links.push({ href: '/reading/', label: 'Reading' });
const active = (h: string) => path === h || (h !== '/' && path.startsWith(h));
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href="/">Denvil&nbsp;Lee</a>

    <input type="checkbox" id="nav" class="visually-hidden" />
    <label for="nav" class="hdr__burger"><span aria-hidden="true"></span><span class="visually-hidden">Menu</span></label>

    <nav class="hdr__nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['hdr__link', { 'is-on': active(l.href) }]}>{l.label}</a>
      ))}
      <a href="/speaking/" class:list={['hdr__link', { 'is-on': active('/speaking/') }]}>Speaking</a>
      <a href="/subscribe/" class="btn btn--primary hdr__cta">Subscribe</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 60;
    background: color-mix(in srgb, var(--ground) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .hdr__in { display: flex; align-items: center; gap: 1rem; min-height: 66px; flex-wrap: wrap; }
  .hdr__brand {
    font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em;
    font-variation-settings: "wdth" 92; text-decoration: none;
  }
  .hdr__nav { display: flex; align-items: center; gap: 1.35rem; margin-left: auto; }
  .hdr__link {
    font-size: 0.9rem; font-weight: 500; text-decoration: none; color: var(--fg-muted);
    padding-block: 0.35rem; border-bottom: 1.5px solid transparent;
    transition: color var(--dur-fast) var(--ease);
  }
  .hdr__link:hover { color: var(--fg); }
  .hdr__link.is-on { color: var(--fg); border-bottom-color: var(--accent); }
  .hdr__cta { padding: 0.5rem 1.05rem; }
  .hdr__burger { display: none; }

  @media (max-width: 940px) {
    .hdr__burger {
      display: grid; place-items: center; width: 42px; height: 42px;
      margin-left: auto; cursor: pointer;
      border: 1px solid var(--line-strong); border-radius: var(--radius);
    }
    .hdr__burger span[aria-hidden] {
      width: 17px; height: 1.5px; background: var(--fg);
      box-shadow: 0 -5px 0 var(--fg), 0 5px 0 var(--fg);
    }
    #nav:focus-visible + .hdr__burger { outline: 2px solid var(--accent); outline-offset: 3px; }
    .hdr__nav { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0; padding-bottom: 1rem; }
    #nav:checked ~ .hdr__nav { display: flex; }
    .hdr__link { padding: 0.8rem 0; border-bottom: 1px solid var(--line); }
    .hdr__cta { margin-top: 1rem; justify-content: center; }
  }
</style>
