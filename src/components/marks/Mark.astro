---
/*
  The hand-drawn marks, all in one place.

  Every one of these is an inline SVG with a deliberately uneven path. The
  wobble is the whole point: a geometrically perfect underline reads as a
  border and the personality goes out of it. The paths were drawn off-axis on
  purpose, so do not "tidy" the coordinates.

  All marks are decorative. They carry aria-hidden and never hold meaning that
  is not also in the text, which is why colour alone never says anything here.

  `draw` opts a mark into the one-time draw-on animation. It is off by default
  and disabled entirely under prefers-reduced-motion.
*/
type MarkKind =
  'underline' | 'underline-double' | 'circle' | 'circle-loose' |
  'brush' | 'zigzag' | 'arrow' | 'arrow-curl' | 'star' | 'asterisk';

interface Props {
  kind: MarkKind;
  color?: 'blue' | 'yellow' | 'coral' | 'green' | 'ink';
  draw?: boolean;
  class?: string;
}
const { kind, color = 'blue', draw = false, class: cls = '' } = Astro.props;

/* viewBox, path(s), stroke width. Fill marks carry fill:true. */
const M: Record<string, { vb: string; d: string[]; w: number; fill?: boolean }> = {
  underline: { vb: '0 0 200 12', w: 5, d: [
    'M3 8.4c22-3.1 46-4.9 71-5.2 31-.4 62 1.3 93 3.6 12 .9 22 1.9 30 2.8',
  ]},
  'underline-double': { vb: '0 0 200 16', w: 4, d: [
    'M3 6.5c24-3 50-4.6 76-4.8 30-.3 60 1.2 90 3.3 12 .8 22 1.8 31 2.7',
    'M9 13.2c25-2.2 51-3.3 77-3.4 26 0 52 .9 78 2.4',
  ]},
  circle: { vb: '0 0 220 90', w: 5, d: [
    'M112 6C71 4 30 15 15 33 2 49 14 70 44 79c34 10 87 9 126-3 24-8 37-21 33-35C198 22 160 9 112 6z',
  ]},
  'circle-loose': { vb: '0 0 240 100', w: 5, d: [
    'M120 7C74 3 28 16 13 36 1 52 12 74 45 85c37 12 96 11 138-3 27-9 42-24 37-40C214 24 172 11 120 7z',
    'M45 85c-9-4-17-9-22-16',
  ]},
  /* Torn rather than rounded. The edges step in and out at uneven intervals,
     which is what makes it read as a stroke of paint or a piece of paper and
     not as a div with a border-radius. */
  brush: { vb: '0 0 120 160', w: 0, fill: true, d: [
    'M14 4c16 3 30-2 44 1 13 3 26-1 38 4 6 3 3 14 6 22 4 11-2 21 1 31 3 12-4 22-1 34 3 13-1 24 1 36 1 9 4 20-3 23-13 5-28-2-42 1-12 3-24-1-36 2-9 2-19 3-22-4-5-12 1-26-2-38-3-13 2-25-1-38-3-14 3-27 0-40-2-9-2-21 4-24 4-2 9-11 13-10z',
  ]},
  zigzag: { vb: '0 0 90 120', w: 6, d: [
    'M10 8 78 30 12 52l68 22-68 22 68 22',
  ]},
  arrow: { vb: '0 0 120 60', w: 4, d: [
    'M6 40c22-16 52-27 92-30',
    'M84 4l16 6-10 14',
  ]},
  'arrow-curl': { vb: '0 0 110 90', w: 4, d: [
    'M14 8c30 6 52 22 60 44 4 12 1 24-8 30',
    'M56 78l10 6 2-16',
  ]},
  star: { vb: '0 0 60 60', w: 4, d: [
    'M30 6v48M9 18l42 24M51 18L9 42',
  ]},
  asterisk: { vb: '0 0 48 48', w: 4, d: [
    'M24 5v38M8 13l32 22M40 13L8 35',
  ]},
};

const m = M[kind];
---
<!--
  The whole mark is emitted on one line on purpose. Astro preserves whitespace
  inside an element, so a newline between <span> and <svg> becomes a real text
  node in the mark. It is invisible, because the mark is absolutely positioned
  and aria-hidden, but it is still IN THE TEXT: textContent came back as
  "ordinary life    ." and innerText as "ordinary life\n." Anything that reads
  the text rather than the pixels, a screen reader, reader mode, an RSS or
  meta-description extractor, a search snippet, a translator, sees a space
  before every comma and full stop that follows a marked phrase. That is the
  punctuation defect Denvil kept reporting and that a geometry test cannot see.
--><span class:list={['mk', `mk-${kind}`, `mk-${color}`, draw && 'mk-draw', cls]} aria-hidden="true"><svg viewBox={m.vb} fill="none" preserveAspectRatio="none" focusable="false">{m.d.map((d) => (m.fill ? <path d={d} fill="currentColor" /> : <path d={d} stroke="currentColor" stroke-width={m.w} stroke-linecap="round" stroke-linejoin="round" />))}</svg></span>
