---
/*
  The hand-drawn marks, all in one place.

  Every one of these is an inline SVG with a deliberately uneven path. The
  wobble is the whole point: a geometrically perfect underline reads as a
  border and the personality goes out of it. The paths were drawn off-axis on
  purpose, so do not "tidy" the coordinates.

  All marks are decorative. They carry aria-hidden and never hold meaning that
  is not also in the text, which is why colour alone never says anything here.

  `draw` opts a mark into the one-time draw-on animation. It is off by default
  and disabled entirely under prefers-reduced-motion.
*/
type MarkKind =
  'underline' | 'underline-double' | 'circle' | 'circle-loose' |
  'brush' | 'zigzag' | 'spiral' | 'scribble' | 'paint' | 'sprinkle' |
  'arrow' | 'arrow-curl' | 'loop' | 'star' | 'asterisk';

interface Props {
  kind: MarkKind;
  color?: 'blue' | 'yellow' | 'coral' | 'green' | 'ink' | 'white';
  draw?: boolean;
  class?: string;
}
const { kind, color = 'blue', draw = false, class: cls = '' } = Astro.props;

/* viewBox, path(s), stroke width. Fill marks carry fill:true. `fixed` marks
   keep their aspect ratio: everything else is stretched to whatever box it is
   given, which is fine for a stroke and wrong for a field of round dots. */
const M: Record<string, { vb: string; d: string[]; w: number; fill?: boolean; fixed?: boolean }> = {
  underline: { vb: '0 0 200 12', w: 5, d: [
    'M3 8.4c22-3.1 46-4.9 71-5.2 31-.4 62 1.3 93 3.6 12 .9 22 1.9 30 2.8',
  ]},
  'underline-double': { vb: '0 0 200 16', w: 4, d: [
    'M3 6.5c24-3 50-4.6 76-4.8 30-.3 60 1.2 90 3.3 12 .8 22 1.8 31 2.7',
    'M9 13.2c25-2.2 51-3.3 77-3.4 26 0 52 .9 78 2.4',
  ]},
  circle: { vb: '0 0 220 90', w: 5, d: [
    'M112 6C71 4 30 15 15 33 2 49 14 70 44 79c34 10 87 9 126-3 24-8 37-21 33-35C198 22 160 9 112 6z',
  ]},
  'circle-loose': { vb: '0 0 240 100', w: 5, d: [
    'M120 7C74 3 28 16 13 36 1 52 12 74 45 85c37 12 96 11 138-3 27-9 42-24 37-40C214 24 172 11 120 7z',
    'M45 85c-9-4-17-9-22-16',
  ]},
  /* Torn rather than rounded. The edges step in and out at uneven intervals,
     which is what makes it read as a stroke of paint or a piece of paper and
     not as a div with a border-radius. */
  brush: { vb: '0 0 120 160', w: 0, fill: true, d: [
    'M14 4c16 3 30-2 44 1 13 3 26-1 38 4 6 3 3 14 6 22 4 11-2 21 1 31 3 12-4 22-1 34 3 13-1 24 1 36 1 9 4 20-3 23-13 5-28-2-42 1-12 3-24-1-36 2-9 2-19 3-22-4-5-12 1-26-2-38-3-13 2-25-1-38-3-14 3-27 0-40-2-9-2-21 4-24 4-2 9-11 13-10z',
  ]},
  /* A coil, the way you doodle a spring in a margin. Four loops, each a little
     smaller and each dropping further left, so it leans rather than stacks.
     Denvil's layout map puts one of these at the left edge of the Grab your
     Bibles band. */
  spiral: { vb: '0 0 62 132', w: 5, d: [
    'M50 12a19 12.5 0 1 0-9 21a18 12 0 1 0-7 21a17 11.5 0 1 0-6 21a16 11 0 1 0-3 19',
  ]},
  /* ── from Denvil's decorative kit, 2 Sep ──────────────────────────────
     The kit arrived as 26 flat SVG files with the colours baked in. The
     shapes below are the ones worth having and they are redrawn here instead,
     inline and on the site's own tokens, so a palette change stays a
     one-file change and the draw-on animation still applies. See
     claude/decorative-kit-2-sep.md for what was taken and what was not. */

  /* The kit's big scribble: five bold strokes doubling back on themselves.
     Flatter and far more confident than `zigzag`, which is why both stay. */
  scribble: { vb: '0 0 120 120', w: 9, d: [
    'M12 12C42 5 88 17 103 30 76 26 43 31 18 44c29-7 66-3 88 11-30-3-62 3-91 15 28-6 63-1 86 13-27-4-58 3-81 19',
  ]},
  /* A wide stroke of paint, for putting behind an object. */
  paint: { vb: '0 0 280 110', w: 0, fill: true, d: [
    'M8 49C24 28 51 25 81 28c21-10 70-11 99-3 28-6 63 1 85 13-18 8-37 13-56 18 24 2 42 8 58 17-23 6-53 5-77 10-36 6-73 6-107 3-30 5-56-4-73-12 10-8 23-15 36-20-16 1-28 0-38-5z',
  ]},
  /* A scatter of specks thrown off a paint stroke. Fixed ratio: round dots
     stretched into ellipses stop reading as a spray. */
  sprinkle: { vb: '0 0 120 60', w: 0, fill: true, fixed: true, d: [
    'M9 41a2.2 2.2 0 1 0 .1 0zM21 25a1.7 1.7 0 1 0 .1 0zM26 49a1.2 1.2 0 1 0 .1 0zM34 33a2.4 2.4 0 1 0 .1 0zM41 13a1.6 1.6 0 1 0 .1 0zM47 52a2 2 0 1 0 .1 0zM55 27a1.3 1.3 0 1 0 .1 0zM62 43a2.3 2.3 0 1 0 .1 0zM69 9a1.7 1.7 0 1 0 .1 0zM74 34a1.2 1.2 0 1 0 .1 0zM81 51a2.1 2.1 0 1 0 .1 0zM88 21a1.6 1.6 0 1 0 .1 0zM95 40a2.4 2.4 0 1 0 .1 0zM103 12a1.4 1.4 0 1 0 .1 0zM108 46a1.9 1.9 0 1 0 .1 0zM114 29a1.3 1.3 0 1 0 .1 0z',
  ]},
  /* An arrow that loops once before it points. */
  loop: { vb: '0 0 120 100', w: 5.5, d: [
    'M10 54c22-14 50-12 65 1s3 28-13 24c-15-3-9-20 11-22 15-1 26 4 36 12',
    'M98 57l13 12-15 8',
  ]},
  zigzag: { vb: '0 0 90 120', w: 6, d: [
    'M10 8 78 30 12 52l68 22-68 22 68 22',
  ]},
  arrow: { vb: '0 0 120 60', w: 4, d: [
    'M6 40c22-16 52-27 92-30',
    'M84 4l16 6-10 14',
  ]},
  'arrow-curl': { vb: '0 0 110 90', w: 4, d: [
    'M14 8c30 6 52 22 60 44 4 12 1 24-8 30',
    'M56 78l10 6 2-16',
  ]},
  star: { vb: '0 0 60 60', w: 4, d: [
    'M30 6v48M9 18l42 24M51 18L9 42',
  ]},
  asterisk: { vb: '0 0 48 48', w: 4, d: [
    'M24 5v38M8 13l32 22M40 13L8 35',
  ]},
};

const m = M[kind];
---
{/* The whole mark is emitted on one line on purpose: a newline between the
  wrapper and the svg would become a real text node inside the marked phrase,
  which readers, screen readers and search snippets would see as a space before
  the punctuation that follows. */}<span class:list={['mk', `mk-${kind}`, `mk-${color}`, draw && 'mk-draw', cls]} aria-hidden="true"><svg viewBox={m.vb} fill="none" preserveAspectRatio={m.fixed ? "xMidYMid meet" : "none"} focusable="false">{m.d.map((d) => (m.fill ? <path d={d} fill="currentColor" /> : <path d={d} stroke="currentColor" stroke-width={m.w} stroke-linecap="round" stroke-linejoin="round" />))}</svg></span>
