---
/*
  A sketched line icon in a coloured disc.

  This is the backbone device of the comps: every taxonomy on every page —
  topics, themes, study steps, categories — is a filled pastel circle with a
  hand-drawn icon inside it, and the colour rotates blue → yellow → coral →
  green down the row. That rotation is why unrelated sections still read as one
  system.

  `CategoryIcon` already drew exactly this, but it was hard-wired to the five
  rooms and shipped on two pages. This is the same drawing style opened up: name
  the icon, name the tone. The paths are drawn here rather than pulled from an
  icon set for the reason the original comment gave, which still holds — a
  library would give neat pictograms in somebody else's house style, and these
  want to look sketched.

  Every glyph is drawn on the same 48-unit box at the same 2.4 stroke, so a row
  of them sits on one optical weight.
*/
interface Props {
  name: string;
  tone?: 'blue' | 'yellow' | 'coral' | 'green';
  class?: string;
}
const { name, tone = 'blue', class: cls = '' } = Astro.props;

