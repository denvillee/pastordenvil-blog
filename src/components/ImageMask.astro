---
/*
  The irregular photo mask.

  The references never show a plain rectangle: every photograph has a softly
  torn or organic edge. Done with border-radius on four uneven corners rather
  than an SVG clip-path, because a clip-path kills the drop shadow and this
  needs to sit on a coloured ground and still read as an object.

  `slot` takes the picture so a caller can supply <picture> with WebP sources.

  `tape` sticks a strip over one corner. The design board tapes its
  photographs down and the component for it had been built and then used on
  precisely nothing, so every picture on the site was reading as a placed
  rectangle rather than as something pinned to the page. One corner only, and
  never on a card small enough for the strip to cover the subject.
*/
import Tape from './marks/Tape.astro';
interface Props {
  shape?: 'organic' | 'torn' | 'soft';
  tape?: 'blue' | 'coral' | 'yellow' | 'neutral';
  tapeAt?: 'tl' | 'tr';
  class?: string;
}
const { shape = 'organic', tape, tapeAt = 'tl', class: cls = '' } = Astro.props;
---
<div class:list={['imask', `imask-${shape}`, tape && 'imask-taped', cls]}>
  <slot />
  {tape && <Tape color={tape} class={`imask-tape imask-tape-${tapeAt}`} />}
</div>
