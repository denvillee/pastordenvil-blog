---
interface Props { icon: 'crown' | 'plant' | 'people' | 'sun'; }
const { icon } = Astro.props;
const P: Record<string, string[]> = {
  crown:  ['M8 32 6 14l10 8 8-13 8 13 10-8-2 18z', 'M8 36h32'],
  plant:  ['M24 40V20', 'M24 24c-8 0-12-5-12-11 7-1 12 3 12 11z', 'M24 28c8 0 12-5 12-11-7-1-12 3-12 11z'],
  people: ['M17 21a5 5 0 1 0 0-10 5 5 0 0 0 0 10z', 'M31 21a5 5 0 1 0 0-10 5 5 0 0 0 0 10z',
           'M8 38c0-6 4-10 9-10s9 4 9 10', 'M27 30c1-1 2-2 5-2 5 0 8 4 8 10'],
  sun:    ['M24 32a8 8 0 1 0 0-16 8 8 0 0 0 0 16z', 'M24 5v5M24 38v5M5 24h5M38 24h5',
           'M11 11l3 3M34 34l3 3M37 11l-3 3M14 34l-3 3'],
};
---
<span class="tico" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" focusable="false">
    {P[icon].map((d) => (
      <path d={d} stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    ))}
  </svg>
</span>
