---
interface Props { icon: 'crown' | 'plant' | 'people' | 'sun' | 'compass' | 'heart' | 'flag' | 'book' | 'signpost' | 'calendar'; }
const { icon } = Astro.props;
const P: Record<string, string[]> = {
  crown: ['M8 32 6 14l10 8 8-13 8 13 10-8-2 18z','M8 36h32'],
  plant: ['M24 40V20','M24 24c-8 0-12-5-12-11 7-1 12 3 12 11z','M24 28c8 0 12-5 12-11-7-1-12 11z'],
  people: ['M17 21a5 5 0 1 0 0-10 5 5 0 0 0 0 10z','M31 21a5 5 0 1 0 0-10 5 5 0 0 0 0 10z','M8 38c0-6 4-10 9-10s9 4 9 10','M27 30c1-1 2-2 5-2 5 0 8 4 8 10'],
  sun: ['M24 32a8 8 0 1 0 0-16 8 8 0 0 0 0 16z','M24 5v5M24 38v5M5 24h5M38 24h5','M11 11l3 3M34 34l3 3M37 11l-3 3M14 34l-3 3'],
  compass: ['M24 42a18 18 0 1 0 0-36 18 18 0 0 0 0 36z','M31 17l-5 10-10 5 5-10z','M24 7v4M24 37v4M7 24h4M37 24h4'],
  heart: ['M24 39S8 30 8 19c0-5 3-8 8-8 4 0 7 3 8 6 1-3 4-6 8-6 5 0 8 3 8 8 0 11-16 20-16 20z'],
  flag: ['M13 42V8','M14 10c8-4 13 5 22 0v17c-9 5-14-5-22 0'],
  book: ['M7 13c6-2 12-2 17 2 5-4 11-4 17-2v23c-6-2-12-2-17 2-5-4-11-4-17-2z','M24 15v23'],
  signpost: ['M24 43V8','M11 14h22l5 6-5 6H11z','M16 29h21l-5 6 5 6H16z'],
  calendar: ['M10 13h28v26H10z','M10 20h28','M16 8v8M32 8v8','M17 26h3M25 26h3M33 26h1M17 32h3M25 32h3'],
};
---
<span class="tico" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" focusable="false">
    {P[icon].map((d) => <path d={d} stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />)}
  </svg>
</span>
