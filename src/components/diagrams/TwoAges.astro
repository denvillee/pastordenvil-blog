---
/* Framework 01. Two ages plus König's third band.
   currentColor + tokens, so it inherits light and dark automatically.
   Never export this to a flat .svg file: it would stop adapting. */
---
<svg viewBox="0 0 700 330" role="img"
     aria-label="Three bands. This age runs from creation to the renewal of all things. The age to come begins at the resurrection and never ends. Underneath both, one continuous band marked Christ runs from the incarnation onward, divided into for us, in us, and with us.">
  <defs>
    <marker id="fwArrowBrass" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#ECC46E"></path>
    </marker>
    <marker id="fwArrowCobalt" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="#2B4CF0"></path>
    </marker>
  </defs>

  <text x="435" y="26" text-anchor="middle" font-family="Archivo, sans-serif" font-size="14" font-weight="800" letter-spacing="1.8" fill="var(--cobalt-ink)">NOW AND NOT YET</text>
  <text x="435" y="46" text-anchor="middle" font-family="Archivo, sans-serif" font-size="12" fill="currentColor" opacity="0.65">the overlap you are standing in</text>

  <line x1="300" y1="66" x2="300" y2="284" stroke="currentColor" stroke-width="1" stroke-dasharray="5 5" opacity="0.5"></line>
  <line x1="570" y1="66" x2="570" y2="284" stroke="currentColor" stroke-width="1" stroke-dasharray="5 5" opacity="0.5"></line>

  <rect x="40" y="88" width="530" height="44" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
  <text x="58" y="115" font-family="Archivo, sans-serif" font-size="13" font-weight="700" letter-spacing="1.4" fill="currentColor">THIS AGE</text>
  <circle cx="466" cy="110" r="5" fill="#FF6A2B"></circle>
  <text x="478" y="114" font-family="Archivo, sans-serif" font-size="11" font-weight="600" fill="var(--ember-ink)">your Tuesday</text>

  <rect x="300" y="150" width="340" height="44" fill="#ECC46E"></rect>
  <text x="318" y="177" font-family="Archivo, sans-serif" font-size="13" font-weight="700" letter-spacing="1.4" fill="#12160F">THE AGE TO COME</text>
  <line x1="640" y1="172" x2="678" y2="172" stroke="#ECC46E" stroke-width="4" marker-end="url(#fwArrowBrass)"></line>

  <rect x="230" y="212" width="410" height="44" fill="#2B4CF0"></rect>
  <line x1="300" y1="212" x2="300" y2="256" stroke="#FFFFFF" stroke-width="1" opacity="0.55"></line>
  <line x1="570" y1="212" x2="570" y2="256" stroke="#FFFFFF" stroke-width="1" opacity="0.55"></line>
  <text x="265" y="233" text-anchor="middle" font-family="Archivo, sans-serif" font-size="10.5" font-weight="800" letter-spacing="1.1" fill="#FFFFFF">FOR US</text>
  <text x="265" y="247" text-anchor="middle" font-family="Archivo, sans-serif" font-size="9" fill="#DCE3FF">the cross</text>
  <text x="435" y="233" text-anchor="middle" font-family="Archivo, sans-serif" font-size="10.5" font-weight="800" letter-spacing="1.1" fill="#FFFFFF">IN US</text>
  <text x="435" y="247" text-anchor="middle" font-family="Archivo, sans-serif" font-size="9" fill="#DCE3FF">by the Spirit</text>
  <text x="605" y="233" text-anchor="middle" font-family="Archivo, sans-serif" font-size="10.5" font-weight="800" letter-spacing="1.1" fill="#FFFFFF">WITH US</text>
  <text x="605" y="247" text-anchor="middle" font-family="Archivo, sans-serif" font-size="9" fill="#DCE3FF">his coming</text>
  <line x1="640" y1="234" x2="678" y2="234" stroke="#2B4CF0" stroke-width="4" marker-end="url(#fwArrowCobalt)"></line>
  <text x="222" y="234" text-anchor="end" font-family="Archivo, sans-serif" font-size="11" font-weight="700" fill="var(--cobalt-ink)">CHRIST</text>

  <text x="300" y="302" text-anchor="middle" font-family="Archivo, sans-serif" font-size="12" font-weight="600" fill="currentColor">the resurrection</text>
  <text x="300" y="318" text-anchor="middle" font-family="Archivo, sans-serif" font-size="10.5" fill="currentColor" opacity="0.6">the future arrives early</text>
  <text x="570" y="302" text-anchor="middle" font-family="Archivo, sans-serif" font-size="12" font-weight="600" fill="currentColor">all things made new</text>
  <text x="570" y="318" text-anchor="middle" font-family="Archivo, sans-serif" font-size="10.5" fill="currentColor" opacity="0.6">this age ends</text>
</svg>
