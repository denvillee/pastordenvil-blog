---
/*
  Hero, build packet 6.1. Line one is "Good news" fixed in bone with the
  rotating half in brass — vertical roll, 2.8s per phrase, pauses on hover,
  first phrase static under prefers-reduced-motion. The five phrases are
  final per the packet and live in home.json so the CMS can edit them.
  No pronoun in the headline on purpose.
*/
import home from '../data/home.json';
const line = home.marquee.join(' · ');
const phrases = home.heroPhrases;
---
<header class="hero" id="top">
  <div class="hero-img">
    <picture>
      <source srcset="/assets/img/hero.webp" type="image/webp" />
      <img src="/assets/img/hero.jpg" alt="" width="1600" height="1000" fetchpriority="high" />
    </picture>
  </div>
  <div class="hero-in">
    <h1 class="gn">
      <span class="gn-fixed">{home.heroFixed}</span>
      <span class="gn-roll">
        <span class="gn-track" style={`--n:${phrases.length}`}>
          {phrases.map((p) => <span class="gn-item">{p}</span>)}
          <span class="gn-item" aria-hidden="true">{phrases[0]}</span>
        </span>
      </span>
    </h1>
    <div class="hero-copy">
      <p class="lead" set:html={home.heroLead}></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={home.heroPrimaryHref}>{home.heroPrimaryLabel}</a>
        <a class="btn btn-ghost" href={home.heroSecondaryHref}>{home.heroSecondaryLabel}</a>
      </div>
    </div>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>{line} &middot;&nbsp;</span>
      <span>{line} &middot;&nbsp;</span>
    </div>
  </div>
</header>
