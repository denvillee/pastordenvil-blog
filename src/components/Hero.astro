---
import home from '../data/home.json';
const line = home.marquee.join(' · ');
---
<header class="hero" id="top">
  <div class="hero-img">
    <picture>
      <source srcset="/assets/img/hero.webp" type="image/webp" />
      <img src="/assets/img/hero.jpg" alt="" width="1600" height="1000" fetchpriority="high" />
    </picture>
  </div>
  <div class="hero-in">
    <h1 class="kinetic">
      <span class="k1">{home.heroK1}</span>
      <span class="k2">{home.heroK2}</span>
    </h1>
    <div class="hero-copy">
      <p class="lead" set:html={home.heroLead}></p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={home.heroPrimaryHref}>{home.heroPrimaryLabel}</a>
        <a class="btn btn-ghost" href={home.heroSecondaryHref}>{home.heroSecondaryLabel}</a>
      </div>
    </div>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>{line} &middot;&nbsp;</span>
      <span>{line} &middot;&nbsp;</span>
    </div>
  </div>
</header>
