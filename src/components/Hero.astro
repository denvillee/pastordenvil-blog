---
/*
  Hero, per the 26 Aug CHANGE SPEC (supersedes build packet 6.1/6.2).
  Three elements only: rotating line, gospel line, lead paragraph. Buttons.

  Accessibility, per the spec: the h1 contains stable text — the fixed words
  plus the full phrase set in a visually hidden span. The animated rotator is
  decoration (aria-hidden, no aria-live). Reduced motion shows phrase one,
  static, with no interval running.

  Everything editable lives in src/data/home.json; nothing is hard-coded here.
*/
import home from '../data/home.json';

const rotations: string[] = home.heroRotations;
const srAll = rotations.map((r) => r.replace(/\.$/, '')).join(', ') + '.';
const gospelParts = home.heroGospelLine.split('|');
---
<header class="hero" id="top">
  <div class="hero-img">
    <picture>
      <source srcset="/assets/img/hero.webp" type="image/webp" />
      <img src="/assets/img/hero.jpg" alt="" width="1600" height="1000" fetchpriority="high" />
    </picture>
  </div>
  <div class="hero-in">
    <h1 class="gn">
      <span class="gn-fixed">{home.heroFixed}</span>
      <span class="sr-only">{srAll}</span>
      <span class="gn-rotator" id="gn-rotator" aria-hidden="true" tabindex="0">
        {rotations.map((r, i) => (
          <span class={`gn-item${i === 0 ? ' is-on' : ''}`}>{r}</span>
        ))}
      </span>
    </h1>
    <p class="gospel">
      {gospelParts.map((part) => <span class="gospel-l" set:html={part}></span>)}
    </p>
    <div class="hero-copy">
      <div class="hero-actions">
        <a class="btn btn-primary" href={home.heroPrimaryHref}>{home.heroPrimaryLabel}</a>
        <a class="btn btn-ghost" href={home.heroSecondaryHref}>{home.heroSecondaryLabel}</a>
      </div>
    </div>
  </div>
</header>

<script>
  /* Rotator, per spec: 2600ms interval, array order, looping. Pause on hover
     AND focus. prefers-reduced-motion: show item one, no interval at all. */
  (function () {
    const box = document.getElementById('gn-rotator');
    if (!box) return;
    const items = Array.from(box.querySelectorAll('.gn-item')) as HTMLElement[];
    if (items.length < 2) return;

    /* No layout shift, ever: min-width comes from the widest phrase. */
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap';
    box.appendChild(probe);
    let w = 0;
    for (const it of items) { probe.textContent = it.textContent; w = Math.max(w, probe.offsetWidth); }
    probe.remove();
    box.style.minWidth = Math.ceil(w) + 'px';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let i = 0;
    let paused = false;
    const step = () => {
      if (paused) return;
      const prev = items[i];
      i = (i + 1) % items.length;
      const next = items[i];
      prev.classList.remove('is-on'); prev.classList.add('is-out');
      next.classList.add('is-on');
      window.setTimeout(() => prev.classList.remove('is-out'), 520);
    };
    const timer = window.setInterval(step, 2600);
    const pause = () => { paused = true; };
    const resume = () => { paused = false; };
    box.addEventListener('mouseenter', pause);
    box.addEventListener('mouseleave', resume);
    box.addEventListener('focus', pause);
    box.addEventListener('blur', resume);
    window.addEventListener('pagehide', () => window.clearInterval(timer));
  })();
</script>
