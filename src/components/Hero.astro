---
/*
  Round 9 hero. Two lines of type on a ruled pine field, and nothing else.

  The buttons and the claim line are both gone. The buttons pointed at things
  now visible on the same scroll, so they were a second route to content the
  page already shows; Subscribe moved into the masthead. The claim line went
  because good news is what gospel means, and a page that announces it and then
  explains it is arguing with itself.

  The corner sticker is cut too (addendum 3). With the header reduced to two
  lines of type on a quiet ground it had nothing to sit against, and it was the
  last thing on the page still speaking a badge language. What it announced is
  said in words by the Latest eyebrow a few hundred pixels below.

  The rotator now cycles the whole second line, "For the weary." rather than
  "the weary.", so each phrase is a complete thought under GOOD NEWS.

  Accessibility is unchanged in shape: the h1 holds stable text plus the full
  phrase set in a visually hidden span, the animated rotator is decoration, and
  reduced motion shows phrase one with no interval running.
*/
import home from '../data/home.json';

const rotations: string[] = home.heroRotations;
const srAll = rotations.map((r) => r.replace(/\.$/, '')).join(', ') + '.';
---
<header class="hero" id="top">
  <div class="hero-field" aria-hidden="true"></div>
  <div class="hero-in">
    <h1 class="gn">
      <span class="gn-fixed">{home.heroFixed}</span>
      <span class="sr-only">{srAll}</span>
      <span class="gn-rotator" id="gn-rotator" aria-hidden="true" tabindex="0">
        {rotations.map((r, i) => (
          <span class={`gn-item${i === 0 ? ' is-on' : ''}`}>{r}</span>
        ))}
      </span>
    </h1>
    <hr class="gn-rule" />
  </div>
</header>

<script>
  /* 2.4s per phrase, array order, looping. Pause on hover and focus.
     prefers-reduced-motion: show item one and never start the interval. */
  (function () {
    const box = document.getElementById('gn-rotator');
    if (!box) return;
    const items = Array.from(box.querySelectorAll('.gn-item')) as HTMLElement[];
    if (items.length < 2) return;

    /* No layout shift, ever: the line is as wide as its widest phrase. */
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap';
    box.appendChild(probe);
    let w = 0;
    for (const it of items) { probe.textContent = it.textContent; w = Math.max(w, probe.offsetWidth); }
    probe.remove();
    box.style.minWidth = Math.ceil(w) + 'px';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let i = 0;
    let paused = false;
    const step = () => {
      if (paused) return;
      const prev = items[i];
      i = (i + 1) % items.length;
      const next = items[i];
      prev.classList.remove('is-on'); prev.classList.add('is-out');
      next.classList.add('is-on');
      window.setTimeout(() => prev.classList.remove('is-out'), 520);
    };
    const timer = window.setInterval(step, 2400);
    const pause = () => { paused = true; };
    const resume = () => { paused = false; };
    box.addEventListener('mouseenter', pause);
    box.addEventListener('mouseleave', resume);
    box.addEventListener('focus', pause);
    box.addEventListener('blur', resume);
    window.addEventListener('pagehide', () => window.clearInterval(timer));
  })();
</script>
