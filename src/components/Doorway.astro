---
/*
  The doorway: a section's own introduction, in Denvil's voice, at the top of
  its landing page.

  Not an article and not a panel. It is the paragraph a person reads before
  they decide whether this section is for them, so it gets the reading measure,
  the lead sentence at display size, and no card, border or box around it. The
  words come from a real, editable, linkable entry rather than being typed into
  a template, so changing them is a CMS edit and not a deploy.

  Two sources feed it, because the sections are not all the same shape. Essays,
  Moments and For Leaders are collections, so their doorway is the pageIntro
  post that already pins to the top of the list. Bookshelf and Studies are not
  collections, so theirs is a document in `landing`. Either way this component
  takes a rendered body and a lead line and lays them out identically.
*/
interface Props { tone?: 'blue' | 'yellow' | 'coral' | 'green'; href?: string }
const { tone = 'yellow', href } = Astro.props;
import Mark from './marks/Mark.astro';
---
<section class="shell door">
  <div class="door-in">
    <div class="door-body">
      <slot />
    </div>
    {href && (
      <p class="door-perma">
        <a class="go" href={href}>Read this on its own page <span class="arw" aria-hidden="true">&rarr;</span></a>
      </p>
    )}
  </div>
  <span class="door-rule" aria-hidden="true"><Mark kind="underline" color={tone} /></span>
</section>
