---
/*
  The four coloured discs on the home page. Drawn here rather than pulled from
  an icon set: a generic icon library would give four neat pictograms in a
  house style that is not this one, and these want to look sketched.
*/
interface Props { kind: 'essays' | 'leaders' | 'moments' | 'studies' | 'reading'; }
const { kind } = Astro.props;

const P: Record<string, { tone: string; d: string[] }> = {
  /* a pencil, for the writing */
  essays: { tone: 'blue', d: [
    'M14 34 30 18l6 6L20 40l-8 2z', 'M30 18l4-4a3 3 0 0 1 4 0l2 2a3 3 0 0 1 0 4l-4 4',
    'M13 41l3-1',
  ]},
  /* a mug */
  moments: { tone: 'yellow', d: [
    'M13 17h20v14a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8z',
    'M33 21h3a5 5 0 0 1 0 10h-3', 'M17 11c1 2-1 3 0 5', 'M24 10c1 2-1 3 0 5',
  ]},
  /* an open book */
  studies: { tone: 'coral', d: [
    'M6 14c6-2 12-2 18 2 6-4 12-4 18-2v20c-6-2-12-2-18 2-6-4-12-4-18-2z',
    'M24 16v20',
  ]},
  /* three spines */
  reading: { tone: 'green', d: [
    'M11 12h6v26h-6z', 'M19 12h6v26h-6z', 'M28 13l6 1-4 25-6-1z',
  ]},
  /* two people, one a step ahead and turning back */
  leaders: { tone: 'coral', d: [
    'M18 20a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9z',
    'M9 39v-4a9 9 0 0 1 9-9h0a9 9 0 0 1 9 9v4',
    'M33 18a3.6 3.6 0 1 0 0-7.2 3.6 3.6 0 0 0 0 7.2z',
    'M31 25a7.5 7.5 0 0 1 8 7.4V37',
  ]},
};
const p = P[kind];
---
<span class:list={['cico', `cico-${p.tone}`]} aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" focusable="false">
    {p.d.map((d) => (
      <path d={d} stroke="currentColor" stroke-width="2.4"
            stroke-linecap="round" stroke-linejoin="round" />
    ))}
  </svg>
</span>
