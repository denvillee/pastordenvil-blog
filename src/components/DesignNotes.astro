---
import labels from '../data/labels.json';
const notes = [
  { h: labels.designNote1Heading, p: labels.designNote1Body },
  { h: labels.designNote2Heading, p: labels.designNote2Body },
  { h: labels.designNote3Heading, p: labels.designNote3Body },
  { h: labels.designNote4Heading, p: labels.designNote4Body },
];
---
<section class="band shell notes">
  <div class="sec-head reveal">
    <h2>{labels.designNotesHeading}</h2>
    <span class="label">{labels.designNotesLabel}</span>
  </div>
  <div class="notes-grid">
    {notes.map((n) => (
      <div class="note reveal"><h3 set:html={n.h}></h3><p set:html={n.p}></p></div>
    ))}
  </div>
</section>
