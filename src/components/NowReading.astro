---
/*
  THE SHELF. One book at full size, then three beneath it.

  The one-sentence synopsis is the most important element in this section and
  has been since the first review: the shelf is only interesting if it says why
  a book is on it. So the synopsis runs on the big book and on all three of the
  small ones, and nothing here is a bare list of titles.

  Covers are real art at a fixed 2:3 frame with a hard offset shadow, which is
  what makes them read as physical books rather than as thumbnails. A book with
  no cover keeps its drawn spine at the same frame, so the row never moves.
*/
import Eyebrow from './Eyebrow.astro';
import labels from '../data/labels.json';

interface Book {
  title: string; author: string; year?: number; progress?: string;
  spine: string; note: string; link: string; cover?: string;
}
interface Props { book?: Book; shelf?: Book[] }
const { book, shelf = [] } = Astro.props;

function progressPct(s?: string): number | null {
  if (!s) return null;
  const pct = s.match(/(\d{1,3}(?:\.\d+)?)\s*%/);
  if (pct) { const v = Number(pct[1]); return v >= 0 && v <= 100 ? v : null; }
  const frac = s.match(/(\d+)\s*(?:of|\/)\s*(\d+)/i);
  if (frac) { const a = Number(frac[1]), b = Number(frac[2]); return b > 0 && a <= b ? (a / b) * 100 : null; }
  return null;
}
const pct = progressPct(book?.progress);
const three = shelf.slice(0, 3);
---
{book && (
  <section class="band shell shelf" id="reading">
    <Eyebrow tone="clay" text={labels.shelfEyebrow} />
    <h2 class="shelf-h">{labels.shelfHeading}</h2>

    <div class="nr">
      <div class="nr-cover">
        {book.cover
          ? <img src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" decoding="async" />
          : <span class={`spine sp-${book.spine}`}><span>{book.title}</span></span>}
      </div>
      <div class="nr-body">
        <p class="nr-by">{book.author}{book.year ? ` · ${book.year}` : ''}</p>
        <h3 class="nr-t">{book.link ? <a href={book.link} rel="noopener">{book.title}</a> : book.title}</h3>
        <p class="nr-note" set:html={book.note}></p>
        {book.progress && (
          <p class="nr-prog">
            {pct !== null && <span class="nr-track"><i style={`width:${pct.toFixed(1)}%`}></i></span>}
            <span class="nr-plabel">{book.progress}</span>
          </p>
        )}
      </div>
    </div>

    {three.length > 0 && (
      <>
        <hr class="shelf-rule" />
        <p class="shelf-also">{labels.shelfAlso}</p>
        <div class="shelf-3">
          {three.map((b) => (
            <a class="sb" href={b.link || '/bookshelf/'} rel={b.link ? 'noopener' : undefined}>
              <span class="sb-cover">
                {b.cover
                  ? <img src={b.cover} alt={`Cover of ${b.title}`} loading="lazy" decoding="async" />
                  : <span class={`spine sp-${b.spine}`}><span>{b.title}</span></span>}
              </span>
              <span class="sb-body">
                <span class="sb-t">{b.title}</span>
                <span class="sb-by">{b.author}</span>
                <span class="sb-note" set:html={b.note}></span>
              </span>
            </a>
          ))}
        </div>
      </>
    )}

    <a class="shelf-more" href="/bookshelf/">{labels.shelfMore} <span aria-hidden="true">&rarr;</span></a>
  </section>
)}
