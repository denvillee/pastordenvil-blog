---
import site from '../data/site.json';
import Mark from './marks/Mark.astro';
import StickyNote from './marks/StickyNote.astro';

// Kit, per the hosting runbook. A real form post, not Kit's embed script:
// the embed pulls its own CSS and rewrites the markup, which breaks this band.
// If Kit needs different field names, change them here, not at runtime.
const formId = import.meta.env.PUBLIC_KIT_FORM_ID;
const action = formId
  ? 'https://app.kit.com/forms/' + formId + '/subscriptions'
  : '/subscribe/thanks/';

interface Props { source?: string; tone?: 'dark' | 'yellow' | 'card'; note?: string }
const { source = Astro.url.pathname, tone = 'dark', note } = Astro.props;
---
<section class:list={['signup', `signup-${tone}`]} id="signup">
  <div class="shell signup-in">
    <div class="signup-copy">
      {/* The words here are Denvil's own choice and are held. Round 9 §3.6
          proposed a new heading and body; it breaks no standing rule, but this
          is the one block whose copy he wrote himself after killing the Monday
          idea, so it is his to change and not mine. The design around it is
          built to the packet. */}
      <p class="signup-eyebrow">{site.signupHeading}</p>
      <h2 class="signup-h"><span class="u">{site.signupCopy}<Mark kind="underline" color={tone === 'yellow' ? 'blue' : 'yellow'} /></span></h2>
      <p class="signup-print">{site.signupSmallPrint}</p>
    </div>
    <div class="signup-form">
      <form class="form" method="post" action={action}>
        <label class="sr-only" for="email">Email address</label>
        <input class="fake" id="email" name="email_address" type="email" required
               placeholder="you@example.com" autocomplete="email" />
        <input type="hidden" name="fields[source]" value={source} />
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"
               style="position:absolute;left:-9999px" />
        <button class:list={['btn', tone === 'yellow' ? 'btn-blue' : 'btn-yellow']} type="submit">{site.signupButton}</button>
      </form>
      {note && <StickyNote tone="paper" tilt={2} tape={false} class="signup-note">{note}</StickyNote>}
    </div>
  </div>
</section>
